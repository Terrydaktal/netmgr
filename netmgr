#!/bin/bash

# netmgr - Network management tool
# Mimics diskpart style interactive shell and subcommands

NETMGR_VERSION="0.0.13-hotspot"
MAC_IP_DB="${NETMGR_MAC_IP_DB:-$HOME/.local/share/netmgr/mac_ip_map.tsv}"
declare -A VENDOR_CACHE=() VENDOR_PREFIXES=() MAC_IP_HINTS=()
VENDOR_DB_LOADED=""
MAC_IP_HINTS_LOADED=0
MAC_IP_HINTS_REFRESHED=0

# Helper to convert IP range (8.8.8.0 - 8.8.8.255) to CIDR suffix (/24)
range_to_suffix() {
    local range="$1" start_ip="" end_ip="" start_int=0 end_int=0 differing=0 bits=0
    if [[ "$range" != *" - "* ]]; then
        if [[ "$range" == *"/"* ]]; then echo "/${range#*/}"; else echo ""; fi
        return
    fi

    start_ip="${range%% - *}"
    end_ip="${range##* - }"
    ipv4_to_int "$start_ip" start_int && ipv4_to_int "$end_ip" end_int || return 1
    ((start_int <= end_int)) || return 1
    differing=$((start_int ^ end_int))
    while ((differing > 0)); do
        bits=$((bits + 1))
        differing=$((differing >> 1))
    done

    echo "/$((32 - bits))"
}

# Helper to find correct local CIDR for an IP (using routing table)
get_local_cidr() {
    local ip="$1" cidr="" best_prefix=-1 prefix=0
    while IFS= read -r cidr; do
        if ipv4_in_cidr "$ip" "$cidr"; then
            prefix="${cidr#*/}"
            ((10#$prefix > best_prefix)) && best_prefix=$((10#$prefix))
        fi
    done < <(ip -o -4 address show 2> /dev/null | awk '{print $4}')
    if ((best_prefix >= 0)); then printf '/%s\n' "$best_prefix"; else printf '\n'; fi
}

normalize_mac() {
    local normalized="${1,,}"
    normalized="${normalized//-/:}"
    [[ "$normalized" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || return 1
    printf '%s\n' "$normalized"
}

is_device_mac() {
    [[ "$1" =~ ^([0-9a-f]{2}:){5}[0-9a-f]{2}$ ]] || return 1
    [[ "$1" != 00:00:00:00:00:00 ]] && (((16#${1:0:2} & 1) == 0))
}

ipv4_to_int() {
    local octet result=0
    local -a octets
    [[ "$1" =~ ^[0-9]{1,3}(\.[0-9]{1,3}){3}$ ]] || return 1
    IFS=. read -r -a octets <<< "$1"
    for octet in "${octets[@]}"; do
        ((10#$octet <= 255)) || return 1
        result=$(((result << 8) | 10#$octet))
    done
    printf -v "$2" '%s' "$result"
}

ipv4_in_cidr() {
    local candidate=0 network=0 prefix="${2#*/}" mask=0
    [[ "$prefix" =~ ^[0-9]{1,2}$ ]] && ((10#$prefix <= 32)) || return 1
    ipv4_to_int "$1" candidate && ipv4_to_int "${2%/*}" network || return 1
    mask=$(((0xffffffff << (32 - 10#$prefix)) & 0xffffffff))
    (((candidate & mask) == (network & mask)))
}

map_protocol_token() {
    local token="$1"
    case "$token" in
        frame | data | geninfo | ethertype) echo "" ;;
        radiotap | wlan_radio) echo "Radiotap" ;;
        wlan) echo "802.11" ;;
        llc) echo "LLC" ;;
        eth) echo "Ethernet" ;;
        ip) echo "IP" ;;
        ipv6) echo "IPv6" ;;
        arp) echo "ARP" ;;
        tcp) echo "TCP" ;;
        udp) echo "UDP" ;;
        icmp) echo "ICMP" ;;
        icmpv6) echo "ICMPv6" ;;
        bootp | dhcp) echo "DHCP" ;;
        dns) echo "DNS" ;;
        mdns) echo "mDNS" ;;
        ssdp) echo "SSDP" ;;
        tls | ssl) echo "TLS" ;;
        quic) echo "QUIC" ;;
        http | http2 | http3) echo "HTTP" ;;
        eapol) echo "EAPOL" ;;
        *)
            echo "$token" | tr '[:lower:]' '[:upper:]'
            ;;
    esac
}

map_ethertype_detail() {
    local eth_type="$1"
    case "$eth_type" in
        0x0800) echo "IP" ;;
        0x86dd) echo "IPv6" ;;
        0x0806) echo "ARP" ;;
        0x888e) echo "EAPOL" ;;
        0x88cc) echo "LLDP" ;;
        0x8809) echo "LACP" ;;
        0x8863) echo "PPPoE-Discovery" ;;
        0x8864) echo "PPPoE-Session" ;;
        "") echo "" ;;
        *)
            echo "$eth_type"
            ;;
    esac
}

format_protocol_stack() {
    local proto_chain="$1"
    local tcp_s="$2"
    local tcp_d="$3"
    local udp_s="$4"
    local udp_d="$5"
    local eth_type="$6"
    local app_proto="$7"
    local stack=""
    local last=""
    local token=""
    local label=""
    local eth_detail=""
    local -a proto_parts

    IFS=':' read -r -a proto_parts <<< "$proto_chain"
    for token in "${proto_parts[@]}"; do
        label=$(map_protocol_token "$token")
        [ -z "$label" ] && continue
        if [ "$label" = "TCP" ] && { [ -n "$tcp_s" ] || [ -n "$tcp_d" ]; }; then
            label="TCP(${tcp_s:-?}->${tcp_d:-?})"
        elif [ "$label" = "UDP" ] && { [ -n "$udp_s" ] || [ -n "$udp_d" ]; }; then
            label="UDP(${udp_s:-?}->${udp_d:-?})"
        fi
        if [ "$label" = "$last" ]; then
            continue
        fi
        if [ -z "$stack" ]; then
            stack="$label"
        else
            stack="${stack}<-${label}"
        fi
        last="$label"
    done

    if [ -n "$app_proto" ]; then
        case "$app_proto" in
            '' | [0-9]*)
                ;;
            "TCP" | "UDP" | "IPv4" | "IPv6" | "Ethernet" | "ARP" | "802.11")
                ;;
            *)
                if [ "$stack" = "Ethernet" ]; then
                    eth_detail="$app_proto"
                elif [ "$app_proto" != "$last" ]; then
                    if [ -z "$stack" ]; then
                        stack="$app_proto"
                    else
                        stack="${stack}<-${app_proto}"
                    fi
                fi
                ;;
        esac
    fi

    if [ "$stack" = "Ethernet" ] && [ -z "$eth_detail" ]; then
        eth_detail=$(map_ethertype_detail "$eth_type")
    fi
    if [ "$stack" = "Ethernet" ] && [ -n "$eth_detail" ]; then
        stack="Ethernet[$eth_detail]"
    fi

    if [ -z "$stack" ]; then
        stack="UNKNOWN"
    fi
    echo "$stack"
}

lookup_vendor() {
    local vendor_mac=""
    local vendor_result="Unknown"
    local vendor_prefix=""
    local prefix_name=""
    local mac_db="${NETMGR_MAC_PREFIX_DB:-/usr/share/nmap/nmap-mac-prefixes}"

    vendor_mac=$(normalize_mac "$1") || vendor_mac=""
    if is_device_mac "$vendor_mac"; then
        if [[ -n "${VENDOR_CACHE[$vendor_mac]+x}" ]]; then
            vendor_result="${VENDOR_CACHE[$vendor_mac]}"
        elif (((16#${vendor_mac:0:2} & 2) != 0)); then
            vendor_result="Private/randomized MAC"
        else
            if [[ "$VENDOR_DB_LOADED" != "$mac_db" ]]; then
                VENDOR_PREFIXES=()
                if [[ -r "$mac_db" ]]; then
                    while read -r vendor_prefix prefix_name; do
                        [[ "$vendor_prefix" =~ ^[[:xdigit:]]{6}$ ]] || continue
                        VENDOR_PREFIXES["${vendor_prefix^^}"]="$prefix_name"
                    done < "$mac_db"
                fi
                VENDOR_DB_LOADED="$mac_db"
            fi
            vendor_prefix="${vendor_mac//:/}"
            vendor_prefix="${vendor_prefix:0:6}"
            vendor_result="${VENDOR_PREFIXES[${vendor_prefix^^}]:-Unknown}"
            if [[ "$vendor_result" == Unknown && "${NETMGR_VENDOR_ONLINE:-0}" == 1 ]]; then
                vendor_result=$(curl -fsS --connect-timeout 1 --max-time 2 "https://api.macvendors.com/$vendor_mac" 2> /dev/null | tr -d '\r\n') || vendor_result="Unknown"
                [[ -n "$vendor_result" && "$vendor_result" != *'{'* ]] || vendor_result="Unknown"
            fi
        fi
        VENDOR_CACHE["$vendor_mac"]="$vendor_result"
    fi
    if [[ -n "${2:-}" ]]; then
        printf -v "$2" '%s' "$vendor_result"
    else
        printf '%s\n' "$vendor_result"
    fi
}

lookup_ip_from_db() {
    local hint_mac=""
    local hint_ip=""
    local hint_seen=""
    local hint_now=0
    local hint_ttl="${NETMGR_MAC_IP_TTL:-86400}"
    local hint_result=""
    local -A latest=()
    [[ "$hint_ttl" =~ ^[0-9]+$ && ${#hint_ttl} -le 8 ]] || hint_ttl=86400
    hint_ttl=$((10#$hint_ttl))
    hint_now=$EPOCHSECONDS
    if [[ "$MAC_IP_HINTS_LOADED" -eq 0 ]] || ((hint_now - MAC_IP_HINTS_REFRESHED >= 30)); then
        MAC_IP_HINTS=()
        if [[ -r "$MAC_IP_DB" ]]; then
            while IFS=$'\t' read -r hint_mac hint_ip hint_seen; do
                is_device_mac "$hint_mac" || continue
                [[ "$hint_seen" =~ ^[0-9]{1,11}$ ]] || continue
                [[ "$hint_ip" =~ ^[0-9a-fA-F:.]+$ ]] || continue
                hint_seen=$((10#$hint_seen))
                ((hint_seen <= hint_now && hint_now - hint_seen <= hint_ttl)) || continue
                if ((hint_seen >= ${latest[$hint_mac]:-0})); then
                    latest["$hint_mac"]="$hint_seen"
                    MAC_IP_HINTS["$hint_mac"]="$hint_ip (cached)"
                fi
            done < "$MAC_IP_DB"
        fi
        MAC_IP_HINTS_LOADED=1
        MAC_IP_HINTS_REFRESHED=$hint_now
    fi
    hint_mac=$(normalize_mac "$1") || hint_mac=""
    [[ -z "$hint_mac" ]] || hint_result="${MAC_IP_HINTS[$hint_mac]:-}"
    if [[ -n "${2:-}" ]]; then
        printf -v "$2" '%s' "$hint_result"
    else
        printf '%s\n' "$hint_result"
    fi
}

log_ok() {
    printf "\033[1;32m[OK]\033[0m %s\n" "$*"
}

log_err() {
    printf "\033[1;31m[ERR]\033[0m %s\n" "$*"
}

ensure_sudo_session() {
    if [ "$EUID" -eq 0 ]; then
        return 0
    fi
    if sudo -v; then
        return 0
    fi
    echo "Error: sudo authentication failed."
    return 1
}

connect_wifi_bssid() {
    local interface="$1" bssid="$2" password="${3:-}"
    local -a privilege=() arguments=(--wait 20 device wifi connect "$bssid" ifname "$interface")
    ensure_sudo_session || return 1
    [[ "$EUID" -eq 0 ]] || privilege=(sudo)
    [[ -z "$password" ]] || arguments+=(password "$password")
    "${privilege[@]}" nmcli "${arguments[@]}"
}

show_interfaces() {
    local iw_cmd=""
    local ethtool_cmd=""
    local -a ethernet_ifaces=()
    local ifname=""

    if command -v iw > /dev/null 2>&1; then
        iw_cmd=$(command -v iw)
    elif [ -x /usr/sbin/iw ]; then
        iw_cmd="/usr/sbin/iw"
    elif [ -x /sbin/iw ]; then
        iw_cmd="/sbin/iw"
    elif [ -x /usr/bin/iw ]; then
        iw_cmd="/usr/bin/iw"
    elif [ -x /bin/iw ]; then
        iw_cmd="/bin/iw"
    fi
    if command -v ethtool > /dev/null 2>&1; then
        ethtool_cmd=$(command -v ethtool)
    fi
    mapfile -t ethernet_ifaces < <(ip -j link show | jq -r '.[].ifname' | grep -E '^(en|eth)' || true)
    if [ "$EUID" -ne 0 ] && { [ -n "$iw_cmd" ] || [ -n "$ethtool_cmd" ]; }; then
        ensure_sudo_session || return 1
    fi

    echo ""
    echo "Local Network Interfaces:"
    echo "----------------------------------------------------------------------------------------------------------------"

    (
        declare -A gateway_map
        while read -r dev gw; do
            if [ -n "$dev" ] && [ -z "${gateway_map[$dev]}" ]; then
                gateway_map["$dev"]="$gw"
            fi
        done < <(
            ip route show default | awk '
                {
                    dev = ""
                    gw = ""
                    for (i = 1; i <= NF; i++) {
                        if ($i == "dev" && (i + 1) <= NF) dev = $(i + 1)
                        if ($i == "via" && (i + 1) <= NF) gw = $(i + 1)
                    }
                    if (dev != "") {
                        if (gw == "") gw = "link"
                        printf "%s %s\n", dev, gw
                    }
                }
            '
        )

        printf "Interface Status IP_Address MAC_Address MTU DHCP Gateway\n"
        ip -j addr show | jq -r '.[] | 
            "\(.ifname) \(.operstate) \((.addr_info[]? | select(.family == "inet") | "\(.local)/\(.prefixlen)") // "N/A") \(.address) \(.mtu) \((.addr_info[]? | select(.family == "inet") | .dynamic) // false)"' |
            while read -r name state ip mac mtu dynamic; do
                is_dynamic="No"
                gateway="${gateway_map[$name]:-N/A}"
                if [ "$dynamic" == "true" ]; then is_dynamic="Yes"; fi
                if [ "$ip" == "N/A" ]; then is_dynamic="N/A"; fi
                printf "%s %s %s %s %s %s %s\n" "$name" "$state" "$ip" "$mac" "$mtu" "$is_dynamic" "$gateway"
            done
    ) | column -t
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "sudo iw dev"
    echo "----------------------------------------------------------------------------------------------------------------"
    if [ -n "$iw_cmd" ]; then
        if [ "$EUID" -eq 0 ]; then
            "$iw_cmd" dev
        else
            sudo "$iw_cmd" dev
        fi
    else
        echo "iw: command not found"
    fi
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "lspci -knn | grep -iA2 net"
    echo "----------------------------------------------------------------------------------------------------------------"
    if command -v lspci > /dev/null 2>&1; then
        lspci -knn | grep -iA2 net || echo "No PCI network controllers matched."
    else
        echo "lspci: command not found"
    fi
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "ip route show"
    echo "----------------------------------------------------------------------------------------------------------------"
    ip route show
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "sudo ethtool <ethernet interfaces>"
    echo "----------------------------------------------------------------------------------------------------------------"
    if [ -n "$ethtool_cmd" ]; then
        if [ "${#ethernet_ifaces[@]}" -eq 0 ]; then
            echo "No ethernet interfaces detected."
        else
            for ifname in "${ethernet_ifaces[@]}"; do
                echo "-- $ifname --"
                if [ "$EUID" -eq 0 ]; then
                    "$ethtool_cmd" "$ifname"
                else
                    sudo "$ethtool_cmd" "$ifname"
                fi
            done
        fi
    else
        echo "ethtool: command not found"
    fi
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "ip -s addr"
    echo "----------------------------------------------------------------------------------------------------------------"
    ip -s addr
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
}

scan_subnet() {
    local script_path=""
    if ! command -v python3 > /dev/null 2>&1; then
        echo "Error: python3 is required for device discovery." >&2
        return 1
    fi
    script_path=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    python3 "${script_path%/*}/lib/discovery.py" "$@"
}

format_port_table() {
    local header=""
    local color_enabled=0
    local terminal_columns=268
    local terminal_size=""

    if [[ "${COLUMNS:-}" =~ ^[1-9][0-9]*$ ]]; then
        terminal_columns=$COLUMNS
    elif [ -t 1 ]; then
        terminal_size=$(stty size 2> /dev/null) || true
        if [[ "$terminal_size" =~ ^[0-9]+[[:space:]]+([1-9][0-9]*)$ ]]; then
            terminal_columns=${BASH_REMATCH[1]}
        fi
    fi
    if [ "$terminal_columns" -gt 268 ]; then
        terminal_columns=268
    fi

    if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
        color_enabled=1
    fi

    awk -v color_enabled="$color_enabled" -v full_details="${4:-0}" -v verbose="${5:-0}" -v machine="${6:-0}" -v terminal_columns="$terminal_columns" '
        BEGIN {
            columns = split("State\tNetid\tOrigin\tLocal Address:Port\tPeer Address:Port\tDownloaded\tUploaded\tRecv-Q\tSend-Q\tPID\tExecutable", labels, "\t")
            gap = full_details ? "  " : " "
            clip_columns = !full_details && !verbose && !machine
            if (machine) color_enabled = 0
            if (!full_details) {
                labels[2] = "Net"
                labels[4] = "Local"
                labels[5] = "Peer"
                labels[8] = "Recv"
                labels[9] = "Send"
                labels[11] = "App"
            }
            max_width["App"] = 112; min_width["App"] = 16
            max_width["CWD"] = 64; min_width["CWD"] = 12
            max_width["Command"] = 48; min_width["Command"] = 16
            for (col = 1; col <= columns; col++) widths[col] = length(labels[col])
            executable_col = 11
            origin_order["-"] = 0
            origin_order["OUTBOUND*"] = 1
            origin_order["SAME-HOST*"] = 2
            origin_order["INBOUND*"] = 3
            origin_order["UNKNOWN"] = 4
        }
        function byte_text(value,    scaled, unit, units) {
            if (value !~ /^[0-9]+$/) return value
            if (value + 0 < 1024) return value "B"
            split("B KiB MiB GiB TiB PiB EiB", units, " ")
            scaled = value + 0
            unit = 1
            while (scaled >= 1024 && unit < 7) { scaled /= 1024; unit++ }
            if (scaled >= 1023.95 && unit < 7) { scaled /= 1024; unit++ }
            return sprintf("%.1f%s", scaled, units[unit])
        }
        function cell_text(row, col) {
            return !machine && !full_details && (col == 6 || col == 7) ? byte_text(cells[row, col]) : cells[row, col]
        }
        function valid_counter(value) {
            return value ~ /^[0-9]+$/ && (length(value) < 20 ||
                (length(value) == 20 && "x" value <= "x18446744073709551615"))
        }
        function traffic_totals(row, text,    fields, n, i, field, counters, seen, supported) {
            cells[row, 6] = cells[row, 7] = "-"
            if (protocols[row] != "tcp" || states[row] ~ /^(LISTEN|TIME-WAIT)$/) return
            # Process names are quoted and may contain strings resembling TCP counters.
            gsub(/"([^"\\]|\\.)*"/, "", text)
            n = split(text, fields, /[[:space:]]+/)
            for (i = 7; i <= n; i++) {
                split(fields[i], field, ":")
                if (field[1] !~ /^bytes_(received|acked)$/) continue
                if (++seen[field[1]] == 1 && fields[i] == field[1] ":" field[2] && valid_counter(field[2])) {
                    counters[field[1]] = field[2]
                    supported = 1
                } else counters[field[1]] = "-"
            }
            # ss suppresses zeros. A reported member proves this paired set is supported;
            # without either counter, retain unknown rather than inventing zero traffic.
            if (supported) {
                cells[row, 6] = "bytes_received" in counters ? counters["bytes_received"] : "0"
                cells[row, 7] = "bytes_acked" in counters ? counters["bytes_acked"] : "0"
            }
        }
        function render_row(row,    col, position, value, line) {
            line = ""
            for (position = 1; position <= visible_count; position++) {
                col = visible_columns[position]
                value = row == 0 ? labels[col] : cell_text(row, col)
                if (machine) {
                    gsub(/[\t\r\n\033]/, " ", value)
                    line = line (col == 1 ? "" : "\t") value
                    continue
                }
                if (clip_columns && labels[col] in max_width && length(value) > widths[col]) {
                    value = labels[col] == "CWD" ? "..." substr(value, length(value) - widths[col] + 4) : substr(value, 1, widths[col] - 3) "..."
                }
                line = line (position == 1 ? "" : gap) (position == visible_count ? value : sprintf(col >= 6 && col <= 9 ? "%*s" : "%-*s", widths[col], value))
            }
            return line
        }
        function normalize_ip(value,    octets, halves, left, right, n, nl, nr, i, part, result, tail) {
            gsub(/^\[|\]$/, "", value)
            sub(/%.*/, "", value)
            value = tolower(value)
            if (value ~ /\./) {
                tail = value
                sub(/^.*:/, "", tail)
                if (split(tail, octets, ".") != 4) return ""
                for (i = 1; i <= 4; i++) {
                    if (octets[i] !~ /^[0-9]+$/ || octets[i] > 255) return ""
                }
                tail = sprintf("%x:%x", octets[1] * 256 + octets[2], octets[3] * 256 + octets[4])
                if (value !~ /:/) value = "::ffff:" tail
                else sub(/[^:]+$/, tail, value)
            }
            if (value !~ /:/ || value ~ /[^0-9a-f:]/) return ""
            n = split(value, halves, "::")
            if (n > 2) return ""
            nl = halves[1] == "" ? 0 : split(halves[1], left, ":")
            nr = n == 2 && halves[2] != "" ? split(halves[2], right, ":") : 0
            if ((n == 1 && nl != 8) || (n == 2 && nl + nr >= 8)) return ""
            result = ""
            for (i = 1; i <= 8; i++) {
                part = i <= nl ? left[i] : (i > 8 - nr ? right[i - (8 - nr)] : "0")
                if (part !~ /^[0-9a-f]+$/ || length(part) > 4) return ""
                sub(/^0+/, "", part)
                if (part == "") part = "0"
                result = result (i == 1 ? "" : ":") part
            }
            return result
        }
        function endpoint_ip(endpoint) {
            sub(/:[^:]*$/, "", endpoint)
            return normalize_ip(endpoint)
        }
        function endpoint_port(endpoint) {
            sub(/^.*:/, "", endpoint)
            return endpoint
        }
        function socket_key(proto, src, sport, dst, dport) {
            return proto SUBSEP src SUBSEP sport SUBSEP dst SUBSEP dport
        }
        function remember(proto, src, sport, dst, dport, origin,    key) {
            key = socket_key(proto, src, sport, dst, dport)
            if (key in records) {
                if (records[key] != NR || origins[key] != origin) origins[key] = "UNKNOWN"
            } else {
                records[key] = NR
                origins[key] = origin
            }
        }
        function is_loopback(ip) {
            return ip == "0:0:0:0:0:0:0:1" || ip ~ /^0:0:0:0:0:ffff:7f[0-9a-f][0-9a-f]:/
        }
        function is_wildcard(ip, endpoint) {
            return ip == "0:0:0:0:0:0:0:0" ||
                ip == "0:0:0:0:0:ffff:0:0" || endpoint ~ /^\*:/
        }
        function print_row(row,    rendered) {
            rendered = render_row(row)
            if (color_enabled && wildcard_listener[row]) {
                printf "\033[1;33m%s\033[0m\n", rendered
            } else if (color_enabled && cells[row, 3] == "INBOUND*") {
                printf "\033[1;36m%s\033[0m\n", rendered
            } else {
                print rendered
            }
        }
        reading_details {
            n = split($0, detail_fields, "\t")
            if (FNR == 1) {
                if (detail_fields[1] != "Row" || detail_fields[2] != "PID") next
                columns = 8 + n
                for (i = 2; i <= n; i++) {
                    labels[8 + i] = detail_fields[i]
                    if (detail_fields[i] == "Executable" || detail_fields[i] == "App") executable_col = 8 + i
                }
                for (col = 1; col <= columns; col++) widths[col] = length(labels[col])
                detail_header = 1
                next
            }
            if (!detail_header || detail_fields[1] !~ /^[1-9][0-9]*$/ || n != columns - 8) next
            row = detail_fields[1] + 0
            for (i = 2; i <= n; i++) cells[row, 8 + i] = detail_fields[i]
            has_details[row] = 1
            next
        }
        reading_conntrack {
            proto = ""
            for (i = 1; i <= NF && i <= 3; i++) {
                if ($i == "tcp" || $i == "udp") proto = $i
            }
            if (proto == "") next
            delete tuple
            t = 0
            uncertain = 0
            for (i = 1; i <= NF; i++) {
                split($i, field, "=")
                if (field[1] == "src") t++
                if (field[1] ~ /^(src|dst|sport|dport)$/) tuple[t, field[1]] = field[2]
                # ss does not expose conntrack zones, so do not guess across them.
                if (field[1] ~ /^zone(-orig|-reply)?$/ && field[2] != "0") uncertain = 1
            }
            if (t != 2) next
            valid = 1
            for (t = 1; t <= 2; t++) {
                tuple[t, "src"] = normalize_ip(tuple[t, "src"])
                tuple[t, "dst"] = normalize_ip(tuple[t, "dst"])
                if (tuple[t, "src"] == "" || tuple[t, "dst"] == "" ||
                    tuple[t, "sport"] !~ /^[0-9]+$/ || tuple[t, "sport"] > 65535 ||
                    tuple[t, "dport"] !~ /^[0-9]+$/ || tuple[t, "dport"] > 65535) valid = 0
            }
            if (!valid) next
            if (proto == "tcp" && / ESTABLISHED / && /\[UNREPLIED\]/) uncertain = 1
            outgoing = uncertain ? "UNKNOWN" : "OUTBOUND*"
            incoming = uncertain ? "UNKNOWN" : "INBOUND*"
            # Original and reversed reply tuples cover both sides of NAT.
            remember(proto, tuple[1, "src"], tuple[1, "sport"], tuple[1, "dst"], tuple[1, "dport"], outgoing)
            remember(proto, tuple[2, "dst"], tuple[2, "dport"], tuple[2, "src"], tuple[2, "sport"], outgoing)
            remember(proto, tuple[2, "src"], tuple[2, "sport"], tuple[2, "dst"], tuple[2, "dport"], incoming)
            remember(proto, tuple[1, "dst"], tuple[1, "dport"], tuple[1, "src"], tuple[1, "sport"], incoming)
            next
        }
        FNR == 1 { header = $0; next }
        NF >= 6 && ($1 == "tcp" || $1 == "udp") {
            count++
            cells[count, 1] = $2
            cells[count, 2] = $1
            cells[count, 4] = $5
            cells[count, 5] = $6
            cells[count, 8] = $3
            cells[count, 9] = $4
            if (!(count in has_details)) {
                for (col = 10; col <= columns; col++) cells[count, col] = "-"
                tail = $0
                pids = names = ""
                delete seen_pid
                while (match(tail, /\("(([^"\\]|\\.)*)",pid=([0-9]+),fd=[0-9]+\)/, owner)) {
                    if (!(owner[3] in seen_pid)) {
                        pids = pids (pids == "" ? "" : ";") owner[3]
                        names = names (names == "" ? "" : " | ") owner[1]
                        seen_pid[owner[3]] = 1
                    }
                    tail = substr(tail, RSTART + RLENGTH)
                }
                if (pids != "") {
                    cells[count, 10] = pids
                    cells[count, executable_col] = names
                }
            }
            protocols[count] = $1
            states[count] = $2
            traffic_totals(count, $0)
            addresses[count] = $5
            sub(/:[^:]*$/, "", addresses[count])
            local_ip[count] = endpoint_ip($5)
            local_port[count] = endpoint_port($5)
            # Keep the kernel state for grouping; only rename bound UDP sockets for display.
            if ($1 == "udp" && $2 == "UNCONN" && local_port[count] ~ /^[0-9]+$/ && local_port[count] + 0 > 0) {
                cells[count, 1] = "BOUND"
            }
            wildcard_listener[count] = $2 == "LISTEN" && is_wildcard(local_ip[count], $5)
            peer_ip[count] = endpoint_ip($6)
            peer_port[count] = endpoint_port($6)
            # A scoped link-local tuple cannot be uniquely matched without its interface.
            scoped[count] = ($5 ~ /%/ || $6 ~ /%/) &&
                (local_ip[count] ~ /^fe[89ab]/ || peer_ip[count] ~ /^fe[89ab]/)
            if (local_ip[count] != "" && local_ip[count] != "0:0:0:0:0:0:0:0" &&
                local_ip[count] != "0:0:0:0:0:ffff:0:0") local_addresses[local_ip[count]] = 1
        }
        END {
            if (header == "") exit
            for (row = 1; row <= count; row++) {
                origin = "UNKNOWN"
                key = socket_key(protocols[row], local_ip[row], local_port[row], peer_ip[row], peer_port[row])
                if (states[row] == "LISTEN" || peer_port[row] == "*") origin = "-"
                else if (!scoped[row] && key in origins) {
                    origin = origins[key]
                    if (origin != "UNKNOWN" && (peer_ip[row] in local_addresses || is_loopback(peer_ip[row]))) {
                        origin = "SAME-HOST*"
                    }
                }
                cells[row, 3] = origin
                for (col = 1; col <= columns; col++) {
                    if (length(cell_text(row, col)) > widths[col]) widths[col] = length(cell_text(row, col))
                }
            }
            age_col = 0
            for (col = 1; col <= columns; col++) {
                if (labels[col] == "Age") age_col = col
            }
            for (col = 1; col <= columns; col++) {
                if (!machine) {
                    if (col == 8 && age_col) visible_columns[++visible_count] = age_col
                    if (col == age_col || (!verbose && !full_details && (col == 8 || col == 9))) continue
                }
                visible_columns[++visible_count] = col
            }
            if (clip_columns) {
                if (columns == 11) { max_width["App"] = 16; min_width["App"] = 8 }
                total_width = visible_count - 1
                for (position = 1; position <= visible_count; position++) {
                    col = visible_columns[position]
                    if (labels[col] in max_width && widths[col] > max_width[labels[col]]) widths[col] = max_width[labels[col]]
                    total_width += widths[col]
                }
                while (total_width > terminal_columns) {
                    widest = spare = 0
                    for (col = 1; col <= columns; col++) {
                        if (!(labels[col] in min_width)) continue
                        available = widths[col] - min_width[labels[col]]
                        if (available > spare) {
                            widest = col
                            spare = available
                        }
                    }
                    if (!widest) break
                    widths[widest]--
                    total_width--
                }
            }
            print render_row(0)
            for (row = 1; row <= count; row++) {
                printf "%s\t%d\t%s\t%s\t%s\t", states[row], origin_order[cells[row, 3]], protocols[row], addresses[row], local_port[row]
                print_row(row)
            }
        }
    ' reading_details=1 "${3:-/dev/null}" reading_details=0 reading_conntrack=1 "$1" reading_conntrack=0 "$2" | {
        IFS= read -r header || return 0
        printf '%s\n' "$header"
        LC_ALL=C sort -t $'\t' -k1,1 -k2,2n -k3,3 -k4,4V -k5,5n | cut -f6-
    }
}

collect_port_details() {
    local script_path=""
    if ! command -v python3 > /dev/null 2>&1; then
        printf '%s\n' 'Warning: python3 is required for process details; showing the socket table only.' >&2
        return 0
    fi
    script_path=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    python3 -I "${script_path%/*}/lib/ports.py" "$@"
}

socket_snapshot() {
    local sockets=""
    local conntrack=""
    local brief="${1:-0}" all_details="${2:-0}" verbose="${3:-0}" machine="${4:-0}"
    local details_rc=0
    local details=""
    local -a detail_args=()

    if [ "$all_details" -eq 1 ]; then
        detail_args=(--all-details)
    elif [ "$verbose" -eq 1 ]; then
        detail_args=(--verbose)
    fi
    sockets=$(LC_ALL=C sudo -n ss -tuanp -i -O) || return $?
    if ! conntrack=$(sudo -n cat /proc/net/nf_conntrack 2> /dev/null); then
        conntrack=""
        printf '%s\n' 'Warning: conntrack snapshot unavailable; connection origins will be UNKNOWN.' >&2
    fi

    if [ "$brief" -eq 0 ]; then
        details=$(printf '%s\n' "$sockets" | collect_port_details "${detail_args[@]}") || details_rc=$?
        if [ "$details_rc" -eq 130 ]; then
            return 130
        elif [ "$details_rc" -ne 0 ]; then
            details=""
            printf '%s\n' 'Warning: process detail collection failed; showing the basic socket columns.' >&2
        fi
    fi
    format_port_table <(printf '%s\n' "$conntrack") <(printf '%s\n' "$sockets") <(printf '%s\n' "$details") "$all_details" "$verbose" "$machine" || return $?
    [ "$machine" -eq 1 ] && return 0
    printf '\n%s\n' 'Origin: OUTBOUND*/INBOUND* = inferred local/remote initiation; SAME-HOST* = both endpoints on this machine.'
    printf '%s\n' '* Initiation is inferred, not verified: TCP can be picked up midstream; UDP records first-observed traffic.'
    printf '%s\n' 'UNKNOWN = no unique usable match; - = listener or socket without a connected peer. Snapshot only; no new monitoring.'
    printf '%s\n' 'BOUND = UDP socket with a local port and no fixed peer; not a TCP listening state.'
    printf '%s\n' 'Downloaded/Uploaded = TCP bytes received/acknowledged over the connection lifetime; - = unavailable. Recv/Send are queues, not totals.'
}

sockets_use_tui() {
    [[ -t 0 && -t 1 && "${TERM:-dumb}" != dumb ]]
}

show_sockets_live() {
    local script_path=""
    if ! command -v python3 > /dev/null 2>&1; then
        printf '%s\n' 'Error: python3 with curses is required for the live view; use sockets --once.' >&2
        return 1
    fi
    script_path=$(readlink -f -- "${BASH_SOURCE[0]}") || return 1
    python3 -I "${script_path%/*}/lib/sockets_tui.py" "$@"
}

show_ports() {
    local brief=0 verbose=0 all_details=0 once=0
    local -a live_args=()

    while [ "$#" -gt 0 ]; do
        case "$1" in
            --brief) brief=1 ;;
            --verbose | -v) verbose=1 ;;
            --all-details) all_details=1 ;;
            --once) once=1 ;;
            --help | -h)
                cat << 'EOF'
NAME
  netmgr sockets - live, read-only TCP/UDP socket table (alias: ports)
SYNOPSIS
  netmgr sockets [--once] [--brief | --verbose | --all-details]
DESCRIPTION
  Socket state, inferred origin, endpoints and process identity. App shows
  current process ancestry; CWD is the working directory. For live sockets,
  Age is process uptime. For CLOSED/GONE* rows, Age is time since closure was
  observed; Process age retains the last known process uptime.
  Downloaded/Uploaded are TCP lifetime bytes received/acknowledged, not queues.
OPTIONS
  --once          Print one snapshot instead of opening the live view.
  --brief         Omit metadata; show PID and the short executable name.
  --verbose, -v   Add Recv/Send queues and Command (abbreviated command paths).
  --all-details   Include all metadata columns and complete commands.
  --help, -h      Show this help. Alias: netmgr ports (same options).
OPERATION
  Interactive terminals refresh every second. Columns fit and grow with the
  terminal; live rows never wrap. Slow collection keeps the previous snapshot
  visible with its age; only one collection runs at a time.
  Arrows/PgUp/PgDn/Home/End scroll; / or F3 opens an all-column search.
  Mouse wheel scrolls five rows per notch; arrow keys move one row.
  Click a header: descending first, ascending next; each click reverses it.
  Click State to restore State > Origin > Net > Local > Port (startup order).
  F6 also chooses a sort column (including hidden columns).
  Age, Downloaded and Uploaded sort globally, then State and Origin for ties.
  Other columns stay within State and Origin groups; missing values stay last.
  Traffic totals use binary units; Enter shows exact bytes, --all-details does too.
  UDP, listeners and missing TCP counters show -, not a fabricated zero.
  Live mode follows ss -E destruction events. CLOSED rows were confirmed by
  an event; GONE* rows disappeared between successful snapshots. Both remain
  visible for 60 seconds with Age and their last available details.
  --once shows the current socket snapshot without recent history.
  Click again or press r to reverse it; ^/v shows ascending/descending.
  In F6, Enter applies, Esc cancels, and Default restores the original ordering.
  Type to filter live (case-insensitive, including hidden/full column values).
  Enter applies; Esc cancels/clears; Ctrl+U clears the search input.
  Space pauses; Enter shows a row; ? shows help; q or Ctrl+C exits.
  Resize is automatic. Inbound rows are cyan; wildcard listeners are yellow.
  Recent rows are dimmed. Age follows Uploaded, before PID. GONE* Age
  starts at the first absent snapshot, not the unknown exact disconnect time.
  Redirected output, non-interactive input and TERM=dumb use one snapshot.
  --once --verbose/--all-details retain unabridged columns and may wrap.
EXAMPLES
  netmgr sockets
  netmgr sockets --verbose
  netmgr sockets --once > sockets.txt
FILES
  /proc/net/nf_conntrack; /proc/PID; local systemd/container metadata.
PATHS
  lib/ports.py collects metadata; lib/sockets_tui.py renders the live view.
SECURITY NOTES
  Authenticates once using sudo; refreshes never prompt inside the UI.
  ss -E reads kernel destruction events; it does not capture packets. No new
  conntrack rules, socket killing or network probes are used.
  Origins are inferred, not verified. UNKNOWN means no usable unique match.
  Commands may contain secrets. Some columns hide on narrow terminals;
  Enter opens the selected row, including hidden and clipped fields.
EXIT STATUS
  0 normal exit; 1 setup failure; 2 invalid options; 130 interrupted.
  Snapshot command failures preserve their command exit status.
AUTHORS
  netmgr contributors.
EOF
                return 0
                ;;
            *)
                printf 'Error: unknown sockets option: %s\n' "$1" >&2
                return 2
                ;;
        esac
        shift
    done
    if [ "$brief" -eq 1 ] && { [ "$all_details" -eq 1 ] || [ "$verbose" -eq 1 ]; }; then
        printf '%s\n' 'Error: --brief cannot be combined with --verbose or --all-details.' >&2
        return 2
    fi
    ensure_sudo_session || return 1
    if [ "$once" -eq 0 ] && sockets_use_tui; then
        [ "$brief" -eq 1 ] && live_args+=(--brief)
        [ "$verbose" -eq 1 ] && live_args+=(--verbose)
        [ "$all_details" -eq 1 ] && live_args+=(--all-details)
        show_sockets_live "${live_args[@]}"
        return $?
    fi
    socket_snapshot "$brief" "$all_details" "$verbose"
}

bssid_scan_realtime() {
    local INTERFACE="$1"
    local DURATION_ARG="$2"
    local TARGET_CHAN="$3"
    local TARGET_FREQ="$4"
    local DURATION=0
    local finite_mode=0
    local duration_label="forever"
    local start_ms=0
    local now_ms=0
    local end_ms=0
    local remaining_s=0
    local HOTSPOT_CONN_NAME="Netmgr_Awake"
    local HOTSPOT_PSK="hunter22"
    local BAND=""
    local PHY_NUM=""
    local CAPTURE_IF="mon0"
    local hotspot_err=""
    local channel_hop_pid=""
    local freq_guard_pid=""
    local prev_conn_uuid=""
    local reconnect_ok=0
    local reconnect_conn=""
    local device_state=""
    local _poll_i=0
    local scan_interrupted=0
    local monitor_cleanup_done=0
    local found_stale=0
    local dummy_uuid=""
    local dummy_name=""
    local phy_name=""
    local hop_freq=""
    local tshark_pid=""
    local pkt_file=""
    local tshark_err=""
    local frame=""
    local tune_err=""
    local restart_note=""
    local hop_dwell_s="0.15"
    local hop_dwell_ms=150
    local stale_window_ms=12000
    local render_fd=1
    local ui_use_tty=0
    local ui_alt_screen_active=0
    local -a PRIV_CMD
    local -a hop_freqs
    local -a preferred_hop_freqs
    local -a filtered_hop_freqs

    if [ -n "$DURATION_ARG" ]; then
        if ! [[ "$DURATION_ARG" =~ ^[0-9]+$ ]] || [ "$DURATION_ARG" -le 0 ]; then
            echo "Error: duration must be a positive integer (seconds)."
            echo "Usage: netmgr bssid-scan [interface] [seconds] [--realtime] [--channel <n>] [--freq <mhz>]"
            return 1
        fi
        DURATION="$DURATION_ARG"
        finite_mode=1
        duration_label="${DURATION}s"
    fi

    if [ -n "$TARGET_CHAN" ] && ! [[ "$TARGET_CHAN" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid channel value: $TARGET_CHAN"
        return 1
    fi
    if [ -n "$TARGET_FREQ" ] && ! [[ "$TARGET_FREQ" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid frequency value: $TARGET_FREQ"
        return 1
    fi

    if ! command -v tshark > /dev/null 2>&1; then
        echo "Error: tshark is required for bssid-scan --realtime."
        return 1
    fi

    if [ "$EUID" -eq 0 ]; then
        PRIV_CMD=()
    else
        if ! sudo -v; then
            echo "Error: sudo authentication failed."
            return 1
        fi
        PRIV_CMD=(sudo)
    fi

    monitor_cleanup() {
        if [ "$monitor_cleanup_done" -eq 1 ]; then
            return 0
        fi
        monitor_cleanup_done=1

        if [ -n "$channel_hop_pid" ]; then
            kill "$channel_hop_pid" > /dev/null 2>&1 || true
            wait "$channel_hop_pid" 2> /dev/null || true
            channel_hop_pid=""
        fi
        if [ -n "$freq_guard_pid" ]; then
            kill "$freq_guard_pid" > /dev/null 2>&1 || true
            wait "$freq_guard_pid" 2> /dev/null || true
            freq_guard_pid=""
        fi
        if [ -n "$tshark_pid" ]; then
            kill "$tshark_pid" > /dev/null 2>&1 || true
            wait "$tshark_pid" 2> /dev/null || true
            tshark_pid=""
        fi

        if [ "$ui_alt_screen_active" -eq 1 ]; then
            tput rmcup 1>&"$render_fd" 2> /dev/null || printf "\033[?1049l" 1>&"$render_fd"
            ui_alt_screen_active=0
        fi

        log_ok "Stopping realtime monitor mode and restoring managed/connected state on ${INTERFACE}..."
        "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" del > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection down "$HOTSPOT_CONN_NAME" > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection down netmgr_dummy > /dev/null 2>&1 || true
        while IFS=: read -r dummy_uuid dummy_name; do
            [ -z "$dummy_uuid" ] && continue
            "${PRIV_CMD[@]}" nmcli connection delete uuid "$dummy_uuid" > /dev/null 2>&1 || true
        done < <(nmcli -t -f UUID,NAME connection show 2> /dev/null | awk -F: '$2=="netmgr_dummy" || $2=="Netmgr_Awake" {print $1 ":" $2}')
        "${PRIV_CMD[@]}" nmcli connection delete "$HOTSPOT_CONN_NAME" > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection delete netmgr_dummy > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli device set "$INTERFACE" managed yes > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" ip link set "$INTERFACE" up > /dev/null 2>&1 || true

        reconnect_ok=0
        if [ -n "$prev_conn_uuid" ]; then
            if "${PRIV_CMD[@]}" nmcli connection up uuid "$prev_conn_uuid" ifname "$INTERFACE" > /dev/null 2>&1; then
                reconnect_ok=1
            fi
        fi
        if [ "$reconnect_ok" -eq 0 ]; then
            if "${PRIV_CMD[@]}" nmcli device connect "$INTERFACE" > /dev/null 2>&1; then
                reconnect_ok=1
            fi
        fi
        # Never restart NetworkManager globally to recover one scan interface.
        for _poll_i in 1 2 3 4 5 6; do
            reconnect_conn=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2> /dev/null | awk -F: -v dev="$INTERFACE" '$1==dev && $2=="wifi" && $3=="connected" {print $4; exit}')
            if [ -n "$reconnect_conn" ]; then
                reconnect_ok=1
                break
            fi
            sleep 1
        done
        device_state=$(nmcli -t -f GENERAL.STATE device show "$INTERFACE" 2> /dev/null | awk -F: '/^GENERAL.STATE:/ {print $2; exit}')
        if [ "$reconnect_ok" -eq 1 ] && [ -n "$reconnect_conn" ]; then
            log_ok "Reconnected ${INTERFACE} to Wi-Fi successfully (${reconnect_conn})."
        elif [ "$reconnect_ok" -eq 1 ]; then
            log_ok "Reconnect command completed for ${INTERFACE} (state: ${device_state:-unknown})."
        else
            log_err "Failed to reconnect ${INTERFACE} automatically."
        fi

        [ -n "$pkt_file" ] && rm -f "$pkt_file"
        [ -n "$tshark_err" ] && rm -f "$tshark_err"
    }

    log_ok "Starting realtime BSSID scan on ${INTERFACE} using monitor mode..."
    prev_conn_uuid=$(nmcli -t -f UUID,DEVICE connection show --active 2> /dev/null | awk -F: -v dev="$INTERFACE" '$2==dev {print $1; exit}')
    PHY_NUM=$("${PRIV_CMD[@]}" iw dev "$INTERFACE" info 2> /dev/null | awk '/wiphy/ {print "phy"$2; exit}')
    if [ -z "$PHY_NUM" ]; then
        echo "Error: could not determine phy for interface ${INTERFACE}."
        return 1
    fi

    log_ok "Preflight: ensuring stale monitor/hotspot resources do not exist..."
    found_stale=0
    if "${PRIV_CMD[@]}" iw dev | grep -qE '^[[:space:]]*Interface[[:space:]]+mon0$'; then
        found_stale=1
        log_ok "Preflight: deleting existing mon0."
        "${PRIV_CMD[@]}" ip link set "$CAPTURE_IF" down > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" del > /dev/null 2>&1 || true
    fi
    while IFS=: read -r dummy_uuid dummy_name; do
        [ -z "$dummy_uuid" ] && continue
        found_stale=1
        log_ok "Preflight: deleting existing hotspot profile ${dummy_name} (uuid: $dummy_uuid)."
        "${PRIV_CMD[@]}" nmcli connection down uuid "$dummy_uuid" > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection delete uuid "$dummy_uuid" > /dev/null 2>&1 || true
    done < <(nmcli -t -f UUID,NAME connection show 2> /dev/null | awk -F: '$2=="netmgr_dummy" || $2=="Netmgr_Awake" {print $1 ":" $2}')
    if [ "$found_stale" -eq 0 ]; then
        log_ok "Preflight: no stale mon0/Netmgr_Awake/netmgr_dummy resources found."
    fi

    # Stop NetworkManager from retuning or reclaiming the managed interface while mon0 captures.
    # This materially improves monitor-mode reliability on mt7921e/mt7922-class cards.
    "${PRIV_CMD[@]}" nmcli device disconnect "$INTERFACE" > /dev/null 2>&1 || true
    "${PRIV_CMD[@]}" nmcli device set "$INTERFACE" managed no > /dev/null 2>&1 || true
    "${PRIV_CMD[@]}" ip link set "$INTERFACE" down > /dev/null 2>&1 || true

    log_ok "Creating monitor interface mon0 on ${PHY_NUM}..."
    if ! "${PRIV_CMD[@]}" iw phy "$PHY_NUM" interface add "$CAPTURE_IF" type monitor; then
        echo "Error: failed to create ${CAPTURE_IF} on ${PHY_NUM}."
        monitor_cleanup
        return 1
    fi
    if ! "${PRIV_CMD[@]}" ip link set "$CAPTURE_IF" up; then
        echo "Error: failed to set ${CAPTURE_IF} up."
        monitor_cleanup
        return 1
    fi
    if ! "${PRIV_CMD[@]}" iw dev | grep -qE "^[[:space:]]*Interface[[:space:]]+${CAPTURE_IF}$"; then
        echo "Error: ${CAPTURE_IF} interface was not created successfully."
        monitor_cleanup
        return 1
    fi
    phy_name=$("${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" info 2> /dev/null | awk '/wiphy/ {print "phy"$2; exit}')
    if [ -n "$phy_name" ]; then
        mapfile -t hop_freqs < <("${PRIV_CMD[@]}" iw phy "$phy_name" info 2> /dev/null | awk '
            /MHz \[/ && $0 !~ /disabled/ {
                for (i = 1; i <= NF; i++) {
                    if ($i == "MHz" && (i - 1) >= 1 && $(i - 1) ~ /^[0-9]+(\.[0-9]+)?$/) {
                        print int($(i - 1))
                        break
                    }
                }
            }
        ' | sort -n -u)
    fi
    if [ -n "${NETMGR_BSSID_SCAN_FREQS:-}" ]; then
        # User-supplied priority list, e.g. NETMGR_BSSID_SCAN_FREQS="5975 6055 2412".
        # This is useful when waiting for a known phone hotspot frequency.
        read -r -a preferred_hop_freqs <<< "${NETMGR_BSSID_SCAN_FREQS}"
    else
        preferred_hop_freqs=(
            # Prioritize the observed RedMagic/6 GHz PSC frequencies first so a phone hotspot
            # does not wait behind all 2.4 GHz channels in generic hopping mode.
            5975 6055 6135 6215 6295 6375
            2412 2417 2422 2427 2432 2437 2442 2447 2452 2457 2462 2467 2472
            5180 5200 5220 5240
            5745 5765 5785 5805
        )
    fi
    filtered_hop_freqs=()
    if [ "${#hop_freqs[@]}" -gt 0 ]; then
        for hop_freq in "${preferred_hop_freqs[@]}"; do
            if printf '%s\n' "${hop_freqs[@]}" | grep -qx "$hop_freq"; then
                filtered_hop_freqs+=("$hop_freq")
            fi
        done
        if [ "${#filtered_hop_freqs[@]}" -ge 3 ]; then
            hop_freqs=("${filtered_hop_freqs[@]}")
        fi
    fi
    if [ "${#hop_freqs[@]}" -eq 0 ]; then
        # Safe fallback includes 6 GHz PSC-style frequencies, including the observed RedMagic hotspot at 5975 MHz.
        hop_freqs=(5975 6055 6135 6215 6295 6375 2412 2437 2462 5180 5200 5220 5240 5745 5765 5785 5805)
    fi

    if [ -n "$TARGET_FREQ" ]; then
        log_ok "Initializing MediaTek wakeup sequence on frequency ${TARGET_FREQ} MHz..."
        if [ "$TARGET_FREQ" -ge 2400 ] && [ "$TARGET_FREQ" -lt 2500 ]; then
            BAND="bg"
        elif [ "$TARGET_FREQ" -ge 4900 ] && [ "$TARGET_FREQ" -lt 5950 ]; then
            BAND="a"
        elif [ "$TARGET_FREQ" -ge 5950 ] && [ "$TARGET_FREQ" -le 7125 ]; then
            BAND="a"
        else
            echo "Error: unsupported Wi-Fi frequency: ${TARGET_FREQ} MHz"
            monitor_cleanup
            return 1
        fi
        log_ok "Tuning ${CAPTURE_IF} to ${TARGET_FREQ} MHz..."
        tune_err=$(mktemp)
        if ! "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set freq "$TARGET_FREQ" 2> "$tune_err"; then
            log_err "Warning: failed to explicitly set ${CAPTURE_IF} to ${TARGET_FREQ} MHz: $(cat "$tune_err" 2> /dev/null)"
            log_err "Continuing anyway; the PHY may be controlled by the driver/firmware."
        fi
        rm -f "$tune_err"
    elif [ -n "$TARGET_CHAN" ]; then
        log_ok "Initializing MediaTek wakeup sequence on channel ${TARGET_CHAN}..."
        if [ "$TARGET_CHAN" -le 14 ]; then
            BAND="bg"
        else
            BAND="a"
        fi
        log_ok "Igniting dummy hotspot to wake up hardware..."
        if ! hotspot_err=$("${PRIV_CMD[@]}" nmcli device wifi hotspot ifname "$INTERFACE" con-name "$HOTSPOT_CONN_NAME" ssid "Netmgr_Scan" password "$HOTSPOT_PSK" band "$BAND" channel "$TARGET_CHAN" 2>&1); then
            log_err "Failed to create dummy hotspot on ${INTERFACE} channel ${TARGET_CHAN}: ${hotspot_err}"
        fi
        tune_err=$(mktemp)
        if ! "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set channel "$TARGET_CHAN" 2> "$tune_err"; then
            log_err "Warning: failed to explicitly set ${CAPTURE_IF} to channel ${TARGET_CHAN}: $(cat "$tune_err" 2> /dev/null)"
            log_err "Continuing anyway because the PHY may already be channel-locked by the dummy hotspot."
        fi
        rm -f "$tune_err"
        log_ok "Hardware awake and locked to channel ${TARGET_CHAN}."
    fi

    if [ -z "$TARGET_CHAN" ] && [ -z "$TARGET_FREQ" ]; then
        "${PRIV_CMD[@]}" nmcli device disconnect "$INTERFACE" > /dev/null 2>&1 || true
        stale_window_ms=$((${#hop_freqs[@]} * hop_dwell_ms * 2))
        if [ "$stale_window_ms" -lt 5000 ]; then
            stale_window_ms=5000
        fi
        log_ok "No fixed channel specified; using channel hopping on ${CAPTURE_IF}."
        log_ok "Passive monitor mode selected. For near-instant RedMagic/6 GHz hotspot detection, use active mode: netmgr bssid-scan ${INTERFACE} --realtime --active --freq 5975 --ssid '<SSID>'"
        log_ok "Hop set: ${#hop_freqs[@]} frequencies (~$(awk -v n="${#hop_freqs[@]}" -v d="$hop_dwell_s" 'BEGIN{printf "%.1f", n*d}')s full cycle)."
        log_ok "Row retention window: ~$(awk -v ms="$stale_window_ms" 'BEGIN{printf "%.1f", ms/1000.0}')s (prevents flicker while hopping)."
        (
            while true; do
                for hop_freq in "${hop_freqs[@]}"; do
                    "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set freq "$hop_freq" > /dev/null 2>&1 || true
                    sleep "$hop_dwell_s"
                done
            done
        ) &
        channel_hop_pid=$!
    else
        stale_window_ms=6000
    fi

    if [ -n "$TARGET_FREQ" ]; then
        tune_err=$(mktemp)
        if ! "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set freq "$TARGET_FREQ" 2> "$tune_err"; then
            log_err "Warning: failed to set ${CAPTURE_IF} to ${TARGET_FREQ} MHz before capture: $(cat "$tune_err" 2> /dev/null)"
        fi
        rm -f "$tune_err"
    elif [ -n "$TARGET_CHAN" ]; then
        tune_err=$(mktemp)
        if ! "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set channel "$TARGET_CHAN" 2> "$tune_err"; then
            log_err "Warning: failed to set ${CAPTURE_IF} to channel ${TARGET_CHAN} before capture: $(cat "$tune_err" 2> /dev/null)"
            log_err "Continuing anyway."
        fi
        rm -f "$tune_err"
    else
        if [ "${#hop_freqs[@]}" -gt 0 ]; then
            if ! "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set freq "${hop_freqs[0]}" > /dev/null 2>&1; then
                echo "Warning: failed to set initial monitor frequency ${hop_freqs[0]} on ${CAPTURE_IF}."
            fi
        fi
    fi

    # In fixed-frequency mode, continuously reassert the requested frequency. Some mt7921e/mt7922
    # firmware/driver combinations can drift back to a default channel after interface creation or
    # capture startup. This guard makes --freq 5975 behave as a real pinned-frequency capture.
    if [ -n "$TARGET_FREQ" ]; then
        (
            while true; do
                "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set freq "$TARGET_FREQ" > /dev/null 2>&1 || true
                sleep 0.20
            done
        ) &
        freq_guard_pid=$!
    fi

    "${PRIV_CMD[@]}" ip link set "$CAPTURE_IF" up > /dev/null 2>&1 || true
    sleep 0.2

    pkt_file=$(mktemp)
    tshark_err=$(mktemp)
    "${PRIV_CMD[@]}" tshark -l -n -i "$CAPTURE_IF" \
        -Y 'wlan.fc.type_subtype == 0x08 || wlan.fc.type_subtype == 0x05' \
        -T fields -E separator=$'\t' -E occurrence=a \
        -e frame.time_epoch -e wlan.bssid -e wlan.ssid -e radiotap.dbm_antsignal -e wlan_radio.channel -e wlan_radio.frequency \
        2> "$tshark_err" > "$pkt_file" &
    tshark_pid=$!

    start_ms=$(date +%s%3N)
    if [ "$finite_mode" -eq 1 ]; then
        end_ms=$((start_ms + (DURATION * 1000)))
    else
        end_ms=0
    fi
    trap 'scan_interrupted=1' INT TERM

    if [ -t 1 ]; then
        ui_use_tty=1
    elif [ -w /dev/tty ]; then
        exec {render_fd}> /dev/tty
        ui_use_tty=1
    fi
    if [ "$ui_use_tty" -eq 1 ] && command -v tput > /dev/null 2>&1; then
        if tput smcup 1>&"$render_fd" 2> /dev/null; then
            ui_alt_screen_active=1
        else
            printf "\033[?1049h" 1>&"$render_fd"
            ui_alt_screen_active=1
        fi
    elif [ "$ui_use_tty" -eq 1 ]; then
        printf "\033[?1049h" 1>&"$render_fd"
        ui_alt_screen_active=1
    fi

    while :; do
        stty sane 2> /dev/null || true
        now_ms=$(date +%s%3N)
        restart_note=""
        if [ -n "$tshark_pid" ] && ! kill -0 "$tshark_pid" 2> /dev/null; then
            restart_note="Warning: tshark exited; restarting capture."
            if [ -s "$tshark_err" ]; then
                restart_note="${restart_note}\n$(tail -n 10 "$tshark_err" 2> /dev/null)"
            fi
            : > "$tshark_err"
            "${PRIV_CMD[@]}" tshark -l -n -i "$CAPTURE_IF" \
                -Y 'wlan.fc.type_subtype == 0x08 || wlan.fc.type_subtype == 0x05' \
                -T fields -E separator=$'\t' -E occurrence=a \
                -e frame.time_epoch -e wlan.bssid -e wlan.ssid -e radiotap.dbm_antsignal -e wlan_radio.channel -e wlan_radio.frequency \
                2>> "$tshark_err" >> "$pkt_file" &
            tshark_pid=$!
        fi
        local table_rows=""
        if [ -s "$pkt_file" ]; then
            table_rows=$(tail -n 12000 "$pkt_file" | awk -F'\t' -v now_ms="$now_ms" -v stale_ms="$stale_window_ms" '
                function normalize_mac(m, a, i, out) {
                    gsub(/-/, ":", m)
                    m = tolower(m)
                    n = split(m, a, ":")
                    if (n != 6) return ""
                    out = ""
                    for (i = 1; i <= 6; i++) {
                        if (a[i] !~ /^[0-9a-f]{1,2}$/) return ""
                        if (length(a[i]) == 1) a[i] = "0" a[i]
                        out = out ((i == 1) ? "" : ":") a[i]
                    }
                    return out
                }
                function maybe_decode_ssid(s,    h, i, b, v, out) {
                    if (s == "" || s == "<MISSING>") return ""
                    h = s
                    sub(/^0x/, "", h)
                    if (h ~ /^[0-9A-Fa-f]+$/ && (length(h) % 2) == 0) {
                        out = ""
                        for (i = 1; i <= length(h); i += 2) {
                            b = substr(h, i, 2)
                            v = strtonum("0x" b)
                            if (v == 0) continue
                            out = out sprintf("%c", v)
                        }
                        if (out != "") return out
                    }
                    return s
                }
                function last_numeric(raw,    v, parts, n, i, tok) {
                    v = raw
                    gsub(/[[:space:]]/, "", v)
                    n = split(v, parts, ",")
                    for (i = n; i >= 1; i--) {
                        tok = parts[i]
                        if (tok ~ /^-?[0-9]+(\.[0-9]+)?$/) {
                            return tok + 0
                        }
                    }
                    return ""
                }
                function band_for_freq(f, c) {
                    if (f ~ /^[0-9]+$/) {
                        if ((f + 0) >= 2400 && (f + 0) < 2500) return "2.4GHz"
                        if ((f + 0) >= 4900 && (f + 0) < 5950) return "5GHz"
                        if ((f + 0) >= 5950 && (f + 0) <= 7125) return "6GHz"
                    }
                    if (c ~ /^[0-9]+$/ && (c + 0) >= 1 && (c + 0) <= 14) return "2.4GHz"
                    if (c ~ /^[0-9]+$/) return "5GHz"
                    return "?"
                }
                {
                    ts = $1
                    b = normalize_mac($2)
                    if (b == "") next
                    seen_map[b] = 1
                    ssid = maybe_decode_ssid($3)
                    rssi = last_numeric($4)
                    ch = last_numeric($5)
                    fr = last_numeric($6)
                    if (ts ~ /^[0-9]+(\.[0-9]+)?$/) {
                        ts_val = ts + 0
                        ts_map[b] = ts_val
                    }
                    if (ssid != "") ssid_map[b] = ssid
                    if (ch != "") ch_map[b] = int(ch)
                    if (fr != "") fr_map[b] = int(fr)
                    if (rssi != "") rssi_map[b] = int(rssi)
                }
                END {
                    now_s = now_ms / 1000.0
                    for (b in seen_map) {
                        ts = (b in ts_map) ? ts_map[b] : 0
                        age_ms = (ts > 0) ? int((now_s - ts) * 1000.0) : -1
                        if (age_ms > stale_ms) {
                            continue
                        }
                        s = (b in ssid_map && ssid_map[b] != "") ? ssid_map[b] : "<hidden>"
                        c = (b in ch_map && ch_map[b] != "") ? ch_map[b] : "?"
                        f = (b in fr_map && fr_map[b] != "") ? fr_map[b] : "?"
                        if (b in rssi_map) {
                            r = rssi_map[b]
                            p = int((r + 100) * 2)
                            if (p < 0) p = 0
                            if (p > 100) p = 100
                            sort_r = r
                        } else {
                            r = "N/A"
                            p = 0
                            sort_r = -999
                        }
                        gsub(/[\t\r\n[:cntrl:]]+/, " ", s)
                        if (length(s) > 48) s = substr(s, 1, 45) "..."
                        age_s = (age_ms >= 0) ? sprintf("%.1f", age_ms / 1000.0) : "?"
                        printf "%s\t%s\t%s\t%s\t%s\t%s\t%d\t%s\t%d\n", toupper(b), s, c, f, band_for_freq(f, c), age_s, p, r, sort_r
                    }
                }
            ' | sort -t $'\t' -k9,9nr -k1,1V | awk -F'\t' 'BEGIN{OFS="\t"} {print $1,$2,$3,$4,$5,$6,$7,$8}')
        fi

        frame="$(
            {
                echo "Realtime BSSID scan on ${INTERFACE} via ${CAPTURE_IF} (monitor mode, live refresh 0.15s)..."
                if [ -n "$TARGET_FREQ" ]; then
                    echo "Mode: fixed frequency ${TARGET_FREQ} MHz (guard reasserts every 0.20s)"
                elif [ -n "$TARGET_CHAN" ]; then
                    echo "Mode: fixed channel ${TARGET_CHAN}"
                else
                    echo "Mode: hopping ${#hop_freqs[@]} freqs; first freqs: $(printf '%s ' "${hop_freqs[@]}" | cut -c1-80)"
                fi
                if [ "$finite_mode" -eq 1 ]; then
                    remaining_s=$(((end_ms - now_ms + 999) / 1000))
                    if [ "$remaining_s" -lt 0 ]; then
                        remaining_s=0
                    fi
                    echo "Time remaining: ${remaining_s}s (Press 'c' to connect, 'q' or Ctrl+C to stop)"
                else
                    echo "Running continuously (Press 'c' to connect, 'q' or Ctrl+C to stop)"
                fi
                echo "--------------------------------------------------------------------------------"
                echo "mon0 exists: $("${PRIV_CMD[@]}" iw dev 2> /dev/null | grep -q "Interface mon0" && echo yes || echo no)"
                echo "mon0 info:"
                "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" info 2>&1 | sed 's/^/  /'
                echo "tshark alive: $([ -n "$tshark_pid" ] && kill -0 "$tshark_pid" 2> /dev/null && echo yes || echo no), pkt bytes: $(wc -c < "$pkt_file" 2> /dev/null || echo 0)"
                if [ -n "$restart_note" ]; then
                    echo "--------------------------------------------------------------------------------"
                    printf "%b\n" "$restart_note"
                fi

                if [ -n "$table_rows" ]; then
                    {
                        printf "BSSID\tSSID\tChannel\tFreq_MHz\tBand\tAge_s\tSignal_pct\tRSSI_dBm\n"
                        printf "%s\n" "$table_rows"
                    } | column -t -s $'\t'
                else
                    echo "No monitor frames yet."
                fi
                echo "--------------------------------------------------------------------------------"
            }
        )"

        if [ "$ui_use_tty" -eq 1 ] && command -v tput > /dev/null 2>&1; then
            tput cup 0 0 1>&"$render_fd" 2> /dev/null || printf "\033[H" 1>&"$render_fd"
            tput ed 1>&"$render_fd" 2> /dev/null || printf "\033[2J" 1>&"$render_fd"
        else
            printf "\033[H\033[2J" 1>&"$render_fd"
        fi
        printf "%s\n" "$frame" 1>&"$render_fd"

        if [ "$scan_interrupted" -eq 1 ] || { [ "$finite_mode" -eq 1 ] && [ "$now_ms" -ge "$end_ms" ]; }; then
            break
        fi

        if read -r -t 0.15 -n 1 key; then
            if [[ "$key" == "c" || "$key" == "C" ]]; then
                local -a bssids=()
                local -a ssids=()
                local -a channels=()
                local -a signals=()
                local -a bands=()
                while IFS=$'\t' read -r b s c f band _age p _r; do
                    [ -z "$b" ] && continue
                    bssids+=("$b")
                    ssids+=("$s")
                    channels+=("$c")
                    signals+=("$p")
                    bands+=("$band")
                done < <(printf "%s\n" "$table_rows")

                if [ "${#bssids[@]}" -eq 0 ]; then
                    echo "No networks available."
                    sleep 1
                    continue
                fi

                printf "\033[H\033[2J"
                echo "Discovered Wi-Fi Networks (Monitor Mode):"
                echo "--------------------------------------------------------------------------------"
                printf "  %-3s  %-18s  %-30s  %-8s  %-6s  %-6s\n" "Num" "BSSID" "SSID" "Band" "Chan" "Signal"
                echo "--------------------------------------------------------------------------------"
                for i in "${!bssids[@]}"; do
                    printf "  %-3s  %-18s  %-30s  %-8s  %-6s  %-6s%%\n" "$((i + 1))" "${bssids[$i]}" "${ssids[$i]}" "${bands[$i]}" "${channels[$i]}" "${signals[$i]}"
                done
                echo "--------------------------------------------------------------------------------"
                echo ""
                read -r -p "Enter number to connect (1-${#bssids[@]}), or Enter to cancel: " choice
                if [ -n "$choice" ] && [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#bssids[@]}" ]; then
                    local selected_idx=$((choice - 1))
                    local selected_bssid="${bssids[$selected_idx]}"
                    local selected_ssid="${ssids[$selected_idx]}"
                    read -r -s -p "Enter Wi-Fi password for ${selected_ssid} (leave empty if open/saved): " wifi_pw
                    echo ""
                    echo "Restoring managed mode on ${INTERFACE} before connecting..."
                    monitor_cleanup
                    echo "Connecting to ${selected_ssid} (${selected_bssid})..."
                    connect_wifi_bssid "$INTERFACE" "$selected_bssid" "$wifi_pw"
                    exit "$?"
                fi
            elif [[ "$key" == "q" || "$key" == "Q" ]]; then
                break
            fi
        fi
    done

    trap - INT TERM
    monitor_cleanup
    if [ "$render_fd" -ne 1 ]; then
        exec {render_fd}>&-
    fi
    echo ""
    if [ "$scan_interrupted" -eq 1 ]; then
        return 130
    fi
    return 0
}

bssid_scan_active_realtime() {
    local INTERFACE="$1"
    local DURATION_ARG="$2"
    local TARGET_FREQ="$3"
    local TARGET_SSID="$4"
    local DURATION=0
    local finite_mode=0
    local start_ms=0
    local now_ms=0
    local end_ms=0
    local remaining_s=0
    local scan_interrupted=0
    local scan_out=""
    local scan_err=""
    local err_text=""
    local parsed_rows=""
    local table_rows=""
    local last_table_rows=""
    local last_good_ms=0
    local last_good_age=""
    local scan_status=""
    local render_fd=1
    local ui_use_tty=0
    local ui_alt_screen_active=0
    local key=""
    local frame_file=""
    local loop_sleep_default=""
    local loop_sleep=""
    local -a PRIV_CMD
    local -a scan_cmd
    local -a stage_c_freqs
    local -a known_probe_ssids
    local scan_cycle=0
    local full_scan_every="${NETMGR_ACTIVE_FULL_SCAN_EVERY:-6}"
    local max_probe_ssids="${NETMGR_ACTIVE_SCAN_MAX_SSIDS:-4}"
    local scan_kind=""
    local stage_c_freq_string=""
    local known_ssid=""
    local ssid_count=0
    local selected_idx=""
    local selected_bssid=""
    local selected_ssid=""
    local selected_freq=""
    local selected_profile=""
    local choice=""
    local wifi_pw=""
    local display_ssid=""
    local rc=0

    if [ -n "$DURATION_ARG" ]; then
        if ! [[ "$DURATION_ARG" =~ ^[0-9]+$ ]] || [ "$DURATION_ARG" -le 0 ]; then
            echo "Error: duration must be a positive integer (seconds)."
            return 1
        fi
        DURATION="$DURATION_ARG"
        finite_mode=1
    fi

    if [ -n "$TARGET_FREQ" ] && ! [[ "$TARGET_FREQ" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid frequency value: $TARGET_FREQ"
        return 1
    fi

    if ! command -v iw > /dev/null 2>&1; then
        echo "Error: iw is required for active realtime BSSID scan."
        return 1
    fi

    if [ "$EUID" -eq 0 ]; then
        PRIV_CMD=()
    else
        if ! sudo -v; then
            echo "Error: sudo authentication failed."
            return 1
        fi
        PRIV_CMD=(sudo)
    fi

    scan_err=$(mktemp)
    frame_file=$(mktemp)
    active_cleanup() {
        if [ "$ui_alt_screen_active" -eq 1 ]; then
            tput rmcup 1>&"$render_fd" 2> /dev/null || printf "\033[?1049l" 1>&"$render_fd"
            ui_alt_screen_active=0
        fi
        [ -n "$scan_err" ] && rm -f "$scan_err"
        [ -n "$frame_file" ] && rm -f "$frame_file"
    }

    seed_link_row() {
        "${PRIV_CMD[@]}" iw dev "$INTERFACE" link 2> /dev/null | awk '
            function freq_num(f) { return (f ~ /^[0-9]+(\.[0-9]+)?$/) ? int(f + 0.5) : 0 }
            function infer_band(f,    n) {
                n = freq_num(f)
                if (n >= 2400 && n < 2500) return "2.4GHz"
                if (n >= 4900 && n < 5950) return "5GHz"
                if (n >= 5950 && n <= 7125) return "6GHz"
                return "?"
            }
            function infer_channel(f,    n) {
                n = freq_num(f)
                if (n == 2484) return 14
                if (n >= 2412 && n <= 2472) return int((n - 2407) / 5)
                if (n >= 5000 && n < 5950) return int((n - 5000) / 5)
                if (n >= 5955 && n <= 7115) return int((n - 5950) / 5)
                return "?"
            }
            /^Connected to[[:space:]]/ {
                b=$3
                sub(/\(.*/, "", b)
                next
            }
            /^[[:space:]]*SSID:/ {
                ssid=$0
                sub(/^[[:space:]]*SSID:[[:space:]]*/, "", ssid)
                next
            }
            /^[[:space:]]*freq:/ { freq=$2; next }
            /^[[:space:]]*signal:/ { signal=int($2); next }
            END {
                if (b == "") exit
                if (ssid == "") ssid = "<hidden>"
                sigpct = 0
                if (signal ~ /^-?[0-9]+$/) {
                    sigpct = int((signal + 100) * 2)
                    if (sigpct < 0) sigpct = 0
                    if (sigpct > 100) sigpct = 100
                } else {
                    signal = "N/A"
                }
                gsub(/[\t\r\n[:cntrl:]]+/, " ", ssid)
                if (length(ssid) > 48) ssid = substr(ssid, 1, 45) "..."
                printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", toupper(b), ssid, infer_channel(freq), freq, infer_band(freq), "linked", sigpct, signal
            }
        '
    }

    load_known_probe_ssids() {
        local conn_name=""
        local conn_ssid=""
        local seen_key=""
        local -A seen_ssids=()

        known_probe_ssids=()
        if [ -n "$TARGET_SSID" ]; then
            known_probe_ssids+=("$TARGET_SSID")
            seen_ssids["$TARGET_SSID"]=1
        fi

        if [ "${NETMGR_ACTIVE_PROBE_SAVED_SSIDS:-1}" = "0" ]; then
            return 0
        fi

        if command -v nmcli > /dev/null 2>&1; then
            while IFS= read -r conn_name; do
                [ -z "$conn_name" ] && continue
                conn_ssid=$("${PRIV_CMD[@]}" nmcli -g 802-11-wireless.ssid connection show "$conn_name" 2> /dev/null | head -n 1)
                [ -z "$conn_ssid" ] && conn_ssid="$conn_name"
                [ -z "$conn_ssid" ] && continue
                seen_key="$conn_ssid"
                if [ -n "${seen_ssids[$seen_key]+x}" ]; then
                    continue
                fi
                known_probe_ssids+=("$conn_ssid")
                seen_ssids["$seen_key"]=1
                if [ "${#known_probe_ssids[@]}" -ge "$max_probe_ssids" ]; then
                    break
                fi
            done < <("${PRIV_CMD[@]}" nmcli -t -f NAME,TYPE connection show 2> /dev/null | awk -F: '$2=="802-11-wireless" {print $1}')
        fi
    }

    find_wifi_connection_for_ssid() {
        local target_ssid="$1"
        local conn_name=""
        local conn_ssid=""

        [ -z "$target_ssid" ] && return 1
        [ "$target_ssid" = "<hidden>" ] && return 1
        command -v nmcli > /dev/null 2>&1 || return 1

        while IFS= read -r conn_name; do
            [ -z "$conn_name" ] && continue
            conn_ssid=$("${PRIV_CMD[@]}" nmcli -g 802-11-wireless.ssid connection show "$conn_name" 2> /dev/null | head -n 1)
            [ -z "$conn_ssid" ] && conn_ssid="$conn_name"
            if [ "$conn_ssid" = "$target_ssid" ] || [ "$conn_name" = "$target_ssid" ]; then
                printf "%s\n" "$conn_name"
                return 0
            fi
        done < <("${PRIV_CMD[@]}" nmcli -t -f NAME,TYPE connection show 2> /dev/null | awk -F: '$2=="802-11-wireless" {print $1}')
        return 1
    }

    connect_selected_active_bssid() {
        local conn_bssid="$1"
        local conn_ssid="$2"
        local _conn_freq="$3"
        local conn_pw="$4"
        local conn_profile=""
        local nm_rescan_err=""
        local connect_err=""
        local rc=1

        if ! command -v nmcli > /dev/null 2>&1; then
            echo "Error: nmcli is required to connect from realtime scan results."
            return 1
        fi

        "${PRIV_CMD[@]}" nmcli radio wifi on > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli device set "$INTERFACE" managed yes > /dev/null 2>&1 || true
        "${PRIV_CMD[@]}" ip link set "$INTERFACE" up > /dev/null 2>&1 || true

        conn_profile=$(find_wifi_connection_for_ssid "$conn_ssid" || true)

        # Active iw-scan results are not necessarily present in NetworkManager's AP cache.
        # With the iwd backend, nmcli does not support the `ssid` rescan option, so use
        # a plain NM rescan as a best-effort cache refresh and rely primarily on
        # `nmcli connection up <saved-profile>` for saved networks.
        nm_rescan_err=$("${PRIV_CMD[@]}" nmcli --wait 5 device wifi rescan ifname "$INTERFACE" 2>&1 || true)
        sleep 0.5

        connect_err=$(mktemp)
        if [ -n "$conn_profile" ] && [ -z "$conn_pw" ]; then
            local profile_ifname=""
            profile_ifname=$("${PRIV_CMD[@]}" nmcli -g connection.interface-name connection show "$conn_profile" 2> /dev/null | head -n 1)
            if [ -n "$profile_ifname" ] && [ "$profile_ifname" != "$INTERFACE" ]; then
                echo "Saved profile '$conn_profile' is pinned to interface '$profile_ifname', not '$INTERFACE'; skipping saved-profile activation." >&2
                echo "Falling back to direct SSID connect." >&2
            else
                echo "Using saved NetworkManager profile: $conn_profile"
                # Prefer saved profiles over AP-cache/BSSID connects. This works even when
                # raw iw saw an AP before NetworkManager/KDE imported it into their AP list.
                if "${PRIV_CMD[@]}" nmcli --wait 20 connection up "$conn_profile" ifname "$INTERFACE" 2> "$connect_err"; then
                    rm -f "$connect_err"
                    return 0
                else
                    rc=$?
                fi
                echo "Saved profile connect failed; falling back to direct SSID/BSSID connect." >&2
                cat "$connect_err" >&2
                : > "$connect_err"
            fi
        fi

        if [ -n "$conn_ssid" ] && [ "$conn_ssid" != "<hidden>" ]; then
            # Prefer SSID over BSSID for phone hotspots because their BSSID may be randomized
            # and because NM may not have imported the exact BSSID from raw iw scan output.
            if [ -n "$conn_pw" ]; then
                if "${PRIV_CMD[@]}" nmcli --wait 20 device wifi connect "$conn_ssid" password "$conn_pw" ifname "$INTERFACE" 2> "$connect_err"; then
                    rm -f "$connect_err"
                    return 0
                else
                    rc=$?
                fi
            else
                if "${PRIV_CMD[@]}" nmcli --wait 20 device wifi connect "$conn_ssid" ifname "$INTERFACE" 2> "$connect_err"; then
                    rm -f "$connect_err"
                    return 0
                else
                    rc=$?
                fi
            fi
            cat "$connect_err" >&2
            : > "$connect_err"

            if [ -n "$conn_pw" ]; then
                echo "Direct SSID connect failed; trying a new profile without changing existing profiles." >&2
                local auto_uuid="" auto_created=0
                IFS= read -r auto_uuid < /proc/sys/kernel/random/uuid || auto_uuid=""
                if [[ -n "$auto_uuid" ]] && "${PRIV_CMD[@]}" nmcli connection add type wifi ifname "$INTERFACE" con-name "netmgr-${conn_ssid}-${auto_uuid}" connection.uuid "$auto_uuid" connection.autoconnect no ssid "$conn_ssid" > /dev/null 2> "$connect_err"; then
                    auto_created=1
                fi
                if [[ "$auto_created" -eq 1 ]] &&
                    "${PRIV_CMD[@]}" nmcli connection modify uuid "$auto_uuid" wifi-sec.key-mgmt wpa-psk wifi-sec.psk "$conn_pw" > /dev/null 2>> "$connect_err" &&
                    "${PRIV_CMD[@]}" nmcli --wait 20 connection up uuid "$auto_uuid" ifname "$INTERFACE" 2>> "$connect_err"; then
                    rm -f "$connect_err"
                    return 0
                else
                    rc=$?
                fi
                [[ "$auto_created" -eq 0 ]] || "${PRIV_CMD[@]}" nmcli connection delete uuid "$auto_uuid" > /dev/null 2>&1 || true
                cat "$connect_err" >&2
                : > "$connect_err"
            fi

            echo "SSID/profile connect failed; trying exact BSSID as a final fallback." >&2
        fi

        if [ -n "$conn_bssid" ]; then
            if [ -n "$conn_pw" ]; then
                "${PRIV_CMD[@]}" nmcli --wait 20 device wifi connect "$conn_bssid" password "$conn_pw" ifname "$INTERFACE" 2> "$connect_err"
            else
                "${PRIV_CMD[@]}" nmcli --wait 20 device wifi connect "$conn_bssid" ifname "$INTERFACE" 2> "$connect_err"
            fi
            rc=$?
        fi

        if [ "$rc" -ne 0 ]; then
            if [ -n "$nm_rescan_err" ]; then
                echo "NetworkManager directed rescan output:" >&2
                echo "$nm_rescan_err" >&2
            fi
            cat "$connect_err" >&2
        fi
        rm -f "$connect_err"
        return "$rc"
    }

    render_active_frame() {
        local body_rows="$1"
        local note="$2"
        local cmd_text="$3"
        local err_note="$4"
        local frame_now_ms=""

        frame_now_ms=$(date +%s%3N)
        {
            echo "Active realtime BSSID scan on ${INTERFACE} (iw scan; live refresh after each completed scan)."
            if [ -n "$TARGET_FREQ" ]; then
                echo "Mode: active scan on ${TARGET_FREQ} MHz"
            else
                echo "Mode: active all-channel scan"
            fi
            if [ -n "$TARGET_SSID" ]; then
                echo "Directed SSID probe: ${TARGET_SSID}"
            else
                echo "Directed SSID probe: none"
            fi
            if [ "$finite_mode" -eq 1 ]; then
                remaining_s=$(((end_ms - frame_now_ms + 999) / 1000))
                [ "$remaining_s" -lt 0 ] && remaining_s=0
                echo "Time remaining: ${remaining_s}s (press c to connect, q or Ctrl+C to stop)"
            else
                echo "Running continuously (press c to connect, q or Ctrl+C to stop)"
            fi
            echo "--------------------------------------------------------------------------------"
            if [ -n "$cmd_text" ]; then
                echo "Command: $cmd_text"
            fi
            if [ -n "$scan_kind" ]; then
                echo "Scan stage: $scan_kind"
            fi
            if [ -n "$stage_c_freq_string" ] && [ -z "$TARGET_FREQ" ]; then
                echo "Stage C freqs: $stage_c_freq_string"
            fi
            if [ -n "$note" ]; then
                echo "$note"
            fi
            if [ -n "$err_note" ]; then
                echo "iw scan stderr: $err_note"
            fi
            if [ -n "$last_table_rows" ] && [ "$body_rows" = "$last_table_rows" ] && [ "$last_good_ms" -gt 0 ]; then
                last_good_age=$((frame_now_ms - last_good_ms))
                if [ "$last_good_age" -lt 0 ]; then
                    last_good_age=0
                fi
                echo "Display: keeping last successful table (${last_good_age} ms old)"
            fi
            echo "--------------------------------------------------------------------------------"
            if [ -n "$body_rows" ]; then
                {
                    printf "BSSID\tSSID\tChannel\tFreq_MHz\tBand\tLastSeen\tSignal_pct\tRSSI_dBm\n"
                    printf "%s\n" "$body_rows" | awk -F'\t' 'BEGIN{OFS="\t"} {s=$2; if (length(s) > 48) s=substr(s,1,45) "..."; print $1,s,$3,$4,$5,$6,$7,$8}'
                } | column -t -s $'\t'
            else
                echo "No APs returned yet."
            fi
            echo "--------------------------------------------------------------------------------"
        } > "$frame_file"

        if [ "$ui_use_tty" -eq 1 ] && command -v tput > /dev/null 2>&1; then
            tput cup 0 0 1>&"$render_fd" 2> /dev/null || printf "\033[H" 1>&"$render_fd"
            tput ed 1>&"$render_fd" 2> /dev/null || printf "\033[2J" 1>&"$render_fd"
        else
            printf "\033[H\033[2J" 1>&"$render_fd"
        fi
        cat "$frame_file" 1>&"$render_fd"
    }

    log_ok "Starting active realtime BSSID scan on ${INTERFACE}."
    if [ -n "$TARGET_FREQ" ]; then
        log_ok "Active scan frequency filter: ${TARGET_FREQ} MHz."
    fi
    if [ -n "$TARGET_SSID" ]; then
        log_ok "Active directed SSID probe: ${TARGET_SSID}"
    fi

    if [ -n "${NETMGR_ACTIVE_STAGE_C_FREQS:-}" ]; then
        # shellcheck disable=SC2206
        stage_c_freqs=(${NETMGR_ACTIVE_STAGE_C_FREQS})
    else
        stage_c_freqs=(
            5975
            2437 2412 2452 2462
            6055 6135 6215 6295 6375
            5180 5200 5220 5240
            5745 5765 5785 5805
        )
    fi
    stage_c_freq_string="${stage_c_freqs[*]}"

    if ! [[ "$full_scan_every" =~ ^[0-9]+$ ]] || [ "$full_scan_every" -lt 1 ]; then
        full_scan_every=6
    fi
    if ! [[ "$max_probe_ssids" =~ ^[0-9]+$ ]] || [ "$max_probe_ssids" -lt 0 ]; then
        max_probe_ssids=4
    fi
    load_known_probe_ssids

    if [ -z "$TARGET_FREQ" ]; then
        log_ok "Active realtime will scan Stage C common frequencies first: ${stage_c_freqs[*]}"
        log_ok "Full all-channel fallback: every ${full_scan_every} successful loop(s)."
        if [ "${#known_probe_ssids[@]}" -gt 0 ]; then
            log_ok "Directed probe SSIDs in Stage C: ${known_probe_ssids[*]}"
        fi
    fi

    start_ms=$(date +%s%3N)
    if [ "$finite_mode" -eq 1 ]; then
        end_ms=$((start_ms + (DURATION * 1000)))
    else
        end_ms=0
    fi
    trap 'scan_interrupted=1' INT TERM

    if [ -t 1 ]; then
        ui_use_tty=1
    elif [ -w /dev/tty ]; then
        exec {render_fd}> /dev/tty
        ui_use_tty=1
    fi
    if [ "$ui_use_tty" -eq 1 ] && command -v tput > /dev/null 2>&1; then
        if tput smcup 1>&"$render_fd" 2> /dev/null; then
            ui_alt_screen_active=1
        else
            printf "\033[?1049h" 1>&"$render_fd"
            ui_alt_screen_active=1
        fi
    elif [ "$ui_use_tty" -eq 1 ]; then
        printf "\033[?1049h" 1>&"$render_fd"
        ui_alt_screen_active=1
    fi

    last_table_rows=$(seed_link_row)
    if [ -n "$last_table_rows" ]; then
        last_good_ms=$(date +%s%3N)
        render_active_frame "$last_table_rows" "Seeded current associated BSSID instantly from iw link; starting first scan in the background loop." "" ""
    else
        render_active_frame "" "Starting first scan; the first all-channel scan can take a few seconds." "" ""
    fi

    while :; do
        now_ms=$(date +%s%3N)
        : > "$scan_err"
        scan_cycle=$((scan_cycle + 1))
        scan_cmd=(iw dev "$INTERFACE" scan)
        scan_kind=""
        if [ -n "$TARGET_FREQ" ]; then
            scan_cmd+=(freq "$TARGET_FREQ")
            scan_kind="pinned frequency ${TARGET_FREQ} MHz"
        else
            if [ "$full_scan_every" -gt 0 ] && [ $((scan_cycle % full_scan_every)) -eq 0 ]; then
                scan_kind="full all-channel fallback"
            else
                scan_cmd+=(freq "${stage_c_freqs[@]}")
                scan_kind="Stage C common-frequency scan"
            fi
        fi
        if [ -n "$TARGET_SSID" ]; then
            scan_cmd+=(ssid "$TARGET_SSID")
        elif [ -z "$TARGET_FREQ" ] && [ "${#known_probe_ssids[@]}" -gt 0 ]; then
            ssid_count=0
            for known_ssid in "${known_probe_ssids[@]}"; do
                [ -z "$known_ssid" ] && continue
                scan_cmd+=(ssid "$known_ssid")
                ssid_count=$((ssid_count + 1))
                if [ "$max_probe_ssids" -gt 0 ] && [ "$ssid_count" -ge "$max_probe_ssids" ]; then
                    break
                fi
            done
        fi

        scan_out=$("${PRIV_CMD[@]}" "${scan_cmd[@]}" 2> "$scan_err" || true)
        err_text=$(tr '\n' ' ' < "$scan_err" | cut -c1-220)
        parsed_rows=$(printf "%s\n" "$scan_out" | awk '
            function freq_num(f) { return (f ~ /^[0-9]+(\.[0-9]+)?$/) ? int(f + 0.5) : 0 }
            function infer_band(f,    n) {
                n = freq_num(f)
                if (n >= 2400 && n < 2500) return "2.4GHz"
                if (n >= 4900 && n < 5950) return "5GHz"
                if (n >= 5950 && n <= 7125) return "6GHz"
                return "?"
            }
            function infer_channel(f, c,    n) {
                if (c != "?" && c != "") return c
                n = freq_num(f)
                if (n == 2484) return 14
                if (n >= 2412 && n <= 2472) return int((n - 2407) / 5)
                if (n >= 5000 && n < 5950) return int((n - 5000) / 5)
                if (n >= 5955 && n <= 7115) return int((n - 5950) / 5)
                return "?"
            }
            function hexval(h,    digits, hi, lo) {
                digits = "0123456789abcdef"
                h = tolower(h)
                hi = index(digits, substr(h, 1, 1)) - 1
                lo = index(digits, substr(h, 2, 1)) - 1
                if (hi < 0 || lo < 0) return -1
                return hi * 16 + lo
            }
            function append_codepoint(out, cp) {
                if (cp <= 0) return out
                return out sprintf("%c", cp)
            }
            function flush_utf8(out, bytes, n,    j, b1, b2, b3, b4, cp) {
                j = 1
                while (j <= n) {
                    b1 = bytes[j]
                    if (b1 < 128) {
                        cp = b1
                        j += 1
                    } else if (b1 >= 194 && b1 <= 223 && j + 1 <= n) {
                        b2 = bytes[j + 1]
                        cp = (b1 % 32) * 64 + (b2 % 64)
                        j += 2
                    } else if (b1 >= 224 && b1 <= 239 && j + 2 <= n) {
                        b2 = bytes[j + 1]
                        b3 = bytes[j + 2]
                        cp = (b1 % 16) * 4096 + (b2 % 64) * 64 + (b3 % 64)
                        j += 3
                    } else if (b1 >= 240 && b1 <= 244 && j + 3 <= n) {
                        b2 = bytes[j + 1]
                        b3 = bytes[j + 2]
                        b4 = bytes[j + 3]
                        cp = (b1 % 8) * 262144 + (b2 % 64) * 4096 + (b3 % 64) * 64 + (b4 % 64)
                        j += 4
                    } else {
                        # Malformed UTF-8 byte sequence. Preserve something printable instead of producing mojibake.
                        cp = 65533
                        j += 1
                    }
                    out = append_codepoint(out, cp)
                }
                return out
            }
            function decode_iw_ssid(s,    out, i, hx, v, bytes, n) {
                out = ""
                i = 1
                n = 0
                while (i <= length(s)) {
                    if (substr(s, i, 2) == "\\x" && substr(s, i + 2, 2) ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/) {
                        hx = substr(s, i + 2, 2)
                        v = hexval(hx)
                        if (v >= 0) {
                            n++
                            bytes[n] = v
                        }
                        i += 4
                    } else {
                        if (n > 0) {
                            out = flush_utf8(out, bytes, n)
                            delete bytes
                            n = 0
                        }
                        out = out substr(s, i, 1)
                        i++
                    }
                }
                if (n > 0) out = flush_utf8(out, bytes, n)
                return out
            }
            function emit() {
                if (b == "") return
                if (ssid == "") ssid = "<hidden>"
                # Keep the iw escaped SSID representation here. Bash decodes it after awk so UTF-8 bytes
                # such as \xe7\xba\xa2 become the correct terminal string instead of awk/mawk mojibake.
                band = infer_band(freq)
                out_chan = infer_channel(freq, chan)
                sigpct = 0
                if (signal ~ /^-?[0-9]+$/) {
                    sigpct = int((signal + 100) * 2)
                    if (sigpct < 0) sigpct = 0
                    if (sigpct > 100) sigpct = 100
                }
                gsub(/[\t\r\n[:cntrl:]]+/, " ", ssid)
                printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n", toupper(b), ssid, out_chan, freq, band, lastseen, sigpct, signal
            }
            BEGIN { b=""; ssid=""; freq="?"; chan="?"; signal="N/A"; lastseen="?" }
            /^BSS[[:space:]]/ {
                emit()
                b=$2
                sub(/\(.*/, "", b)
                ssid=""; freq="?"; chan="?"; signal="N/A"; lastseen="?"
                next
            }
            /^[[:space:]]*freq:/ { freq=$2; next }
            /^[[:space:]]*signal:/ { signal=int($2); next }
            /^[[:space:]]*SSID:/ { ssid=$0; sub(/^[[:space:]]*SSID:[[:space:]]*/, "", ssid); next }
            /^[[:space:]]*DS Parameter set:[[:space:]]*channel/ { chan=$NF; next }
            /^[[:space:]]*primary channel:/ { chan=$3; next }
            /^[[:space:]]*last seen:/ { lastseen=$3 "ms"; next }
            END { emit() }
        ' | while IFS=$'\t' read -r row_bssid row_ssid row_chan row_freq row_band row_lastseen row_sigpct row_signal; do
            [ -z "$row_bssid" ] && continue
            if [ "$row_ssid" != "<hidden>" ]; then
                # iw prints non-ASCII SSIDs as C-style byte escapes. Decode them in bash because
                # awk implementations commonly turn each byte into mojibake Unicode codepoints.
                row_ssid=$(printf '%b' "$row_ssid" | tr '\t\r\n' '   ')
            fi
            printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n" "$row_bssid" "$row_ssid" "$row_chan" "$row_freq" "$row_band" "$row_lastseen" "$row_sigpct" "$row_signal"
        done | sort -t $'\t' -k8,8nr -k1,1V)

        scan_status=""
        table_rows="$parsed_rows"
        if [ -n "$parsed_rows" ]; then
            last_table_rows="$parsed_rows"
            last_good_ms="$now_ms"
            if [ -n "$err_text" ]; then
                scan_status="Scan returned APs with a warning."
            else
                scan_status="Scan completed."
            fi
        elif grep -qi 'Device or resource busy\|resource busy\|temporarily unavailable' "$scan_err" 2> /dev/null; then
            scan_status="Raw iw scan is temporarily busy; this is common while associated/connected."
            if [ -n "$last_table_rows" ]; then
                table_rows="$last_table_rows"
            fi
        elif [ -n "$err_text" ]; then
            scan_status="Scan returned no APs."
            if [ -n "$last_table_rows" ]; then
                table_rows="$last_table_rows"
            fi
        else
            scan_status="Scan completed but returned no APs."
            if [ -n "$last_table_rows" ]; then
                table_rows="$last_table_rows"
            fi
        fi

        render_active_frame "$table_rows" "$scan_status" "${PRIV_CMD[*]} ${scan_cmd[*]}" "$err_text"

        if [ "$scan_interrupted" -eq 1 ] || { [ "$finite_mode" -eq 1 ] && [ "$now_ms" -ge "$end_ms" ]; }; then
            break
        fi
        if read -r -t 0.10 -n 1 key; then
            if [[ "$key" == "c" || "$key" == "C" ]]; then
                local -a bssids=()
                local -a ssids=()
                local -a channels=()
                local -a freqs=()
                local -a signals=()
                local -a bands=()
                while IFS=$'\t' read -r b s c f band _lastseen p _r; do
                    [ -z "$b" ] && continue
                    bssids+=("$b")
                    ssids+=("$s")
                    channels+=("$c")
                    freqs+=("$f")
                    bands+=("$band")
                    signals+=("$p")
                done < <(printf "%s\n" "$table_rows")

                if [ "${#bssids[@]}" -eq 0 ]; then
                    render_active_frame "$table_rows" "No networks available to connect to yet." "${PRIV_CMD[*]} ${scan_cmd[*]}" ""
                    sleep 1
                    continue
                fi

                printf "\033[H\033[2J" 1>&"$render_fd"
                echo "Discovered Wi-Fi Networks:" 1>&"$render_fd"
                echo "--------------------------------------------------------------------------------" 1>&"$render_fd"
                printf "  %-3s  %-18s  %-30s  %-8s  %-8s  %-6s  %-6s\n" "Num" "BSSID" "SSID" "Band" "Freq" "Chan" "Signal" 1>&"$render_fd"
                echo "--------------------------------------------------------------------------------" 1>&"$render_fd"
                for i in "${!bssids[@]}"; do
                    display_ssid="${ssids[$i]}"
                    if [ "${#display_ssid}" -gt 30 ]; then
                        display_ssid="${display_ssid:0:27}..."
                    fi
                    printf "  %-3s  %-18s  %-30s  %-8s  %-8s  %-6s  %-6s%%\n" "$((i + 1))" "${bssids[$i]}" "$display_ssid" "${bands[$i]}" "${freqs[$i]}" "${channels[$i]}" "${signals[$i]}" 1>&"$render_fd"
                done
                echo "--------------------------------------------------------------------------------" 1>&"$render_fd"
                echo "" 1>&"$render_fd"
                read -r -p "Enter number to connect (1-${#bssids[@]}), or Enter to cancel: " choice
                if [ -n "$choice" ] && [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#bssids[@]}" ]; then
                    selected_idx=$((choice - 1))
                    selected_bssid="${bssids[$selected_idx]}"
                    selected_ssid="${ssids[$selected_idx]}"
                    selected_freq="${freqs[$selected_idx]}"
                    selected_profile=$(find_wifi_connection_for_ssid "$selected_ssid" || true)
                    if [ -n "$selected_profile" ]; then
                        read -r -s -p "Enter Wi-Fi password for ${selected_ssid} (leave empty to use saved profile '${selected_profile}'): " wifi_pw
                    else
                        read -r -s -p "Enter Wi-Fi password for ${selected_ssid} (leave empty if open/saved): " wifi_pw
                    fi
                    echo ""
                    active_cleanup
                    echo "Connecting to ${selected_ssid} (${selected_bssid}, ${selected_freq} MHz)..."
                    if connect_selected_active_bssid "$selected_bssid" "$selected_ssid" "$selected_freq" "$wifi_pw"; then
                        exit 0
                    else
                        rc=$?
                        echo "Error: failed to connect to ${selected_ssid} (${selected_bssid})." >&2
                        exit "$rc"
                    fi
                fi
            elif [[ "$key" == "q" || "$key" == "Q" ]]; then
                break
            fi
        fi

        if [ -n "$TARGET_FREQ" ] || [ -n "$TARGET_SSID" ]; then
            loop_sleep_default="0.20"
        elif [ "$scan_kind" = "full all-channel fallback" ]; then
            loop_sleep_default="0.80"
        else
            # Stage C scans are restricted to common/high-value frequencies, so retry them faster than a full scan.
            loop_sleep_default="0.25"
        fi
        if grep -qi 'Device or resource busy\|resource busy\|temporarily unavailable' "$scan_err" 2> /dev/null; then
            loop_sleep="${NETMGR_ACTIVE_SCAN_BUSY_DELAY:-1.20}"
        else
            loop_sleep="${NETMGR_ACTIVE_SCAN_DELAY:-$loop_sleep_default}"
        fi
        sleep "$loop_sleep"
    done

    trap - INT TERM
    active_cleanup
    if [ "$render_fd" -ne 1 ]; then
        exec {render_fd}>&-
    fi
    echo ""
    if [ "$scan_interrupted" -eq 1 ]; then
        return 130
    fi
    return 0
}

bssid_scan() {
    local INTERFACE=""
    local DURATION_ARG=""
    local REALTIME=0
    local TARGET_CHAN=""
    local TARGET_FREQ=""
    local TARGET_SSID=""
    local ACTIVE_SCAN=0
    local PASSIVE_MONITOR=0
    local arg=""
    local DURATION=0
    local duration_label="forever"
    local finite_mode=0
    local start_ms=0
    local now_ms=0
    local end_ms=0
    local remaining_s=0
    local next_rescan_ms=0
    local rescan_interval_ms=4000
    local scan_interrupted=0
    local table_rows=""

    while [ $# -gt 0 ]; do
        arg="$1"
        case "$arg" in
            --realtime)
                REALTIME=1
                ;;
            --active)
                ACTIVE_SCAN=1
                ;;
            --passive | --monitor | --passive-monitor)
                PASSIVE_MONITOR=1
                ;;
            --ssid)
                shift
                if [ -z "${1:-}" ]; then
                    echo "Error: --ssid requires a value."
                    echo "Usage: netmgr bssid-scan [interface] [seconds] [--realtime] [--active|--passive] [--ssid <ssid>] [--channel <n>] [--freq <mhz>]"
                    return 1
                fi
                TARGET_SSID="$1"
                ACTIVE_SCAN=1
                ;;
            --channel)
                shift
                if [ -z "${1:-}" ]; then
                    echo "Error: --channel requires a value."
                    echo "Usage: netmgr bssid-scan [interface] [seconds] [--realtime] [--channel <n>] [--freq <mhz>]"
                    return 1
                fi
                TARGET_CHAN="$1"
                ;;
            --freq)
                shift
                if [ -z "${1:-}" ]; then
                    echo "Error: --freq requires a value."
                    echo "Usage: netmgr bssid-scan [interface] [seconds] [--realtime] [--channel <n>] [--freq <mhz>]"
                    return 1
                fi
                TARGET_FREQ="$1"
                ;;
            *)
                if [[ "$arg" =~ ^(en|eth|wl|v|do|lo)[0-9a-z]*$ ]]; then
                    INTERFACE="$arg"
                elif [[ "$arg" =~ ^[0-9]+$ ]] && [ -z "$DURATION_ARG" ]; then
                    DURATION_ARG="$arg"
                fi
                ;;
        esac
        shift
    done

    if [ -z "$INTERFACE" ]; then
        INTERFACE=$(iw dev 2> /dev/null | awk '/Interface/ {print $2; exit}')
    fi
    if [ -z "$INTERFACE" ]; then
        INTERFACE=$(nmcli -t -f DEVICE,TYPE device status 2> /dev/null | awk -F: '$2=="wifi" {print $1; exit}')
    fi
    if [ -z "$INTERFACE" ]; then
        echo "Error: could not auto-detect Wi-Fi interface. Pass it explicitly, e.g. netmgr bssid-scan wlan0 --realtime --freq 5975"
        return 1
    fi

    # A fixed channel is a monitor-mode concept unless the caller also supplies
    # a frequency. Keep explicit --channel behaviour compatible with old netmgr.
    if [ -n "$TARGET_CHAN" ] && [ -z "$TARGET_FREQ" ] && [ "$ACTIVE_SCAN" -eq 0 ]; then
        PASSIVE_MONITOR=1
    fi

    if [ "$REALTIME" -eq 1 ]; then
        # Default realtime mode is now active scanning, because passive monitor-mode
        # hopping is not reliable on all MediaTek/6 GHz setups. Use --passive,
        # --monitor, or --passive-monitor for the old tshark/mon0 RF-sniffing mode.
        if [ "$PASSIVE_MONITOR" -eq 0 ]; then
            bssid_scan_active_realtime "$INTERFACE" "$DURATION_ARG" "$TARGET_FREQ" "$TARGET_SSID"
            return $?
        fi
        bssid_scan_realtime "$INTERFACE" "$DURATION_ARG" "$TARGET_CHAN" "$TARGET_FREQ"
        return $?
    fi

    if [ -n "$TARGET_FREQ" ]; then
        echo "Error: --freq is only supported with --realtime."
        return 1
    fi

    if [ -n "$DURATION_ARG" ]; then
        if ! [[ "$DURATION_ARG" =~ ^[0-9]+$ ]] || [ "$DURATION_ARG" -le 0 ]; then
            echo "Error: duration must be a positive integer (seconds)."
            echo "Usage: netmgr bssid-scan [interface] [seconds] [--realtime] [--channel <n>] [--freq <mhz>]"
            return 1
        fi
        DURATION="$DURATION_ARG"
        duration_label="${DURATION}s"
        finite_mode=1
    fi

    if ! command -v nmcli > /dev/null 2>&1; then
        echo "Error: nmcli is required for bssid-scan."
        return 1
    fi

    if ! ip link show "$INTERFACE" > /dev/null 2>&1; then
        echo "Error: interface not found: $INTERFACE"
        return 1
    fi

    start_ms=$(date +%s%3N)
    if [ "$finite_mode" -eq 1 ]; then
        end_ms=$((start_ms + (DURATION * 1000)))
    else
        end_ms=0
    fi
    next_rescan_ms="$start_ms"
    trap 'scan_interrupted=1' INT TERM

    while :; do
        stty sane 2> /dev/null || true
        now_ms=$(date +%s%3N)
        if [ "$now_ms" -ge "$next_rescan_ms" ]; then
            nmcli dev wifi rescan ifname "$INTERFACE" > /dev/null 2>&1 || true
            next_rescan_ms=$((now_ms + rescan_interval_ms))
        fi

        table_rows=$(nmcli -e no -t -f BSSID,CHAN,FREQ,SIGNAL,SSID dev wifi list --rescan no ifname "$INTERFACE" 2> /dev/null | awk -F: '
        function normalize_mac(m, a, i, out) {
            gsub(/-/, ":", m)
            m = tolower(m)
            n = split(m, a, ":")
            if (n != 6) return ""
            out = ""
            for (i = 1; i <= 6; i++) {
                if (a[i] !~ /^[0-9a-f]{1,2}$/) return ""
                if (length(a[i]) == 1) a[i] = "0" a[i]
                out = out ((i == 1) ? "" : ":") a[i]
            }
            return out
        }
        function band_for_freq(f, c) {
            if (f ~ /^[0-9]+$/) {
                if ((f + 0) >= 2400 && (f + 0) < 2500) return "2.4GHz"
                if ((f + 0) >= 4900 && (f + 0) < 5950) return "5GHz"
                if ((f + 0) >= 5950 && (f + 0) <= 7125) return "6GHz"
            }
            if (c ~ /^[0-9]+$/ && (c + 0) >= 1 && (c + 0) <= 14) return "2.4GHz"
            if (c ~ /^[0-9]+$/) return "5GHz"
            return "?"
        }
        {
            b = normalize_mac($1 ":" $2 ":" $3 ":" $4 ":" $5 ":" $6)
            if (b == "") next

            c = $7
            f = $8
            fnum = f
            gsub(/[^0-9]/, "", fnum)
            sig_raw = $9
            s = ""
            if (NF >= 10) {
                s = $10
                for (i = 11; i <= NF; i++) s = s ":" $i
            }
            if (s == "") s = "<hidden>"
            sig_ok = (sig_raw ~ /^[0-9]+$/)
            sig = sig_ok ? sig_raw + 0 : -1

            seen[b]++
            if (!(b in has_init)) {
                has_init[b] = 1
                ssid[b] = s
                chan[b] = (c == "" ? "?" : c)
                freq[b] = (fnum == "" ? "?" : fnum)
                has_sig[b] = sig_ok ? 1 : 0
                best_sig[b] = sig
            } else {
                if (ssid[b] == "<hidden>" && s != "<hidden>") ssid[b] = s
                if (chan[b] == "?" && c != "") chan[b] = c
                if ((freq[b] == "" || freq[b] == "?") && fnum != "") freq[b] = fnum
                if (sig_ok && (!has_sig[b] || sig > best_sig[b])) {
                    has_sig[b] = 1
                    best_sig[b] = sig
                }
            }
        }
        END {
            for (b in seen) {
                gsub(/ /, "_", ssid[b])
                sig_disp = has_sig[b] ? best_sig[b] : "N/A"
                rssi_disp = has_sig[b] ? int((best_sig[b] / 2) - 100) : "N/A"
                band_disp = band_for_freq(freq[b], chan[b])
                freq_disp = (freq[b] == "" ? "?" : freq[b])
                sig_sort = has_sig[b] ? best_sig[b] : -1
                printf "%s\t%s\t%s\t%s\t%s\t%s\t%s\t%d\n", toupper(b), ssid[b], chan[b], freq_disp, band_disp, sig_disp, rssi_disp, sig_sort
            }
        }
    ' | sort -t $'\t' -k8,8nr -k1,1V | awk -F'\t' 'BEGIN{OFS="\t"} {print $1,$2,$3,$4,$5,$6,$7}')

        printf "\033[H\033[2J"
        echo "Scanning BSSIDs in managed mode on ${INTERFACE} for ${duration_label} (live refresh 0.5s)..."
        if [ "$finite_mode" -eq 1 ]; then
            remaining_s=$(((end_ms - now_ms + 999) / 1000))
            if [ "$remaining_s" -lt 0 ]; then
                remaining_s=0
            fi
            echo "Time remaining: ${remaining_s}s (Press 'c' to connect, 'q' or Ctrl+C to stop)"
        else
            echo "Running continuously (Press 'c' to connect, 'q' or Ctrl+C to stop)"
        fi
        echo "--------------------------------------------------------------------------------"
        if [ -n "$table_rows" ]; then
            {
                printf "BSSID\tSSID\tChannel\tFreq_MHz\tBand\tSignal_pct\tRSSI_dBm\n"
                printf "%s\n" "$table_rows"
            } | column -t -s $'\t' | sed 's/_/ /g'
        else
            echo "No BSSIDs currently visible."
        fi
        echo "--------------------------------------------------------------------------------"

        if [ "$scan_interrupted" -eq 1 ] || { [ "$finite_mode" -eq 1 ] && [ "$now_ms" -ge "$end_ms" ]; }; then
            break
        fi

        if read -r -t 0.5 -n 1 key; then
            if [[ "$key" == "c" || "$key" == "C" ]]; then
                local -a bssids=()
                local -a ssids=()
                local -a channels=()
                local -a signals=()
                local -a bands=()
                while IFS=$'\t' read -r b s c f band p _r; do
                    [ -z "$b" ] && continue
                    bssids+=("$b")
                    ssids+=("$s")
                    channels+=("$c")
                    signals+=("$p")
                    bands+=("$band")
                done < <(printf "%s\n" "$table_rows" | sed 's/_/ /g')

                if [ "${#bssids[@]}" -eq 0 ]; then
                    echo "No networks available."
                    sleep 1
                    continue
                fi

                printf "\033[H\033[2J"
                echo "Discovered Wi-Fi Networks:"
                echo "--------------------------------------------------------------------------------"
                printf "  %-3s  %-18s  %-30s  %-8s  %-6s  %-6s\n" "Num" "BSSID" "SSID" "Band" "Chan" "Signal"
                echo "--------------------------------------------------------------------------------"
                for i in "${!bssids[@]}"; do
                    printf "  %-3s  %-18s  %-30s  %-8s  %-6s  %-6s%%\n" "$((i + 1))" "${bssids[$i]}" "${ssids[$i]}" "${bands[$i]}" "${channels[$i]}" "${signals[$i]}"
                done
                echo "--------------------------------------------------------------------------------"
                echo ""
                read -r -p "Enter number to connect (1-${#bssids[@]}), or Enter to cancel: " choice
                if [ -n "$choice" ] && [[ "$choice" =~ ^[0-9]+$ ]] && [ "$choice" -ge 1 ] && [ "$choice" -le "${#bssids[@]}" ]; then
                    local selected_idx=$((choice - 1))
                    local selected_bssid="${bssids[$selected_idx]}"
                    local selected_ssid="${ssids[$selected_idx]}"
                    read -r -s -p "Enter Wi-Fi password for ${selected_ssid} (leave empty if open/saved): " wifi_pw
                    echo ""
                    echo "Connecting to ${selected_ssid} (${selected_bssid})...."
                    connect_wifi_bssid "$INTERFACE" "$selected_bssid" "$wifi_pw"
                    exit "$?"
                fi
            elif [[ "$key" == "q" || "$key" == "Q" ]]; then
                break
            fi
        fi
    done

    trap - INT TERM
    echo ""
    if [ "$scan_interrupted" -eq 1 ]; then
        return 130
    fi
}

# Capture branches have separate pipeline subshells; dedupe/hint state stays in each loop.
# shellcheck disable=SC2030,SC2031
listen_subnet() {
    local INTERFACE="wlp8s0"
    local MODE="managed"
    local DEDUPE=0
