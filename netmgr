    if [ "$MODE" = "monitor" ] && [ -n "$BSSID" ] && [ -z "$TARGET_CHAN" ]; then
        bssid_channel=$("${PRIV_CMD[@]}" iw dev "$INTERFACE" scan ap-force 2> /dev/null | awk -v b="$bssid_lc" '
            BEGIN { in_bss = 0 }
            /^BSS / {
