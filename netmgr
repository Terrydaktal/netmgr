                printf "Time       MAC_Address         IP_Address                               Vendor                         Protocol_Stack\n"
                echo "--------------------------------------------------------------------------------"
            fi

            sniff_cmd=("${PRIV_CMD[@]}" tshark -l -n -i "$INTERFACE" -T fields -E separator='|' -E occurrence=f -e eth.src -e ip.src -e ipv6.src -e frame.protocols -e tcp.srcport -e tcp.dstport -e udp.srcport -e udp.dstport -e eth.type -e _ws.col.Protocol)

            "${sniff_cmd[@]}" \
                2> >(while IFS= read -r tshark_msg; do
