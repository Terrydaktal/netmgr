            bssid_channel=$(nmcli -e no -t -f BSSID,CHAN dev wifi list ifname "$INTERFACE" 2> /dev/null | awk -F: -v b="$BSSID" '
                {
                    mac = $1 ":" $2 ":" $3 ":" $4 ":" $5 ":" $6
                    chan = $NF
                    if (toupper(mac) == b && chan ~ /^[0-9]+$/) {
                        print chan
                        exit
