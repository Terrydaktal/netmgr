#!/bin/bash

# netmgr - Network management tool
# Mimics diskpart style interactive shell and subcommands

MAC_IP_DB="${NETMGR_MAC_IP_DB:-$HOME/.local/share/netmgr/mac_ip_map.tsv}"

# Helper to convert IP range (8.8.8.0 - 8.8.8.255) to CIDR suffix (/24)
range_to_suffix() {
    local range="$1"
    if [[ "$range" != *" - "* ]]; then
        if [[ "$range" == *"/"* ]]; then echo "/${range#*/}"; else echo ""; fi
        return
    fi

    local start_ip=$(echo "$range" | awk -F' - ' '{print $1}' | xargs)
    local end_ip=$(echo "$range" | awk -F' - ' '{print $2}' | xargs)

    IFS='.' read -r a b c d <<< "$start_ip"
    local start_int=$(( (a << 24) + (b << 16) + (c << 8) + d ))
    IFS='.' read -r a b c d <<< "$end_ip"
    local end_int=$(( (a << 24) + (b << 16) + (c << 8) + d ))

    local diff=$(( end_int - start_int ))
    local bits=0
    while [ $(( 2**bits - 1 )) -lt $diff ]; do
        ((bits++))
    done
    
    echo "/$(( 32 - bits ))"
}

# Helper to find correct local CIDR for an IP (using routing table)
get_local_cidr() {
    local ip="$1"
    local cidr=$(ip addr show | grep -w "inet" | awk '{print $2}' | grep -v "127.0.0.1" | while read -r line; do
        if [[ $ip == ${line%.*}.* ]]; then
            echo "$line"
            return
        fi
    done | head -n 1)

    if [ -n "$cidr" ]; then
        echo "/${cidr#*/}"
    else
        if [[ $ip =~ ^192\.168\. ]]; then echo "/24";
        elif [[ $ip =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]]; then echo "/12";
        elif [[ $ip =~ ^10\. ]]; then echo "/8";
        else echo ""; fi
    fi
}

normalize_mac() {
    local raw="$1"
    echo "$raw" | tr '[:upper:]-' '[:lower:]:' | awk -F: '
        NF == 6 {
            for (i = 1; i <= 6; i++) {
                if ($i !~ /^[0-9a-f]{2}$/) {
                    exit 1
                }
            }
            printf "%s:%s:%s:%s:%s:%s\n", $1, $2, $3, $4, $5, $6
        }
    '
}

map_protocol_token() {
    local token="$1"
    case "$token" in
        frame|data|geninfo|ethertype) echo "" ;;
        radiotap|wlan_radio) echo "Radiotap" ;;
        wlan) echo "802.11" ;;
        llc) echo "LLC" ;;
        eth) echo "Ethernet" ;;
        ip) echo "IP" ;;
        ipv6) echo "IPv6" ;;
        arp) echo "ARP" ;;
        tcp) echo "TCP" ;;
        udp) echo "UDP" ;;
        icmp) echo "ICMP" ;;
        icmpv6) echo "ICMPv6" ;;
        bootp|dhcp) echo "DHCP" ;;
        dns) echo "DNS" ;;
        mdns) echo "mDNS" ;;
        ssdp) echo "SSDP" ;;
        tls|ssl) echo "TLS" ;;
        quic) echo "QUIC" ;;
        http|http2|http3) echo "HTTP" ;;
        eapol) echo "EAPOL" ;;
        *)
            echo "$token" | tr '[:lower:]' '[:upper:]'
            ;;
    esac
}

map_ethertype_detail() {
    local eth_type="$1"
    case "$eth_type" in
        0x0800) echo "IP" ;;
        0x86dd) echo "IPv6" ;;
        0x0806) echo "ARP" ;;
        0x888e) echo "EAPOL" ;;
        0x88cc) echo "LLDP" ;;
        0x8809) echo "LACP" ;;
        0x8863) echo "PPPoE-Discovery" ;;
        0x8864) echo "PPPoE-Session" ;;
        "") echo "" ;;
        *)
            echo "$eth_type"
            ;;
    esac
}

format_protocol_stack() {
    local proto_chain="$1"
    local tcp_s="$2"
    local tcp_d="$3"
    local udp_s="$4"
    local udp_d="$5"
    local eth_type="$6"
    local app_proto="$7"
    local stack=""
    local last=""
    local token=""
    local label=""
    local eth_detail=""
    local -a proto_parts

    IFS=':' read -r -a proto_parts <<< "$proto_chain"
    for token in "${proto_parts[@]}"; do
        label=$(map_protocol_token "$token")
        [ -z "$label" ] && continue
        if [ "$label" = "TCP" ] && { [ -n "$tcp_s" ] || [ -n "$tcp_d" ]; }; then
            label="TCP(${tcp_s:-?}->${tcp_d:-?})"
        elif [ "$label" = "UDP" ] && { [ -n "$udp_s" ] || [ -n "$udp_d" ]; }; then
            label="UDP(${udp_s:-?}->${udp_d:-?})"
        fi
        if [ "$label" = "$last" ]; then
            continue
        fi
        if [ -z "$stack" ]; then
            stack="$label"
        else
            stack="${stack}<-${label}"
        fi
        last="$label"
    done

    if [ -n "$app_proto" ]; then
        case "$app_proto" in
            ''|[0-9]*)
                ;;
            "TCP"|"UDP"|"IPv4"|"IPv6"|"Ethernet"|"ARP"|"802.11")
                ;;
            *)
                if [ "$stack" = "Ethernet" ]; then
                    eth_detail="$app_proto"
                elif [ "$app_proto" != "$last" ]; then
                    if [ -z "$stack" ]; then
                        stack="$app_proto"
                    else
                        stack="${stack}<-${app_proto}"
                    fi
                fi
                ;;
        esac
    fi

    if [ "$stack" = "Ethernet" ] && [ -z "$eth_detail" ]; then
        eth_detail=$(map_ethertype_detail "$eth_type")
    fi
    if [ "$stack" = "Ethernet" ] && [ -n "$eth_detail" ]; then
        stack="Ethernet[$eth_detail]"
    fi

    if [ -z "$stack" ]; then
        stack="UNKNOWN"
    fi
    echo "$stack"
}

lookup_vendor() {
    local mac_in="$1"
    local mac=""
    local vendor=""
    local prefix=""
    local mac_db="${NETMGR_MAC_PREFIX_DB:-/usr/share/nmap/nmap-mac-prefixes}"

    mac=$(normalize_mac "$mac_in")
    if [ -z "$mac" ]; then
        echo "Unknown"
        return
    fi

    if [ -n "${VENDOR_CACHE[$mac]+x}" ]; then
        echo "${VENDOR_CACHE[$mac]}"
        return
    fi

    prefix=$(echo "$mac" | tr -d ':' | cut -c1-6 | tr '[:lower:]' '[:upper:]')
    if [ -r "$mac_db" ]; then
        vendor=$(awk -v p="$prefix" '
            toupper($1) == p {
                $1 = ""
                sub(/^[ \t]+/, "", $0)
                print
                exit
            }
        ' "$mac_db")
    fi

    if [ -z "$vendor" ]; then
        vendor=$(curl -s --max-time 2 "https://api.macvendors.com/$mac" | tr -d '\r')
    fi
    if [[ -z "$vendor" || "$vendor" == *"error"* || "$vendor" == *"Too Many Requests"* ]]; then
        vendor="Unknown"
    fi

    VENDOR_CACHE["$mac"]="$vendor"
    echo "$vendor"
}

ensure_mac_ip_db() {
    local db_dir=""
    db_dir=$(dirname "$MAC_IP_DB")
    mkdir -p "$db_dir"
    touch "$MAC_IP_DB"
}

lookup_ip_from_db() {
    local mac_in="$1"
    local mac_norm=""
    local ip_out=""

    mac_norm=$(normalize_mac "$mac_in")
    if [ -z "$mac_norm" ]; then
        echo ""
        return
    fi

    ensure_mac_ip_db
    ip_out=$(awk -F'\t' -v m="$mac_norm" '$1==m {print $2; exit}' "$MAC_IP_DB")
    echo "$ip_out"
}

update_mac_ip_db_from_scan_rows() {
    local rows_file="$1"
    local db_tmp=""

    [ -f "$rows_file" ] || return 0
    ensure_mac_ip_db
    db_tmp=$(mktemp)

    awk -F'\t' '
        BEGIN { OFS="\t" }
        FILENAME == ARGV[1] {
            mac = tolower($1)
            ip = $2
            if (mac ~ /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/ && ip ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) {
                map[mac] = ip
            }
            next
        }
        {
            ip = $1
            mac = tolower($3)
            if (mac ~ /^([0-9a-f]{2}:){5}[0-9a-f]{2}$/ && ip ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) {
                map[mac] = ip
            }
        }
        END {
            for (m in map) {
                print m, map[m]
            }
        }
    ' "$MAC_IP_DB" "$rows_file" | sort -u > "$db_tmp"

    mv "$db_tmp" "$MAC_IP_DB"
}

upsert_mac_ip_db_pair() {
    local ip="$1"
    local mac_in="$2"
    local mac_norm=""
    local one_row_tmp=""

    mac_norm=$(normalize_mac "$mac_in")
    if [ -z "$mac_norm" ]; then
        return 0
    fi
    if [[ ! "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        return 0
    fi

    one_row_tmp=$(mktemp)
    printf "%s\tunknown\t%s\tunknown\tn/a\n" "$ip" "$mac_norm" > "$one_row_tmp"
    update_mac_ip_db_from_scan_rows "$one_row_tmp"
    rm -f "$one_row_tmp"
}

log_ok() {
    printf "\033[1;32m[OK]\033[0m %s\n" "$*"
}

log_err() {
    printf "\033[1;31m[ERR]\033[0m %s\n" "$*"
}

ensure_sudo_session() {
    if [ "$EUID" -eq 0 ]; then
        return 0
    fi
    if sudo -v; then
        return 0
    fi
    echo "Error: sudo authentication failed."
    return 1
}

show_interfaces() {
    local iw_cmd=""
    local ethtool_cmd=""
    local -a ethernet_ifaces=()
    local ifname=""

    if command -v iw >/dev/null 2>&1; then
        iw_cmd=$(command -v iw)
    elif [ -x /usr/sbin/iw ]; then
        iw_cmd="/usr/sbin/iw"
    elif [ -x /sbin/iw ]; then
        iw_cmd="/sbin/iw"
    elif [ -x /usr/bin/iw ]; then
        iw_cmd="/usr/bin/iw"
    elif [ -x /bin/iw ]; then
        iw_cmd="/bin/iw"
    fi
    if command -v ethtool >/dev/null 2>&1; then
        ethtool_cmd=$(command -v ethtool)
    fi
    mapfile -t ethernet_ifaces < <(ip -j link show | jq -r '.[].ifname' | grep -E '^(en|eth)' || true)
    if [ "$EUID" -ne 0 ] && { [ -n "$iw_cmd" ] || [ -n "$ethtool_cmd" ]; }; then
        ensure_sudo_session || return 1
    fi

    echo ""
    echo "Local Network Interfaces:"
    echo "----------------------------------------------------------------------------------------------------------------"
    
    (
        declare -A gateway_map
        while read -r dev gw; do
            if [ -n "$dev" ] && [ -z "${gateway_map[$dev]}" ]; then
                gateway_map["$dev"]="$gw"
            fi
        done < <(
            ip route show default | awk '
                {
                    dev = ""
                    gw = ""
                    for (i = 1; i <= NF; i++) {
                        if ($i == "dev" && (i + 1) <= NF) dev = $(i + 1)
                        if ($i == "via" && (i + 1) <= NF) gw = $(i + 1)
                    }
                    if (dev != "") {
                        if (gw == "") gw = "link"
                        printf "%s %s\n", dev, gw
                    }
                }
            '
        )

        printf "Interface Status IP_Address MAC_Address MTU DHCP Gateway\n"
        ip -j addr show | jq -r '.[] | 
            "\(.ifname) \(.operstate) \((.addr_info[]? | select(.family == "inet") | "\(.local)/\(.prefixlen)") // "N/A") \(.address) \(.mtu) \((.addr_info[]? | select(.family == "inet") | .dynamic) // false)"' | \
        while read -r name state ip mac mtu dynamic; do
            is_dynamic="No"
            gateway="${gateway_map[$name]:-N/A}"
            if [ "$dynamic" == "true" ]; then is_dynamic="Yes"; fi
            if [ "$ip" == "N/A" ]; then is_dynamic="N/A"; fi
            printf "%s %s %s %s %s %s %s\n" "$name" "$state" "$ip" "$mac" "$mtu" "$is_dynamic" "$gateway"
        done
    ) | column -t
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "sudo iw dev"
    echo "----------------------------------------------------------------------------------------------------------------"
    if [ -n "$iw_cmd" ]; then
        if [ "$EUID" -eq 0 ]; then
            "$iw_cmd" dev
        else
            sudo "$iw_cmd" dev
        fi
    else
        echo "iw: command not found"
    fi
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "lspci -knn | grep -iA2 net"
    echo "----------------------------------------------------------------------------------------------------------------"
    if command -v lspci >/dev/null 2>&1; then
        lspci -knn | grep -iA2 net || echo "No PCI network controllers matched."
    else
        echo "lspci: command not found"
    fi
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "ip route show"
    echo "----------------------------------------------------------------------------------------------------------------"
    ip route show
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "sudo ethtool <ethernet interfaces>"
    echo "----------------------------------------------------------------------------------------------------------------"
    if [ -n "$ethtool_cmd" ]; then
        if [ "${#ethernet_ifaces[@]}" -eq 0 ]; then
            echo "No ethernet interfaces detected."
        else
            for ifname in "${ethernet_ifaces[@]}"; do
                echo "-- $ifname --"
                if [ "$EUID" -eq 0 ]; then
                    "$ethtool_cmd" "$ifname"
                else
                    sudo "$ethtool_cmd" "$ifname"
                fi
            done
        fi
    else
        echo "ethtool: command not found"
    fi
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
    echo "ip -s addr"
    echo "----------------------------------------------------------------------------------------------------------------"
    ip -s addr
    echo "----------------------------------------------------------------------------------------------------------------"
    echo ""
}

scan_subnet() {
    local intf_arg=""
    local target_arg=""
    local scan_ports=0
    local resolve_hostnames=0
    local route_probe=""
    local route_intf=""
    local MY_IP=""
    local MY_MAC=""
    local SUBNET=""
    local TARGET=""
    local INTF=""
    local tmp_nmap=""
    local tmp_rows=""
    local tmp_resolved=""
    local tmp_ports_nmap=""
    local tmp_ports_map=""
    local tmp_rows_ports=""
    local tmp_ips=""
    local tmp_event_fifo=""
    local tshark_filter=""
    local nmap_delay="${NETMGR_SCAN_NMAP_DELAY:-2}"
    local scan_interrupted=0
    local nmap_pid=""
    local tshark_pid=""
    local consumer_pid=""
    declare -A VENDOR_CACHE
    declare -A HOSTNAME_CACHE

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --ports)
                scan_ports=1
                ;;
            --resolve-hostnames)
                resolve_hostnames=1
                ;;
            *)
                if [[ $1 =~ ^(en|eth|wl|v|do|lo)[0-9a-z]*$ ]]; then
                    intf_arg="$1"
                elif [[ $1 =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9] ]]; then
                    target_arg="$1"
                fi
                ;;
        esac
        shift
    done

    if [ -n "$intf_arg" ]; then
        INTF="$intf_arg"
    else
        if [ -n "$target_arg" ]; then
            route_probe="$target_arg"
            route_probe=$(echo "$route_probe" | sed -E 's/[[:space:]]*-[[:space:]]*.*$//')
            route_probe="${route_probe%%/*}"
            route_intf=$(ip route get "$route_probe" 2>/dev/null | awk '{for (i = 1; i <= NF; i++) if ($i == "dev") {print $(i + 1); exit}}')
            if [ -n "$route_intf" ]; then
                INTF="$route_intf"
            fi
        fi

        if [ -z "$INTF" ]; then
            INTF=$(ip -j addr show | jq -r '.[] | select(.operstate == "UP") | .ifname' | grep -E '^(en|eth|wl)' | head -n 1)
        fi
        if [ -z "$INTF" ]; then
            INTF=$(ip -j addr show | jq -r '.[] | select(.operstate == "UP") | .ifname' | head -n 1)
        fi
    fi

    if [ -z "$INTF" ]; then
        echo "Error: No active (UP) interface found. Please specify one."
        return 1
    fi

    MY_IP=$(ip addr show "$INTF" | awk '/inet / {print $2}' | cut -d/ -f1 | head -n 1)
    MY_MAC=$(cat "/sys/class/net/$INTF/address" 2>/dev/null)
    SUBNET=$(ip route show dev "$INTF" proto kernel scope link | awk 'NR==1 {print $1}')
    if [ -z "$SUBNET" ]; then
        SUBNET=$(ip addr show "$INTF" | awk '/inet / {print $2}' | head -n 1)
    fi
    TARGET=${target_arg:-$SUBNET}

    if [ -z "$TARGET" ]; then
        echo "Error: Could not detect subnet for interface $INTF. Is it configured with an IP?"
        return 1
    fi

    ensure_sudo_session || return 1
    echo ""
    echo "Using Interface: $INTF ($MY_IP)"
    echo "Scanning Subnet: $TARGET..."
    echo "Streaming discovery continuously (nmap loop + tshark in parallel). Press Ctrl+C to stop."
    echo "-----------------------------------------------------------------------------------------------------------------------------------"
    printf "Time       SRC     IP_Address      MAC_Address         Hostname             Vendor\n"
    echo "-----------------------------------------------------------------------------------------------------------------------------------"

    tmp_nmap=$(mktemp)
    tmp_rows=$(mktemp)
    tmp_resolved=$(mktemp)
    tmp_ports_nmap=$(mktemp)
    tmp_ports_map=$(mktemp)
    tmp_rows_ports=$(mktemp)
    tmp_ips=$(mktemp)
    : > "$tmp_rows"
    tmp_event_fifo=$(mktemp -u)
    mkfifo "$tmp_event_fifo"
    if [[ "$TARGET" == */* ]]; then
        tshark_filter="ip and (src net ${TARGET} or dst net ${TARGET})"
    elif [[ "$TARGET" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
        tshark_filter="ip and (src host ${TARGET} or dst host ${TARGET})"
    else
        tshark_filter="ip"
    fi

    upsert_scan_row() {
        local row_ip="$1"
        local row_host="$2"
        local row_mac="$3"
        local row_vendor="$4"
        local row_ports="$5"
        local row_tmp=""

        [ -z "$row_ip" ] && return 0
        row_host=${row_host:-unknown}
        row_mac=${row_mac:-unknown}
        row_vendor=${row_vendor:-unknown}
        row_ports=${row_ports:-n/a}

        row_tmp=$(mktemp)
        awk -F'\t' -v ip="$row_ip" -v h="$row_host" -v m="$row_mac" -v v="$row_vendor" -v p="$row_ports" '
            BEGIN { OFS="\t"; updated = 0 }
            {
                if ($1 == ip) {
                    if (h != "" && h != "unknown") $2 = h
                    else if ($2 == "") $2 = "unknown"

                    if (m != "" && m != "unknown") $3 = m
                    else if ($3 == "") $3 = "unknown"

                    if (v != "" && v != "unknown") $4 = v
                    else if ($4 == "") $4 = "unknown"

                    if (p != "" && p != "n/a") $5 = p
                    else if ($5 == "") $5 = "n/a"

                    updated = 1
                }
                print
            }
            END {
                if (!updated) {
                    print ip, h, m, v, p
                }
            }
        ' "$tmp_rows" > "$row_tmp"
        mv "$row_tmp" "$tmp_rows"
    }

    resolve_scan_hostname() {
        local ip="$1"
        local resolved=""

        if [[ ! "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
            echo "unknown"
            return
        fi

        if [ -n "${HOSTNAME_CACHE[$ip]+x}" ]; then
            echo "${HOSTNAME_CACHE[$ip]}"
            return
        fi

        if [ "$ip" = "$MY_IP" ]; then
            resolved=$(hostname -s 2>/dev/null | head -n 1)
        fi

        if [ -z "$resolved" ]; then
            resolved=$(timeout 0.3s getent hosts "$ip" 2>/dev/null | awk 'NR==1 {print $2}')
        fi

        [ -z "$resolved" ] && resolved="unknown"
        HOSTNAME_CACHE["$ip"]="$resolved"
        echo "$resolved"
    }

    cleanup_scan_stream() {
        if [ -n "$nmap_pid" ]; then
            kill -TERM "$nmap_pid" >/dev/null 2>&1 || true
            pkill -TERM -P "$nmap_pid" >/dev/null 2>&1 || true
        fi
        if [ -n "$tshark_pid" ]; then
            kill -TERM "$tshark_pid" >/dev/null 2>&1 || true
            pkill -TERM -P "$tshark_pid" >/dev/null 2>&1 || true
        fi
        if [ -n "$consumer_pid" ]; then
            kill -TERM "$consumer_pid" >/dev/null 2>&1 || true
            pkill -TERM -P "$consumer_pid" >/dev/null 2>&1 || true
        fi

        sleep 0.2

        if [ -n "$nmap_pid" ] && kill -0 "$nmap_pid" >/dev/null 2>&1; then
            kill -KILL "$nmap_pid" >/dev/null 2>&1 || true
            pkill -KILL -P "$nmap_pid" >/dev/null 2>&1 || true
        fi
        if [ -n "$tshark_pid" ] && kill -0 "$tshark_pid" >/dev/null 2>&1; then
            kill -KILL "$tshark_pid" >/dev/null 2>&1 || true
            pkill -KILL -P "$tshark_pid" >/dev/null 2>&1 || true
        fi
        if [ -n "$consumer_pid" ] && kill -0 "$consumer_pid" >/dev/null 2>&1; then
            kill -KILL "$consumer_pid" >/dev/null 2>&1 || true
            pkill -KILL -P "$consumer_pid" >/dev/null 2>&1 || true
        fi

        [ -n "$nmap_pid" ] && wait "$nmap_pid" 2>/dev/null || true
        [ -n "$tshark_pid" ] && wait "$tshark_pid" 2>/dev/null || true
        [ -n "$consumer_pid" ] && wait "$consumer_pid" 2>/dev/null || true

        rm -f "$tmp_event_fifo" >/dev/null 2>&1 || true
    }

    trap 'scan_interrupted=1; cleanup_scan_stream' INT TERM

    (
        declare -A streamed_macs
        while IFS=$'\t' read -r src ip host mac vendor rest; do
            local first_octet=""
            local local_mac=""
            [ -n "$rest" ] && continue
            if [ "$src" != "NMAP" ] && [ "$src" != "TSHARK" ]; then
                continue
            fi

            local_mac=$(normalize_mac "$mac")
            [ -z "$host" ] && host="unknown"
            [ -z "$vendor" ] && vendor="unknown"
            if [ -z "$local_mac" ]; then
                continue
            fi
            if [ "$local_mac" = "ff:ff:ff:ff:ff:ff" ]; then
                continue
            fi
            first_octet=${local_mac%%:*}
            if [ $((16#$first_octet & 1)) -eq 1 ]; then
                continue
            fi
            if [ "$vendor" = "unknown" ]; then
                vendor=$(lookup_vendor "$local_mac")
            fi

            if [[ "$ip" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
                if [ "$host" = "unknown" ]; then
                    host=$(resolve_scan_hostname "$ip")
                fi
                upsert_scan_row "$ip" "$host" "$local_mac" "$vendor" "n/a"
                upsert_mac_ip_db_pair "$ip" "$local_mac"
                if [ -z "${streamed_macs[$local_mac]+x}" ]; then
                    streamed_macs["$local_mac"]=1
                    printf "[%s] %-7s %-15s %-18s %-20s %s\n" "$(date +%T)" "$src" "$ip" "$local_mac" "$host" "$vendor"
                fi
            fi
        done < "$tmp_event_fifo"
    ) &
    consumer_pid=$!

    (
        while true; do
            sudo nmap -sn -PS22,80,443 -PA21,23,3389 -PU40125 --max-retries 5 --stats-every 10s -e "$INTF" "$TARGET" 2>/dev/null | awk -v my_ip="$MY_IP" -v my_mac="$MY_MAC" '
                /^Nmap scan report for / {
                    report = $0
                    sub(/^Nmap scan report for /, "", report)
                    current_ip = ""
                    host = "unknown"
                    if (match(report, /\([0-9]+\.[0-9]+\.[0-9]+\.[0-9]+\)$/)) {
                        current_ip = substr(report, RSTART + 1, RLENGTH - 2)
                        host = substr(report, 1, RSTART - 2)
                    } else if (report ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/) {
                        current_ip = report
                    }
                    if (current_ip != "") names[current_ip] = host
                    next
                }
                /^Host is up/ {
                    if (current_ip != "") active[current_ip] = 1
                    next
                }
                /^MAC Address:/ {
                    if (current_ip == "") next
                    mac = $0
                    sub(/^MAC Address: /, "", mac)
                    sub(/ .*/, "", mac)
                    if (mac != "") macs[current_ip] = mac
                    vendor = "unknown"
                    if (match($0, /\(.*\)$/)) vendor = substr($0, RSTART + 1, RLENGTH - 2)
                    vendors[current_ip] = vendor
                }
                END {
                    if (my_ip != "" && active[my_ip] && my_mac != "" && macs[my_ip] == "") {
                        macs[my_ip] = my_mac
                        vendors[my_ip] = "(This Computer)"
                    }
                    for (ip in active) {
                        disp_h = (names[ip] != "") ? names[ip] : "unknown"
                        mac = (macs[ip] != "") ? macs[ip] : "unknown"
                        vendor = (vendors[ip] != "") ? vendors[ip] : "unknown"
                        printf "NMAP\t%s\t%s\t%s\t%s\n", ip, disp_h, mac, vendor
                    }
                }
            '
            sleep "$nmap_delay"
        done
    ) > "$tmp_event_fifo" &
    nmap_pid=$!

    if command -v tshark >/dev/null 2>&1; then
        (
            sudo tshark -l -n -s 0 -i "$INTF" -f "$tshark_filter" -T fields -E separator=$'\t' -e eth.src -e ip.src -e eth.dst -e ip.dst 2>/dev/null | stdbuf -oL uniq | awk -F'\t' '
                function emit_pair(ip, mac) {
                    if (ip ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/ && mac != "") {
                        printf "TSHARK\t%s\tunknown\t%s\tunknown\n", ip, mac
                    }
                }
                NF >= 4 {
                    emit_pair($2, $1)
                    emit_pair($4, $3)
                }
            '
        ) > "$tmp_event_fifo" &
        tshark_pid=$!
    else
        echo "Warning: tshark stream disabled (missing tshark)."
    fi

    while [ "$scan_interrupted" -eq 0 ]; do
        nmap_alive=0
        tshark_alive=0
        consumer_alive=0

        if [ -n "$nmap_pid" ] && kill -0 "$nmap_pid" >/dev/null 2>&1; then
            nmap_alive=1
        fi
        if [ -n "$tshark_pid" ] && kill -0 "$tshark_pid" >/dev/null 2>&1; then
            tshark_alive=1
        fi
        if [ -n "$consumer_pid" ] && kill -0 "$consumer_pid" >/dev/null 2>&1; then
            consumer_alive=1
        fi

        if [ "$nmap_alive" -eq 0 ] && [ "$tshark_alive" -eq 0 ]; then
            break
        fi
        if [ "$consumer_alive" -eq 0 ]; then
            break
        fi
        sleep 0.2
    done

    cleanup_scan_stream
    trap - INT TERM
    rm -f "$tmp_event_fifo"

    if [ "$scan_interrupted" -eq 1 ]; then
        return 130
    fi

    if [ -n "$MY_IP" ] && [ -n "$MY_MAC" ]; then
        if ! awk -F'\t' -v ip="$MY_IP" '$1==ip {found=1} END {exit found ? 0 : 1}' "$tmp_rows"; then
            upsert_scan_row "$MY_IP" "unknown" "$MY_MAC" "(This Computer)" "n/a"
        fi
    fi

    if [ "$scan_ports" -eq 1 ]; then
        cut -f1 "$tmp_rows" | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' > "$tmp_ips"
        if [ -s "$tmp_ips" ]; then
            if cat "$tmp_ips" | sudo nmap -Pn --top-ports 200 -sS -n --min-parallelism 64 -iL - -oG - > "$tmp_ports_nmap" 2>/dev/null; then
                awk '
                    /^Host: / {
                        ip = $2
                        ports = ""
                        pos = index($0, "Ports: ")
                        if (pos > 0) {
                            p = substr($0, pos + 7)
                            sub(/[ \t]*Ignored State:.*/, "", p)
                            n = split(p, arr, ",")
                            for (i = 1; i <= n; i++) {
                                gsub(/^[ \t]+|[ \t]+$/, "", arr[i])
                                split(arr[i], f, "/")
                                if (f[1] ~ /^[0-9]+$/ && f[2] == "open" && f[3] != "") {
                                    entry = f[1] "/" f[3]
                                    ports = ports (ports == "" ? entry : ", " entry)
                                }
                            }
                        }
                        if (ip != "" && ports != "") {
                            print ip "\t" ports
                        }
                    }
                ' "$tmp_ports_nmap" | sort -u > "$tmp_ports_map"

                awk -F'\t' '
                    NR == FNR { p[$1] = $2; next }
                    {
                        if ($1 in p) {
                            $5 = p[$1]
                        } else {
                            $5 = "n/a"
                        }
                        print
                    }
                ' OFS='\t' "$tmp_ports_map" "$tmp_rows" > "$tmp_rows_ports"
                mv "$tmp_rows_ports" "$tmp_rows"
            else
                echo "Warning: port scan failed; Ports column will remain n/a."
            fi
        fi
    fi

    update_mac_ip_db_from_scan_rows "$tmp_rows"

    if [ "$resolve_hostnames" -eq 1 ]; then
        AVAHI_JOBS="${AVAHI_JOBS:-16}"
        tr '\n' '\0' < "$tmp_rows" | xargs -r -0 -n 1 -P "$AVAHI_JOBS" bash -c '
            line="$1"
            IFS=$'\''\t'\'' read -r ip disp_h mac vendor p_list <<< "$line"
            resolved_host=$(timeout 0.3s getent hosts "$ip" 2>/dev/null | awk '\''NR==1 {print $2}'\'')
            if [ -n "$resolved_host" ]; then
                disp_h="$resolved_host"
            fi
            printf "%s\t%s\t%s\t%s\t%s\n" "$ip" "$disp_h" "$mac" "$vendor" "$p_list"
        ' _ > "$tmp_resolved"
    else
        cp "$tmp_rows" "$tmp_resolved"
    fi

    echo ""
    echo "Final Scan Table:"
    echo "-----------------------------------------------------------------------------------------------------------------------------------"
    (
        printf "IP_Address\tHostname/Identity\tMAC_Address\tManufacturer\tPorts\n"
        sort -V "$tmp_resolved"
    ) | column -t -s $'\t'

    rm -f "$tmp_nmap" "$tmp_rows" "$tmp_resolved" "$tmp_ports_nmap" "$tmp_ports_map" "$tmp_rows_ports" "$tmp_ips" "$tmp_event_fifo"
    echo "-----------------------------------------------------------------------------------------------------------------------------------"
    echo ""

    if [ "$scan_interrupted" -eq 1 ]; then
        return 130
    fi
}

