bssid_scan() {
    local INTERFACE="${1:-wlp8s0}"
    local DURATION="${2:-12}"
    local end_ts
    local tmp_rows

    if ! [[ "$DURATION" =~ ^[0-9]+$ ]] || [ "$DURATION" -le 0 ]; then
        echo "Error: duration must be a positive integer (seconds)."
        echo "Usage: netmgr bssid-scan [interface] [seconds]"
        return 1
    fi

    if ! command -v nmcli >/dev/null 2>&1; then
        echo "Error: nmcli is required for bssid-scan."
        return 1
    fi

    if ! ip link show "$INTERFACE" >/dev/null 2>&1; then
        echo "Error: interface not found: $INTERFACE"
        return 1
    fi

    echo "Scanning BSSIDs in managed mode on ${INTERFACE} for ${DURATION}s..."
    tmp_rows=$(mktemp)
    end_ts=$((SECONDS + DURATION))

    while [ "$SECONDS" -lt "$end_ts" ]; do
        nmcli dev wifi rescan ifname "$INTERFACE" >/dev/null 2>&1 || true
        nmcli -e no -t -f BSSID,CHAN,FREQ,SIGNAL,SSID dev wifi list ifname "$INTERFACE" 2>/dev/null >> "$tmp_rows"
        sleep 2
    done

    awk -F: '
        function normalize_mac(m, a, i, out) {
            gsub(/-/, ":", m)
            m = tolower(m)
            n = split(m, a, ":")
            if (n != 6) return ""
            out = ""
            for (i = 1; i <= 6; i++) {
                if (a[i] !~ /^[0-9a-f]{1,2}$/) return ""
                if (length(a[i]) == 1) a[i] = "0" a[i]
                out = out ((i == 1) ? "" : ":") a[i]
            }
            return out
        }
        function band_for_freq(f, c) {
            if (f ~ /^[0-9]+$/) {
                if ((f + 0) >= 2400 && (f + 0) < 2500) return "2.4GHz"
                if ((f + 0) >= 4900 && (f + 0) < 5950) return "5GHz"
                if ((f + 0) >= 5950 && (f + 0) <= 7125) return "6GHz"
            }
            if (c ~ /^[0-9]+$/ && (c + 0) >= 1 && (c + 0) <= 14) return "2.4GHz"
            if (c ~ /^[0-9]+$/) return "5GHz"
            return "?"
        }
        {
            b = normalize_mac($1 ":" $2 ":" $3 ":" $4 ":" $5 ":" $6)
            if (b == "") next

            c = $7
            f = $8
            fnum = f
            gsub(/[^0-9]/, "", fnum)
            sig_raw = $9
            s = ""
            if (NF >= 10) {
                s = $10
                for (i = 11; i <= NF; i++) s = s ":" $i
            }
            if (s == "") s = "<hidden>"
            sig_ok = (sig_raw ~ /^[0-9]+$/)
            sig = sig_ok ? sig_raw + 0 : -1

            seen[b]++
            if (!(b in has_init)) {
                has_init[b] = 1
                ssid[b] = s
                chan[b] = (c == "" ? "?" : c)
                freq[b] = (fnum == "" ? "?" : fnum)
                has_sig[b] = sig_ok ? 1 : 0
                best_sig[b] = sig
            } else {
                if (ssid[b] == "<hidden>" && s != "<hidden>") ssid[b] = s
                if (chan[b] == "?" && c != "") chan[b] = c
                if ((freq[b] == "" || freq[b] == "?") && fnum != "") freq[b] = fnum
                if (sig_ok && (!has_sig[b] || sig > best_sig[b])) {
                    has_sig[b] = 1
                    best_sig[b] = sig
                }
            }
        }
        END {
            for (b in seen) {
                gsub(/ /, "_", ssid[b])
                sig_disp = has_sig[b] ? best_sig[b] : "N/A"
                band_disp = band_for_freq(freq[b], chan[b])
                freq_disp = (freq[b] == "" ? "?" : freq[b])
                printf "%s\t%s\t%s\t%s\t%s\t%s\t%d\n", toupper(b), ssid[b], chan[b], freq_disp, band_disp, sig_disp, seen[b]
            }
        }
    ' "$tmp_rows" | sort -V > "${tmp_rows}.out"

    echo "--------------------------------------------------------------------------------"
    (
        printf "BSSID\tSSID\tChannel\tFreq_MHz\tBand\tSignal_pct\tSeen\n"
        cat "${tmp_rows}.out"
    ) | column -t -s $'\t' | sed 's/_/ /g'
    echo "--------------------------------------------------------------------------------"
    echo ""

    if [ ! -s "${tmp_rows}.out" ]; then
        echo "No BSSIDs detected during ${DURATION}s managed scan."
    fi

    rm -f "$tmp_rows" "${tmp_rows}.out"
}

listen_subnet() {
    local INTERFACE="wlp8s0"
    local MODE="managed"
    local DEDUPE=0
    local BSSID=""
    local TARGET_CHAN=""
    local BAND=""
    local PHY_NUM=""
    local line
    local mac
    local vendor
    local vendor_disp
    local discovered_bssid
    local CAPTURE_IF=""
    local bssid_lc=""
    local bssid_channel=""
    local auto_channel=""
    local channel_hop_pid=""
    local phy_name=""
    local hop_channel
    local found_count=0
    local trunc_count=0
    local tmp_found
    local tmp_trunc
    local sniff_rc
    local key
    local prev_conn_uuid=""
    local reconnect_ok=0
    local device_state=""
    local frame_bssid=""
    local sa=""
    local ta=""
    local da=""
    local proto=""
    local packet_proto=""
    local sa_norm=""
    local ta_norm=""
    local da_norm=""
    local maybe_mac=""
    local ip_for_mac=""
    local bssid_key=""
    local ssid_value=""
    local display_bssid=""
    local display_ssid=""
    local display_chan=""
    local selected_ssid=""
    local decrypt_ssid=""
    local decrypt_psk=""
    local decrypt_uuid=""
    local conn_ssid=""
    local conn_psk=""
    local psk_field=""
    local monitor_cleanup_done=0
    local monitor_interrupted=0
    local dummy_uuid=""
    local dummy_name=""
    local found_stale=0
    local HOTSPOT_CONN_NAME="Netmgr_Awake"
    local HOTSPOT_PSK="hunter22"
    local hotspot_err=""
    local reconnect_conn=""
    local poll_i=0
    local -a PRIV_CMD
    local -a sniff_cmd
    local -a hop_channels
    local -a tshark_dec_opts
    declare -A seen_devices
    declare -A VENDOR_CACHE
    declare -A BSSID_TO_SSID
    declare -A BSSID_TO_CHAN

    while [ $# -gt 0 ]; do
        case "$1" in
            managed|monitor)
                MODE="$1"
                ;;
            --dedupe)
                DEDUPE=1
                ;;
            --bssid)
                shift
                if [ -z "${1:-}" ]; then
                    echo "Error: --bssid requires a value."
                    echo "Usage: netmgr listen [interface] [managed|monitor] [--channel <n>] [--bssid <mac>] [--dedupe]"
                    return 1
                fi
                BSSID="$1"
                ;;
            --channel)
                shift
                if [ -z "${1:-}" ]; then
                    echo "Error: --channel requires a value."
                    echo "Usage: netmgr listen [interface] [managed|monitor] [--channel <n>] [--bssid <mac>] [--dedupe]"
                    return 1
                fi
                TARGET_CHAN="$1"
                ;;
            *)
                if [[ "$1" =~ ^(en|eth|wl|v|do|lo)[0-9a-z]*$ ]]; then
                    INTERFACE="$1"
                elif [ "$MODE" = "monitor" ] && [[ "$1" =~ ^[0-9]+$ ]] && [ -z "$TARGET_CHAN" ]; then
                    TARGET_CHAN="$1"
                elif [ "$MODE" = "monitor" ] && [ -z "$BSSID" ]; then
                    BSSID="$1"
                fi
                ;;
        esac
        shift
    done

    if [ -n "$TARGET_CHAN" ] && ! [[ "$TARGET_CHAN" =~ ^[0-9]+$ ]]; then
        echo "Error: invalid channel value: $TARGET_CHAN"
        return 1
    fi

    if [ "$MODE" = "monitor" ] && [ -n "$BSSID" ]; then
        if [[ ! "$BSSID" =~ ^([[:xdigit:]]{2}:){5}[[:xdigit:]]{2}$ ]]; then
            echo "Error: Invalid BSSID format: $BSSID"
            echo "Usage: netmgr listen [interface] monitor [--channel <n>] [--bssid <mac>] [--dedupe]"
            return 1
        fi
        bssid_lc=$(echo "$BSSID" | tr '[:upper:]' '[:lower:]')
        BSSID=$(echo "$BSSID" | tr '[:lower:]' '[:upper:]')
        if [ -z "$TARGET_CHAN" ]; then
            nmcli dev wifi rescan ifname "$INTERFACE" >/dev/null 2>&1 || true
            bssid_channel=$(nmcli -e no -t -f BSSID,CHAN dev wifi list ifname "$INTERFACE" 2>/dev/null | awk -F: -v b="$BSSID" '
                {
                    mac = $1 ":" $2 ":" $3 ":" $4 ":" $5 ":" $6
                    chan = $NF
                    if (toupper(mac) == b && chan ~ /^[0-9]+$/) {
                        print chan
                        exit
                    }
                }
            ')
            if [ -n "$bssid_channel" ]; then
                TARGET_CHAN="$bssid_channel"
                echo "No --channel provided; defaulting to BSSID ${BSSID} channel ${TARGET_CHAN}."
            fi
        fi

        selected_ssid=$(nmcli -e no -t -f BSSID,SSID dev wifi list ifname "$INTERFACE" 2>/dev/null | awk -F: -v b="$BSSID" '
            {
                mac = toupper($1 ":" $2 ":" $3 ":" $4 ":" $5 ":" $6)
                if (mac != b) next
                ssid = $0
                sub(/^([^:]*:){6}/, "", ssid)
                print ssid
                exit
            }
        ')
    fi

    if [ "$MODE" = "monitor" ] && [ -z "$TARGET_CHAN" ] && [ -z "$BSSID" ]; then
        auto_channel=$(nmcli -e no -t -f IN-USE,CHAN dev wifi list ifname "$INTERFACE" 2>/dev/null | awk -F: '$1=="*" && $2 ~ /^[0-9]+$/ {print $2; exit}')
        if [ -n "$auto_channel" ]; then
            TARGET_CHAN="$auto_channel"
            echo "No --channel provided; defaulting to current Wi-Fi channel ${TARGET_CHAN}."
        fi
    fi

    if [ "$EUID" -eq 0 ]; then
        PRIV_CMD=()
    else
        if ! sudo -v; then
            echo "Error: sudo authentication failed."
            return 1
        fi
        PRIV_CMD=(sudo)
    fi

    if [ "$MODE" = "monitor" ] && [ -n "$BSSID" ] && [ -z "$TARGET_CHAN" ]; then
        bssid_channel=$("${PRIV_CMD[@]}" iw dev "$INTERFACE" scan ap-force 2>/dev/null | awk -v b="$bssid_lc" '
            BEGIN { in_bss = 0 }
            /^BSS / {
                mac = tolower($2)
                sub(/\(.*/, "", mac)
                in_bss = (mac == b)
                next
            }
            in_bss && /DS Parameter set: channel/ {
                print $NF
                exit
            }
            in_bss && /primary channel/ {
                print $NF
                exit
            }
        ')
        if [ -n "$bssid_channel" ] && [[ "$bssid_channel" =~ ^[0-9]+$ ]]; then
            TARGET_CHAN="$bssid_channel"
            echo "No --channel provided; defaulting to BSSID ${BSSID} channel ${TARGET_CHAN} (iw scan fallback)."
        fi
    fi

    if [ "$MODE" = "monitor" ]; then
        while IFS=$'\t' read -r bssid_key ssid_value display_chan; do
            [ -z "$bssid_key" ] && continue
            bssid_key=$(normalize_mac "$bssid_key")
            [ -z "$bssid_key" ] && continue
            BSSID_TO_SSID["$bssid_key"]="${ssid_value:-unknown}"
            if [[ "$display_chan" =~ ^[0-9]+$ ]]; then
                BSSID_TO_CHAN["$bssid_key"]="$display_chan"
            fi
        done < <(nmcli -e no -t -f BSSID,SSID,CHAN dev wifi list ifname "$INTERFACE" 2>/dev/null | awk -F: '
            {
                if ($1 ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/ && $2 ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/ && $3 ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/ &&
                    $4 ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/ && $5 ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/ && $6 ~ /^[0-9A-Fa-f][0-9A-Fa-f]$/) {
                    b = $1 ":" $2 ":" $3 ":" $4 ":" $5 ":" $6
                    ch = $NF
                    ssid = $0
                    sub(/^([^:]*:){6}/, "", ssid)
                    sub(/:[0-9]+$/, "", ssid)
                    printf "%s\t%s\t%s\n", b, ssid, ch
                }
            }
        ')
    fi

    if [ "$MODE" = "managed" ]; then
        if command -v tshark >/dev/null 2>&1; then
            if [ "$DEDUPE" -eq 1 ]; then
                log_ok "Listening on ${INTERFACE} in managed mode (all traffic, dedupe mode)..."
            else
                log_ok "Listening on ${INTERFACE} in managed mode (all traffic, full stack shown)..."
            fi
            log_ok "Using tshark decoder for detailed protocol stack."
            echo "--------------------------------------------------------------------------------"
            if [ "$DEDUPE" -eq 0 ]; then
                printf "Time       MAC_Address         IP_Address                               Vendor                         Protocol_Stack\n"
                echo "--------------------------------------------------------------------------------"
            fi

            sniff_cmd=("${PRIV_CMD[@]}" tshark -l -n -i "$INTERFACE" -T fields -E separator='|' -E occurrence=f -e eth.src -e ip.src -e ipv6.src -e frame.protocols -e tcp.srcport -e tcp.dstport -e udp.srcport -e udp.dstport -e eth.type -e _ws.col.Protocol)

            "${sniff_cmd[@]}" \
                2> >(while IFS= read -r tshark_msg; do
                    case "$tshark_msg" in
                        Capturing\ on\ *)
                            log_ok "$tshark_msg"
                            ;;
                        Running\ as\ user\ \"root\"*)
                            ;;
                        "")
                            ;;
                        *)
                            log_err "$tshark_msg"
                            ;;
                    esac
                done) | while IFS='|' read -r mac ip4 ip6 proto_chain tcp_s tcp_d udp_s udp_d eth_type app_proto; do
                mac=$(normalize_mac "$mac")
                if [ -z "$mac" ]; then
                    continue
                fi

                vendor=$(lookup_vendor "$mac")
                vendor_disp=$(printf "%.31s" "$vendor")
                ip_for_mac="$ip4"
                [ -z "$ip_for_mac" ] && ip_for_mac="$ip6"
                [ -z "$ip_for_mac" ] && ip_for_mac=$(lookup_ip_from_db "$mac")
                [ -z "$ip_for_mac" ] && ip_for_mac="n/a"
                packet_proto=$(format_protocol_stack "$proto_chain" "$tcp_s" "$tcp_d" "$udp_s" "$udp_d" "$eth_type" "$app_proto")
                if [[ "$INTERFACE" == wlp* ]]; then
                    packet_proto="${packet_proto//Ethernet/Synthetic Eth}"
                fi

                if [ "$DEDUPE" -eq 1 ]; then
                    if [[ -n "${seen_devices[$mac]}" ]]; then
                        continue
                    fi
                    seen_devices[$mac]=1
                    printf "[%s] NEW HOST DETECTED | MAC: %-17s | IP: %-15s | Vendor: %s\n" "$(date +%T)" "$mac" "$ip_for_mac" "$vendor_disp"
                    sleep 1
                else
                    printf "[%s] %-18s %-39s %-31s %s\n" "$(date +%T)" "$mac" "$ip_for_mac" "$vendor_disp" "$packet_proto"
                fi
            done
        else
            if [ "$DEDUPE" -eq 1 ]; then
                log_ok "Listening on ${INTERFACE} in managed mode (all traffic, dedupe mode)..."
            else
                log_ok "Listening on ${INTERFACE} in managed mode (all traffic, protocol shown)..."
            fi
            log_err "tshark is not installed; falling back to basic parser."
            echo "--------------------------------------------------------------------------------"
            if [ "$DEDUPE" -eq 0 ]; then
                printf "Time       MAC_Address         IP_Address                               Vendor                         Protocol_Stack\n"
                echo "--------------------------------------------------------------------------------"
            fi
            sniff_cmd=("${PRIV_CMD[@]}" tcpdump -l -i "$INTERFACE" -n -e)
            "${sniff_cmd[@]}" \
                2> >(while IFS= read -r tcpdump_msg; do
                    case "$tcpdump_msg" in
                        "tcpdump: verbose output suppressed, use -v[v]... for full protocol decode")
                            log_ok "tcpdump capture started (compact decode mode)."
                            ;;
                        listening\ on\ *)
                            log_ok "$tcpdump_msg"
                            ;;
                        "")
                            ;;
                        *)
                            log_err "$tcpdump_msg"
                            ;;
                    esac
                done) | while read -r line; do
                mac=$(echo "$line" | grep -oE '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' | head -n 1)
                mac=$(normalize_mac "$mac")
                [ -z "$mac" ] && continue

                vendor=$(lookup_vendor "$mac")
                vendor_disp=$(printf "%.31s" "$vendor")
                ip_for_mac=$(lookup_ip_from_db "$mac")
                [ -z "$ip_for_mac" ] && ip_for_mac="n/a"
                packet_proto="UNKNOWN"

                if [ "$DEDUPE" -eq 1 ]; then
                    if [[ -n "${seen_devices[$mac]}" ]]; then
                        continue
                    fi
                    seen_devices[$mac]=1
                    printf "[%s] NEW HOST DETECTED | MAC: %-17s | IP: %-15s | Vendor: %s\n" "$(date +%T)" "$mac" "$ip_for_mac" "$vendor_disp"
                    sleep 1
                else
                    printf "[%s] %-18s %-39s %-31s %s\n" "$(date +%T)" "$mac" "$ip_for_mac" "$vendor_disp" "$packet_proto"
                fi
            done
        fi
        sniff_rc=${PIPESTATUS[0]}
        if [ "$sniff_rc" -ne 0 ] && [ "$sniff_rc" -ne 130 ]; then
            log_err "Managed capture failed on interface ${INTERFACE}."
            return "$sniff_rc"
        fi
        return 0
    fi

    if [ "$MODE" != "monitor" ]; then
        echo "Error: Unknown listen mode: $MODE"
        echo "Usage: netmgr listen [interface] [managed|monitor] [--channel <n>] [--bssid <mac>] [--dedupe]"
        return 1
    fi

    monitor_cleanup() {
        if [ "$monitor_cleanup_done" -eq 1 ]; then
            return 0
        fi
        monitor_cleanup_done=1

        if [ -n "$channel_hop_pid" ]; then
            kill "$channel_hop_pid" >/dev/null 2>&1 || true
            wait "$channel_hop_pid" 2>/dev/null || true
        fi

        echo ""
        log_ok "Stopping monitor mode and restoring managed/connected state on ${INTERFACE}..."
        "${PRIV_CMD[@]}" iw dev mon0 del >/dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection down "$HOTSPOT_CONN_NAME" >/dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection down netmgr_dummy >/dev/null 2>&1 || true
        while IFS=: read -r dummy_uuid dummy_name; do
            [ -z "$dummy_uuid" ] && continue
            "${PRIV_CMD[@]}" nmcli connection delete uuid "$dummy_uuid" >/dev/null 2>&1 || true
        done < <(nmcli -t -f UUID,NAME connection show 2>/dev/null | awk -F: '$2=="netmgr_dummy" || $2=="Netmgr_Awake" {print $1 ":" $2}')
        "${PRIV_CMD[@]}" nmcli connection delete "$HOTSPOT_CONN_NAME" >/dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection delete netmgr_dummy >/dev/null 2>&1 || true
        "${PRIV_CMD[@]}" ip link set "$INTERFACE" up >/dev/null 2>&1 || true

        reconnect_ok=0
        if [ -n "$prev_conn_uuid" ]; then
            if "${PRIV_CMD[@]}" nmcli connection up uuid "$prev_conn_uuid" ifname "$INTERFACE" >/dev/null 2>&1; then
                reconnect_ok=1
            fi
        fi
        if [ "$reconnect_ok" -eq 0 ]; then
            if "${PRIV_CMD[@]}" nmcli device connect "$INTERFACE" >/dev/null 2>&1; then
                reconnect_ok=1
            fi
        fi
        if [ "$reconnect_ok" -eq 0 ]; then
            "${PRIV_CMD[@]}" systemctl restart NetworkManager >/dev/null 2>&1 || true
            sleep 1
            if [ -n "$prev_conn_uuid" ] && "${PRIV_CMD[@]}" nmcli connection up uuid "$prev_conn_uuid" ifname "$INTERFACE" >/dev/null 2>&1; then
                reconnect_ok=1
            elif "${PRIV_CMD[@]}" nmcli device connect "$INTERFACE" >/dev/null 2>&1; then
                reconnect_ok=1
            fi
        fi
        for poll_i in 1 2 3 4 5 6; do
            reconnect_conn=$(nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device status 2>/dev/null | awk -F: -v dev="$INTERFACE" '$1==dev && $2=="wifi" && $3=="connected" {print $4; exit}')
            if [ -n "$reconnect_conn" ]; then
                reconnect_ok=1
                break
            fi
            sleep 1
        done

        device_state=$(nmcli -t -f GENERAL.STATE device show "$INTERFACE" 2>/dev/null | awk -F: '/^GENERAL.STATE:/ {print $2; exit}')
        if [ "$reconnect_ok" -eq 1 ] && [ -n "$reconnect_conn" ]; then
            log_ok "Reconnected ${INTERFACE} to Wi-Fi successfully (${reconnect_conn})."
        elif [ "$reconnect_ok" -eq 1 ]; then
            log_ok "Reconnect command completed for ${INTERFACE} (state: ${device_state:-unknown})."
        else
            log_err "Failed to reconnect ${INTERFACE} automatically."
        fi
    }

    log_ok "Starting monitor mode on ${INTERFACE}..."
    prev_conn_uuid=$(nmcli -t -f UUID,DEVICE connection show --active 2>/dev/null | awk -F: -v dev="$INTERFACE" '$2==dev {print $1; exit}')
    if [ -n "$prev_conn_uuid" ]; then
        decrypt_ssid=$(nmcli -g 802-11-wireless.ssid connection show uuid "$prev_conn_uuid" 2>/dev/null | head -n 1)
        [ -z "$decrypt_ssid" ] && decrypt_ssid=$("${PRIV_CMD[@]}" nmcli -g 802-11-wireless.ssid connection show uuid "$prev_conn_uuid" 2>/dev/null | head -n 1)
        for psk_field in 802-11-wireless-security.psk wifi-sec.psk 802-11-wireless-security.sae-password wifi-sec.sae-password; do
            decrypt_psk=$(nmcli --show-secrets -g "$psk_field" connection show uuid "$prev_conn_uuid" 2>/dev/null | head -n 1)
            if [ -z "$decrypt_psk" ]; then
                decrypt_psk=$("${PRIV_CMD[@]}" nmcli --show-secrets -g "$psk_field" connection show uuid "$prev_conn_uuid" 2>/dev/null | head -n 1)
            fi
            [ -n "$decrypt_psk" ] && break
        done
    fi
    if [ -z "$decrypt_ssid" ] && [ -n "$selected_ssid" ]; then
        decrypt_ssid="$selected_ssid"
    fi
    if [ -z "$decrypt_psk" ] && [ -n "$decrypt_ssid" ]; then
        while read -r decrypt_uuid; do
            [ -z "$decrypt_uuid" ] && continue
            conn_ssid=$(nmcli -g 802-11-wireless.ssid connection show uuid "$decrypt_uuid" 2>/dev/null | head -n 1)
            [ -z "$conn_ssid" ] && conn_ssid=$("${PRIV_CMD[@]}" nmcli -g 802-11-wireless.ssid connection show uuid "$decrypt_uuid" 2>/dev/null | head -n 1)
            [ "$conn_ssid" != "$decrypt_ssid" ] && continue
            conn_psk=""
            for psk_field in 802-11-wireless-security.psk wifi-sec.psk 802-11-wireless-security.sae-password wifi-sec.sae-password; do
                conn_psk=$(nmcli --show-secrets -g "$psk_field" connection show uuid "$decrypt_uuid" 2>/dev/null | head -n 1)
                if [ -z "$conn_psk" ]; then
                    conn_psk=$("${PRIV_CMD[@]}" nmcli --show-secrets -g "$psk_field" connection show uuid "$decrypt_uuid" 2>/dev/null | head -n 1)
                fi
                [ -n "$conn_psk" ] && break
            done
            [ -z "$conn_psk" ] && continue
            decrypt_psk="$conn_psk"
            break
        done < <(nmcli -t -f UUID,TYPE connection show 2>/dev/null | awk -F: '$2=="802-11-wireless" {print $1}')
    fi
    tshark_dec_opts=()
    if [ -n "$decrypt_ssid" ] && [ -n "$decrypt_psk" ]; then
        tshark_dec_opts=(-o "wlan.enable_decryption:TRUE" -o "uat:80211_keys:\"wpa-pwd\",\"${decrypt_psk}:${decrypt_ssid}\"")
        log_ok "Using saved WPA key for SSID ${decrypt_ssid}; enabling higher-layer protocol decode."
    else
        log_err "No saved WPA key available for monitor decryption; protocol may remain 802.11."
    fi
    if [ "${NETMGR_AIRMON_KILL:-0}" = "1" ] && command -v airmon-ng >/dev/null 2>&1; then
        "${PRIV_CMD[@]}" airmon-ng check kill >/dev/null 2>&1 || true
    fi
    PHY_NUM=$("${PRIV_CMD[@]}" iw dev "$INTERFACE" info 2>/dev/null | awk '/wiphy/ {print "phy"$2; exit}')
    if [ -z "$PHY_NUM" ]; then
        echo "Error: could not determine phy for interface ${INTERFACE}."
        return 1
    fi

    log_ok "Preflight: ensuring stale monitor/hotspot resources do not exist..."
    found_stale=0
    if "${PRIV_CMD[@]}" iw dev | grep -qE '^[[:space:]]*Interface[[:space:]]+mon0$'; then
        found_stale=1
        log_ok "Preflight: deleting existing mon0."
        "${PRIV_CMD[@]}" ip link set mon0 down >/dev/null 2>&1 || true
        "${PRIV_CMD[@]}" iw dev mon0 del >/dev/null 2>&1 || true
    fi
    while IFS=: read -r dummy_uuid dummy_name; do
        [ -z "$dummy_uuid" ] && continue
        found_stale=1
        log_ok "Preflight: deleting existing hotspot profile ${dummy_name} (uuid: $dummy_uuid)."
        "${PRIV_CMD[@]}" nmcli connection down uuid "$dummy_uuid" >/dev/null 2>&1 || true
        "${PRIV_CMD[@]}" nmcli connection delete uuid "$dummy_uuid" >/dev/null 2>&1 || true
    done < <(nmcli -t -f UUID,NAME connection show 2>/dev/null | awk -F: '$2=="netmgr_dummy" || $2=="Netmgr_Awake" {print $1 ":" $2}')
    if [ "$found_stale" -eq 0 ]; then
        log_ok "Preflight: no stale mon0/Netmgr_Awake/netmgr_dummy resources found."
    fi

    log_ok "Creating monitor interface mon0 on ${PHY_NUM}..."
    if ! "${PRIV_CMD[@]}" iw phy "$PHY_NUM" interface add mon0 type monitor; then
        echo "Error: failed to create mon0 on ${PHY_NUM}."
        return 1
    fi
    if ! "${PRIV_CMD[@]}" ip link set mon0 up; then
        echo "Error: failed to set mon0 up."
        "${PRIV_CMD[@]}" iw dev mon0 del >/dev/null 2>&1 || true
        return 1
    fi
    if ! "${PRIV_CMD[@]}" iw dev | grep -qE '^[[:space:]]*Interface[[:space:]]+mon0$'; then
        echo "Error: mon0 interface was not created successfully."
        "${PRIV_CMD[@]}" iw dev mon0 del >/dev/null 2>&1 || true
        return 1
    fi
    "${PRIV_CMD[@]}" nmcli device disconnect "$INTERFACE" >/dev/null 2>&1 || true
    CAPTURE_IF="mon0"

    phy_name=$("${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" info 2>/dev/null | awk '/wiphy/ {print "phy"$2; exit}')
    if [ -n "$phy_name" ]; then
        mapfile -t hop_channels < <("${PRIV_CMD[@]}" iw phy "$phy_name" info 2>/dev/null | awk '
            /MHz \[/ && $0 !~ /disabled/ {
                if (match($0, /\[([0-9]+)\]/, m)) print m[1]
            }
        ' | sort -n -u)
    fi
    if [ "${#hop_channels[@]}" -eq 0 ]; then
        hop_channels=(1 6 11 36 40 44 48 149 153 157 161)
    fi

    if [ -n "$TARGET_CHAN" ]; then
        log_ok "Initializing MediaTek wakeup sequence on channel ${TARGET_CHAN}..."
        if [ "$TARGET_CHAN" -le 14 ]; then
            BAND="bg"
        else
            BAND="a"
        fi
        log_ok "Igniting dummy hotspot to wake up hardware..."
        hotspot_err=$("${PRIV_CMD[@]}" nmcli device wifi hotspot ifname "$INTERFACE" con-name "$HOTSPOT_CONN_NAME" ssid "Netmgr_Scan" password "$HOTSPOT_PSK" band "$BAND" channel "$TARGET_CHAN" 2>&1)
        if [ $? -ne 0 ]; then
            log_err "Failed to create dummy hotspot on ${INTERFACE} channel ${TARGET_CHAN}: ${hotspot_err}"
        fi
        "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set channel "$TARGET_CHAN" >/dev/null 2>&1 || true
        log_ok "Hardware awake and locked to channel ${TARGET_CHAN}."
    elif [ -n "$BSSID" ]; then
        log_err "Could not determine channel for BSSID ${BSSID}; using channel hopping."
    fi

    if [ -z "$TARGET_CHAN" ]; then
        log_err "No fixed channel resolved; using channel hopping on ${CAPTURE_IF}."
        (
            while true; do
                for hop_channel in "${hop_channels[@]}"; do
                    "${PRIV_CMD[@]}" iw dev "$CAPTURE_IF" set channel "$hop_channel" >/dev/null 2>&1 || true
                    sleep 0.35
                done
            done
        ) &
        channel_hop_pid=$!
    fi

    if [ -n "$BSSID" ]; then
        log_ok "Monitor mode active on ${INTERFACE}. Capture interface: ${CAPTURE_IF}. Filtering devices by BSSID ${BSSID}."
    else
        log_ok "Monitor mode active on ${INTERFACE}. Capture interface: ${CAPTURE_IF}. Showing devices from all BSSIDs."
    fi
    echo "--------------------------------------------------------------------------------"
    printf "Time       BSSID               SSID                 CH   MAC_Address         IP_Address      Vendor               Protocol\n"
    echo "--------------------------------------------------------------------------------"
    trap 'monitor_interrupted=1; monitor_cleanup' INT TERM

    tmp_found=$(mktemp)
    tmp_trunc=$(mktemp)
    sniff_cmd=("${PRIV_CMD[@]}" tshark -l -n -i "$CAPTURE_IF" "${tshark_dec_opts[@]}" -T fields -E separator=$'\t' -E occurrence=f -e wlan.bssid -e wlan.sa -e wlan.ta -e wlan.da -e _ws.col.Protocol)
    "${sniff_cmd[@]}" 2>/dev/null | while IFS=$'\t' read -r frame_bssid sa ta da proto; do
        frame_bssid=$(normalize_mac "$frame_bssid")
        sa_norm=$(normalize_mac "$sa")
        ta_norm=$(normalize_mac "$ta")
        da_norm=$(normalize_mac "$da")
        packet_proto="$proto"
        [ -z "$packet_proto" ] && packet_proto="802.11"

        discovered_bssid="$bssid_lc"
        if [ -z "$discovered_bssid" ]; then
            if [ -n "$frame_bssid" ]; then
                discovered_bssid="$frame_bssid"
            else
                discovered_bssid="unknown"
            fi
        fi
        if [ -n "$bssid_lc" ] && [ -n "$frame_bssid" ] && [ "$frame_bssid" != "$bssid_lc" ]; then
            continue
        fi

        for maybe_mac in "$sa_norm" "$ta_norm" "$da_norm"; do
            [ -z "$maybe_mac" ] && continue
            [ "$maybe_mac" = "ff:ff:ff:ff:ff:ff" ] && continue
            if [ -n "$bssid_lc" ] && [ "$maybe_mac" = "$bssid_lc" ]; then
                continue
            fi

            if [ "$DEDUPE" -eq 1 ]; then
                if [ -n "${seen_devices[$maybe_mac]}" ]; then
                    continue
                fi
                seen_devices[$maybe_mac]=1
            fi
            echo 1 >> "$tmp_found"

            vendor=$(lookup_vendor "$maybe_mac")
            vendor_disp=$(printf "%.31s" "$vendor")
            ip_for_mac=$(lookup_ip_from_db "$maybe_mac")
            [ -z "$ip_for_mac" ] && ip_for_mac="n/a"
            display_bssid="$discovered_bssid"
            [ "$display_bssid" = "unknown" ] || display_bssid=$(echo "$display_bssid" | tr '[:lower:]' '[:upper:]')
            display_ssid="${BSSID_TO_SSID[$discovered_bssid]:-}"
            if [ -z "$display_ssid" ] && [ -n "$selected_ssid" ] && [ "$discovered_bssid" = "$bssid_lc" ]; then
                display_ssid="$selected_ssid"
            fi
            [ -z "$display_ssid" ] && display_ssid="unknown"
            display_chan="${BSSID_TO_CHAN[$discovered_bssid]:-}"
            [ -z "$display_chan" ] && display_chan="${TARGET_CHAN:-hop}"

            if [ "$discovered_bssid" = "unknown" ]; then
                printf "[%s] %-19s %-20s %-4s %-18s %-15s %-31s %s\n" "$(date +%T)" "unknown" "$display_ssid" "$display_chan" "$maybe_mac" "$ip_for_mac" "$vendor_disp" "$packet_proto"
            else
                printf "[%s] %-19s %-20s %-4s %-18s %-15s %-31s %s\n" "$(date +%T)" "$display_bssid" "$display_ssid" "$display_chan" "$maybe_mac" "$ip_for_mac" "$vendor_disp" "$packet_proto"
            fi
        done
    done
    sniff_rc=${PIPESTATUS[0]}
    if [ -n "$channel_hop_pid" ]; then
        kill "$channel_hop_pid" >/dev/null 2>&1 || true
        wait "$channel_hop_pid" 2>/dev/null || true
        channel_hop_pid=""
    fi
    found_count=$(wc -l < "$tmp_found")
    trunc_count=$(wc -l < "$tmp_trunc")
    rm -f "$tmp_found" "$tmp_trunc"
    if [ "$found_count" -eq 0 ]; then
        if [ "$trunc_count" -gt 0 ]; then
            echo "No monitor devices parsed: tcpdump saw ${trunc_count} truncated radiotap frames ([|802.11_radio])."
            echo "Try a newer kernel/driver stack or use a USB adapter with stable monitor mode support."
        elif [ -n "$BSSID" ]; then
            echo "No monitor devices parsed for BSSID ${BSSID}. Try running without BSSID to verify packet decoding."
        else
            echo "No monitor devices parsed. If packets were captured, frame decode format may need tuning for this adapter."
        fi
    fi

    monitor_cleanup
    trap - INT TERM
    if [ "$monitor_interrupted" -eq 1 ] && [ "$sniff_rc" -eq 0 ]; then
        sniff_rc=130
    fi

    if [ "$sniff_rc" -ne 0 ] && [ "$sniff_rc" -ne 130 ]; then
        echo "Error: monitor capture failed on interface ${INTERFACE}."
        return "$sniff_rc"
    fi
}

fingerprint_host() {
    local target=""
    local fast_mode=0

    while [ $# -gt 0 ]; do
        case "$1" in
            --fast)
                fast_mode=1
                ;;
            *)
                if [ -z "$target" ]; then
                    target="$1"
                fi
                ;;
        esac
        shift
    done

    if [ -z "$target" ]; then
        echo "Error: fingerprint requires an IP target."
        echo "Usage: netmgr fingerprint <ip> [--fast]"
        return 1
    fi

    ensure_sudo_session || return 1

    if [ "$fast_mode" -eq 1 ]; then
        sudo nmap -A --top-ports 100 -T4 "$target"
    else
        sudo nmap -A -p- -T4 "$target"
    fi
}

get_hop_info() {
    local ip="$1"
    local loss_rate="$2"
    local avg_latency="$3"
    local best_latency="$4"
    local hop="$5"
    local suffix=""
    local netname=""
    local asn=""
    local location=""
    local asn_disp=""
    local ip_data=""
    local cymru_data=""
    local raw_range=""
    local city=""
    local country=""
    local postal=""
    local org=""
    
    if [[ $ip =~ ^192\.168\. ]] || [[ $ip =~ ^10\. ]] || [[ $ip =~ ^172\.(1[6-9]|2[0-9]|3[0-1])\. ]] || [[ $ip =~ ^fe80: ]] || [[ $ip =~ ^fd[0-9a-f]{2}: ]] || [[ $ip =~ ^fc[0-9a-f]{2}: ]]; then
        suffix=$(get_local_cidr "$ip")
        netname="Local_Network"
        asn="N/A"
        location="N/A"
    else
        ip_data=$(curl -s "https://ipinfo.io/$ip")
        cymru_data=$(whois -h whois.cymru.com " -v $ip" 2>/dev/null | tail -n 1)
        
        raw_range=$(echo "$cymru_data" | awk -F'|' '{print $3}' | xargs)
        if [[ "$ip" != *:* ]]; then
            suffix=$(range_to_suffix "$raw_range")
        fi
        
        city=$(echo "$ip_data" | jq -r '.city // empty' | tr ' ' '_')
        country=$(echo "$ip_data" | jq -r '.country // empty')
        postal=$(echo "$ip_data" | jq -r '.postal // empty')
        org=$(echo "$ip_data" | jq -r '.org // empty')
        
        asn=$(echo "$org" | grep -oP '^AS\d+' || echo "N/A")
        netname=$(echo "$org" | sed -E "s/^AS[0-9]+ //" | tr ' ' '_' || echo "unknown")
        
        location="${country:-??}"
        if [ -n "$city" ]; then location="$location_($city)"; fi
        if [ -n "$postal" ]; then location="$location_[$postal]"; fi
    fi

    if [ -z "$netname" ] || [[ "$netname" == "AS Name" ]]; then netname="unknown"; fi
    if [[ "$asn" == "AS" ]] || [[ "$asn" == "N/A" ]] || [ -z "$asn" ]; then asn_disp="N/A"; else asn_disp="$asn"; fi

    printf "%s %s %s %s %s %s %s %s\n" "$hop" "$ip$suffix" "$loss_rate" "$avg_latency" "$best_latency" "$netname" "$asn_disp" "$location"
}

run_traceroute() {
    local trace_intf=""
    local input_target="8.8.8.8"
    local target="$input_target"
    local resolved_target=""
    local trace_family="-4"
    local -a trace_tool_intf_args=()
    local -a ping_iface_args=()
    local hop=0
    local route_line=""
    local route_dev=""
    local route_via=""
    local route_src=""
    local ip_candidate=""
    local happy_ip=""
    local happy_scheme=""
    local happy_family=""
    local happy_reason=""
    local curl_out=""
    local v4_routable=""
    local v6_routable=""
    local v4_route_line=""
    local v6_route_line=""
    local v4_route_dev=""
    local v6_route_dev=""
    local diag_intf=""
    local diag_v4_addr=""
    local diag_v6_addr=""
    local diag_v4_default=""
    local diag_v6_default=""
    local route_hops_file="/tmp/route-hops.txt"
    local route_hops_raw=""
    local discovery_rounds="${NETMGR_TRACE_DISCOVERY_ROUNDS:-3}"
    local round=1
    local hop_ip=""
    local ping_out=""
    local hop_loss=""
    local hop_avg=""
    local hop_best=""
    local -a resolved_ips=()
    local -a resolved_v4=()
    local -a resolved_v6=()

    if [ $# -ge 1 ]; then
        if ip link show "$1" >/dev/null 2>&1; then
            trace_intf="$1"
            if [ $# -ge 2 ]; then
                input_target="$2"
            fi
        else
            input_target="$1"
        fi
    fi
    target="$input_target"
    if [[ ! "$input_target" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ && ! "$input_target" =~ : ]]; then
        mapfile -t resolved_ips < <(getent ahosts "$input_target" | awk '{print $1}' | awk '!seen[$0]++')
        if [ "${#resolved_ips[@]}" -eq 0 ]; then
            echo "Error: Could not resolve target hostname: $input_target"
            return 1
        fi

        for ip_candidate in "${resolved_ips[@]}"; do
            if [[ "$ip_candidate" == *:* ]]; then
                resolved_v6+=("$ip_candidate")
            else
                resolved_v4+=("$ip_candidate")
            fi
        done

        log_ok "Happy Eyeballs probe: curl --happy-eyeballs-timeout-ms 200 ${input_target}"
        if [ "${#resolved_v6[@]}" -gt 0 ]; then
            log_ok "AAAA candidates: ${resolved_v6[*]}"
        fi
        if [ "${#resolved_v4[@]}" -gt 0 ]; then
            log_ok "A candidates: ${resolved_v4[*]}"
        fi

        if command -v curl >/dev/null 2>&1; then
            for happy_scheme in https http; do
                curl_out=$(curl -sS -o /dev/null --connect-timeout 3 --max-time 6 --happy-eyeballs-timeout-ms 200 --write-out '%{remote_ip}' "${happy_scheme}://${input_target}" 2>/dev/null | tr -d '\r')
                if [[ "$curl_out" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ || "$curl_out" == *:* ]]; then
                    happy_ip="$curl_out"
                    break
                fi
            done
            if [ -n "$happy_ip" ]; then
                target="$happy_ip"
                resolved_target="$happy_ip"
                if [[ "$happy_ip" == *:* ]]; then
                    happy_family="IPv6"
                else
                    happy_family="IPv4"
                fi
                log_ok "Happy Eyeballs winner: ${happy_family} ${happy_ip} (${happy_scheme^^})"
            else
                log_err "Happy Eyeballs probe returned no winner; falling back to route-based selection."
            fi
        else
            log_err "curl not found; skipping Happy Eyeballs probe."
        fi

        for ip_candidate in "${resolved_v4[@]}"; do
            v4_route_line=$(ip -4 route get "$ip_candidate" 2>/dev/null | head -n 1)
            if [ -n "$v4_route_line" ]; then
                v4_routable="$ip_candidate"
                v4_route_dev=$(echo "$v4_route_line" | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
                break
            fi
        done
        for ip_candidate in "${resolved_v6[@]}"; do
            v6_route_line=$(ip -6 route get "$ip_candidate" 2>/dev/null | head -n 1)
            if [ -n "$v6_route_line" ]; then
                v6_routable="$ip_candidate"
                v6_route_dev=$(echo "$v6_route_line" | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
                break
            fi
        done
        diag_intf="$trace_intf"
        if [ -z "$diag_intf" ]; then
            if [[ "$happy_ip" == *:* ]] && [ -n "$v6_route_dev" ]; then
                diag_intf="$v6_route_dev"
            elif [[ "$happy_ip" != *:* ]] && [ -n "$v4_route_dev" ]; then
                diag_intf="$v4_route_dev"
            elif [ -n "$v4_route_dev" ]; then
                diag_intf="$v4_route_dev"
            elif [ -n "$v6_route_dev" ]; then
                diag_intf="$v6_route_dev"
            fi
        fi
        if [ -n "$diag_intf" ]; then
            diag_v4_addr=$(ip -4 addr show dev "$diag_intf" 2>/dev/null | awk '/inet / {print $2; exit}')
            diag_v6_addr=$(ip -6 addr show dev "$diag_intf" scope global 2>/dev/null | awk '/inet6 / {print $2; exit}')
            diag_v4_default=$(ip -4 route show default dev "$diag_intf" 2>/dev/null | head -n 1)
            diag_v6_default=$(ip -6 route show default dev "$diag_intf" 2>/dev/null | head -n 1)
        fi
        if [ -n "$happy_ip" ]; then
            if [[ "$happy_ip" == *:* ]] && [ -z "$v4_routable" ] && [ -n "$v6_routable" ]; then
                if [ -n "$diag_intf" ] && [ -z "$diag_v4_addr" ] && [ -z "$diag_v4_default" ]; then
                    happy_reason="IPv4 candidates were not routable on ${diag_intf}: no IPv4 address and no IPv4 default route. IPv6 route used ${v6_route_dev:-$diag_intf}."
                elif [ -n "$diag_intf" ] && [ -z "$diag_v4_default" ]; then
                    happy_reason="IPv4 candidates were not routable on ${diag_intf}: no IPv4 default route. IPv6 route used ${v6_route_dev:-$diag_intf}."
                else
                    happy_reason="IPv4 candidates were not routable; IPv6 was the only viable family (via ${v6_route_dev:-unknown})."
                fi
            elif [[ "$happy_ip" != *:* ]] && [ -z "$v6_routable" ] && [ -n "$v4_routable" ]; then
                if [ -n "$diag_intf" ] && [ -z "$diag_v6_addr" ] && [ -z "$diag_v6_default" ]; then
                    happy_reason="IPv6 candidates were not routable on ${diag_intf}: no global IPv6 address and no IPv6 default route. IPv4 route used ${v4_route_dev:-$diag_intf}."
                elif [ -n "$diag_intf" ] && [ -z "$diag_v6_default" ]; then
                    happy_reason="IPv6 candidates were not routable on ${diag_intf}: no IPv6 default route. IPv4 route used ${v4_route_dev:-$diag_intf}."
                elif [ -n "$diag_intf" ] && [ -z "$diag_v6_addr" ]; then
                    happy_reason="IPv6 candidates were not routable on ${diag_intf}: interface has no global IPv6 address. IPv4 route used ${v4_route_dev:-$diag_intf}."
                else
                    happy_reason="IPv6 candidates were not routable; IPv4 was the only viable family (via ${v4_route_dev:-unknown})."
                fi
            elif [[ "$happy_ip" == *:* ]] && [ -n "$v4_routable" ] && [ -n "$v6_routable" ]; then
                happy_reason="Both IPv4 and IPv6 were routable (IPv4 via ${v4_route_dev:-unknown}, IPv6 via ${v6_route_dev:-unknown}); IPv6 completed first in the Happy Eyeballs race."
            elif [[ "$happy_ip" != *:* ]] && [ -n "$v4_routable" ] && [ -n "$v6_routable" ]; then
                happy_reason="Both IPv4 and IPv6 were routable (IPv4 via ${v4_route_dev:-unknown}, IPv6 via ${v6_route_dev:-unknown}); IPv4 completed first in the Happy Eyeballs race."
            elif [[ "$happy_ip" == *:* ]]; then
                happy_reason="IPv6 endpoint was selected by Happy Eyeballs (via ${v6_route_dev:-unknown})."
            else
                happy_reason="IPv4 endpoint was selected by Happy Eyeballs (via ${v4_route_dev:-unknown})."
            fi
            log_ok "Winner reason: ${happy_reason}"
        fi

        if [ -z "$resolved_target" ]; then
            for ip_candidate in "${resolved_ips[@]}"; do
                if [[ "$ip_candidate" == *:* ]]; then
                    route_line=$(ip -6 route get "$ip_candidate" 2>/dev/null | head -n 1)
                else
                    route_line=$(ip -4 route get "$ip_candidate" 2>/dev/null | head -n 1)
                fi
                if [ -n "$route_line" ]; then
                    target="$ip_candidate"
                    resolved_target="$ip_candidate"
                    break
                fi
            done
        fi
        if [ -z "$resolved_target" ]; then
            target="${resolved_ips[0]}"
            resolved_target="$target"
        fi
    fi

    if [[ "$target" == *:* ]]; then
        trace_family="-6"
        route_line=$(ip -6 route get "$target" 2>/dev/null | head -n 1)
    else
        trace_family="-4"
        route_line=$(ip -4 route get "$target" 2>/dev/null | head -n 1)
    fi

    if [ -n "$route_line" ]; then
        route_dev=$(echo "$route_line" | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
        route_via=$(echo "$route_line" | awk '{for(i=1;i<=NF;i++) if($i=="via"){print $(i+1); exit}}')
        route_src=$(echo "$route_line" | awk '{for(i=1;i<=NF;i++) if($i=="src"){print $(i+1); exit}}')
    fi
    if [ -z "$trace_intf" ] && [ -n "$route_dev" ]; then
        trace_intf="$route_dev"
    fi
    if [ -n "$trace_intf" ]; then
        trace_tool_intf_args=(-i "$trace_intf")
        ping_iface_args=(-I "$trace_intf")
    fi

    echo ""
    if [ "$input_target" != "$target" ]; then
        if [ -n "$trace_intf" ]; then
            echo "Tracing path to $input_target ($target) via $trace_intf..."
        else
            echo "Tracing path to $input_target ($target)..."
        fi
    else
        if [ -n "$trace_intf" ]; then
            echo "Tracing path to $target via $trace_intf..."
        else
            echo "Tracing path to $target..."
        fi
    fi
    if [ -n "$route_line" ]; then
        log_ok "Route for ${target}: dev ${route_dev:-unknown} via ${route_via:-link} src ${route_src:-unknown}"
    else
        log_err "Could not determine route details for ${target}; using system defaults."
    fi
    if ! command -v traceroute >/dev/null 2>&1; then
        log_err "traceroute command not found."
        return 1
    fi
    echo "-------------------------------------------------------------------------------------------------------------------------------------------------------"
    route_hops_raw=$(mktemp)
    if ! [[ "$discovery_rounds" =~ ^[0-9]+$ ]] || [ "$discovery_rounds" -le 0 ]; then
        discovery_rounds=3
    fi

    if [ "$trace_family" = "-4" ]; then
        for ((round = 1; round <= discovery_rounds; round++)); do
            traceroute -4 -n "${trace_tool_intf_args[@]}" "$target" 2>/dev/null | awk -v s="udp-r${round}" '
                NR > 1 && $1 ~ /^[0-9]+$/ {
                    hop = $1 + 0
                    for (i = 2; i <= NF; i++) {
                        tok = $i
                        gsub(/[(),]/, "", tok)
                        if (tok ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) {
                            print s "\t" hop "\t" tok
                        }
                    }
                }
            ' >> "$route_hops_raw"
            traceroute -4 -n -I "${trace_tool_intf_args[@]}" "$target" 2>/dev/null | awk -v s="icmp-r${round}" '
                NR > 1 && $1 ~ /^[0-9]+$/ {
                    hop = $1 + 0
                    for (i = 2; i <= NF; i++) {
                        tok = $i
                        gsub(/[(),]/, "", tok)
                        if (tok ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) {
                            print s "\t" hop "\t" tok
                        }
                    }
                }
            ' >> "$route_hops_raw"
            traceroute -4 -n -T -p 443 "${trace_tool_intf_args[@]}" "$target" 2>/dev/null | awk -v s="tcp-r${round}" '
                NR > 1 && $1 ~ /^[0-9]+$/ {
                    hop = $1 + 0
                    for (i = 2; i <= NF; i++) {
                        tok = $i
                        gsub(/[(),]/, "", tok)
                        if (tok ~ /^([0-9]{1,3}\.){3}[0-9]{1,3}$/) {
                            print s "\t" hop "\t" tok
                        }
                    }
                }
            ' >> "$route_hops_raw"
        done
    else
        for ((round = 1; round <= discovery_rounds; round++)); do
            traceroute -6 -n "${trace_tool_intf_args[@]}" "$target" 2>/dev/null | awk -v s="udp-r${round}" '
                NR > 1 && $1 ~ /^[0-9]+$/ {
                    hop = $1 + 0
                    for (i = 2; i <= NF; i++) {
                        tok = $i
                        sub(/%.*/, "", tok)
                        gsub(/[(),]/, "", tok)
                        if (tok ~ /:/ && tok ~ /^[0-9A-Fa-f:]+$/) {
                            print s "\t" hop "\t" tok
                        }
                    }
                }
            ' >> "$route_hops_raw"
            traceroute -6 -n -I "${trace_tool_intf_args[@]}" "$target" 2>/dev/null | awk -v s="icmp-r${round}" '
                NR > 1 && $1 ~ /^[0-9]+$/ {
                    hop = $1 + 0
                    for (i = 2; i <= NF; i++) {
                        tok = $i
                        sub(/%.*/, "", tok)
                        gsub(/[(),]/, "", tok)
                        if (tok ~ /:/ && tok ~ /^[0-9A-Fa-f:]+$/) {
                            print s "\t" hop "\t" tok
                        }
                    }
                }
            ' >> "$route_hops_raw"
            traceroute -6 -n -T -p 443 "${trace_tool_intf_args[@]}" "$target" 2>/dev/null | awk -v s="tcp-r${round}" '
                NR > 1 && $1 ~ /^[0-9]+$/ {
                    hop = $1 + 0
                    for (i = 2; i <= NF; i++) {
                        tok = $i
                        sub(/%.*/, "", tok)
                        gsub(/[(),]/, "", tok)
                        if (tok ~ /:/ && tok ~ /^[0-9A-Fa-f:]+$/) {
                            print s "\t" hop "\t" tok
                        }
                    }
                }
            ' >> "$route_hops_raw"
        done
    fi

    awk -F'\t' '
        function list_has(list, item, arr, n, i) {
            n = split(list, arr, " ")
            for (i = 1; i <= n; i++) {
                if (arr[i] == item) return 1
            }
            return 0
        }
        {
            scan = $1
            hop = $2 + 0
            ip = $3
            if (scan == "" || hop <= 0 || ip == "") next

            ips[ip] = 1
            scans[scan] = 1
            if (!(ip in minhop) || hop < minhop[ip]) minhop[ip] = hop
            sumhop[ip] += hop
            cnt[ip]++

            key = scan SUBSEP hop
            if (!(key in hop_ips)) {
                hop_ips[key] = ip
            } else if (!list_has(hop_ips[key], ip)) {
                hop_ips[key] = hop_ips[key] " " ip
            }
            if (!(scan in maxhop) || hop > maxhop[scan]) maxhop[scan] = hop
        }
        END {
            for (s in scans) {
                prev = ""
                for (h = 1; h <= maxhop[s]; h++) {
                    key = s SUBSEP h
                    if (!(key in hop_ips)) continue
                    curr = hop_ips[key]
                    if (prev != "") {
                        nprev = split(prev, p, " ")
                        ncurr = split(curr, c, " ")
                        for (i = 1; i <= nprev; i++) {
                            for (j = 1; j <= ncurr; j++) {
                                if (p[i] != c[j]) {
                                    edge[p[i] SUBSEP c[j]] = 1
                                }
                            }
                        }
                    }
                    prev = curr
                }
            }

            nips = 0
            for (ip in ips) {
                score[ip] = sumhop[ip] / cnt[ip]
                nips++
            }

            for (iter = 1; iter <= nips * 4; iter++) {
                changed = 0
                for (e in edge) {
                    split(e, uv, SUBSEP)
                    u = uv[1]
                    v = uv[2]
                    if (score[u] >= score[v]) {
                        score[v] = score[u] + 0.01
                        changed = 1
                    }
                }
                if (!changed) break
            }

            for (ip in ips) {
                printf "%.6f\t%d\t%s\n", score[ip], minhop[ip], ip
            }
        }
    ' "$route_hops_raw" | sort -n -k1,1 -k2,2n -k3,3 | awk -F'\t' '{print $3}' > "$route_hops_file"

    if ! grep -Fxq "$target" "$route_hops_file" 2>/dev/null; then
        echo "$target" >> "$route_hops_file"
    fi

    if [ ! -s "$route_hops_file" ]; then
        log_err "No hops discovered."
        return 1
    fi

    log_ok "Discovered hop list written to ${route_hops_file}"

    (
        printf "Hop IP_Address Loss Avg Lowest Netname ASN Location\n"
        while IFS= read -r hop_ip; do
            [ -z "$hop_ip" ] && continue
            ((hop++))
            if [ "$trace_family" = "-4" ]; then
                ping_out=$(ping -4 -n -q -c 20 -i 0.2 -W 1 "${ping_iface_args[@]}" "$hop_ip" 2>/dev/null)
            else
                ping_out=$(ping -6 -n -q -c 20 -i 0.2 -W 1 "${ping_iface_args[@]}" "$hop_ip" 2>/dev/null)
            fi
            hop_loss=$(echo "$ping_out" | awk -F', ' '/packets transmitted/ {for (i=1; i<=NF; i++) if ($i ~ /% packet loss/) {gsub(/% packet loss/, "", $i); print $i "%"; exit}}')
            hop_avg=$(echo "$ping_out" | awk -F'=' '/^rtt |^round-trip/ {split($2, a, "/"); gsub(/[[:space:]]/, "", a[2]); print a[2] "ms"; exit}')
            hop_best=$(echo "$ping_out" | awk -F'=' '/^rtt |^round-trip/ {split($2, a, "/"); gsub(/[[:space:]]/, "", a[1]); print a[1] "ms"; exit}')
            [ -z "$hop_loss" ] && hop_loss="100%"
            [ -z "$hop_avg" ] && hop_avg="N/A"
            [ -z "$hop_best" ] && hop_best="N/A"
            get_hop_info "$hop_ip" "$hop_loss" "$hop_avg" "$hop_best" "$hop"
        done < "$route_hops_file"
    ) | column -t | sed 's/_/ /g'
    echo "-------------------------------------------------------------------------------------------------------------------------------------------------------"
    echo ""
    rm -f "$route_hops_raw"
}

show_help() {
    echo "NETMGR Commands:"
    echo "  interfaces          - List all local network interfaces and their details."
    echo "  scan [intf] [target] [--ports] [--resolve-hostnames] - Host discovery scan; optional port scan and getent hostname resolution."
    echo "  ports               - Show active listening ports (TCP/UDP)."
    echo "  listen [intf] [managed|monitor] [--channel n] [--bssid mac] [--dedupe] - Listener; managed default, monitor optional."
    echo "  bssid-scan [intf] [seconds] - Discover BSSID, SSID, channel, and signal in managed mode."
    echo "  fingerprint <ip> [--fast] - Run aggressive fingerprint scan; --fast scans top 100 ports."
    echo "  traceroute [intf] [target] - Deep traceroute with Edge Node identification."
    echo "  exit                - Exit the netmgr tool."
    echo "  help                - Show this help message."
}

run_command() {
    case "$1" in
        interfaces) show_interfaces; ;;
        scan) shift; scan_subnet "$@"; ;;
        ports) show_ports; ;;
        listen) shift; listen_subnet "$@"; ;;
        bssid-scan) shift; bssid_scan "$@"; ;;
        fingerprint) shift; fingerprint_host "$@"; ;;
        traceroute) shift; run_traceroute "$@"; ;;
        help|-h|--help) show_help; ;;
        exit|quit) exit 0; ;;
        "") ;;
        *) echo "Unknown command: $1"; ;;
    esac
}

if [ $# -gt 0 ]; then
    run_command "$@"
else
    while true; do
        read -p "NETMGR> " cmd args
        run_command "$cmd" $args
    done
fi
